+        std::vector<std::unique_ptr<Object>> PreloadObjects(const ObjectList& objectList) override
+        {
+            std::vector<const ObjectRepositoryItem*> objectsToLoad;
+            for (auto objectType : getAllObjectTypes())
+            {
+                auto& descriptors = objectList.GetList(objectType);
+                auto maxSize = static_cast<size_t>(getObjectEntryGroupCount(objectType));
+                auto listSize = std::min(descriptors.size(), maxSize);
+                for (size_t i = 0; i < listSize; i++)
+                {
+                    const auto& entry = descriptors[i];
+                    if (!entry.HasValue())
+                        continue;
+                    const auto* ori = _objectRepository.FindObject(entry);
+                    if (ori != nullptr && ori->LoadedObject == nullptr)
+                        objectsToLoad.push_back(ori);
+                }
+            }
+            std::sort(objectsToLoad.begin(), objectsToLoad.end());
+            objectsToLoad.erase(std::unique(objectsToLoad.begin(), objectsToLoad.end()), objectsToLoad.end());
+
+            std::vector<std::unique_ptr<Object>> result;
+            std::mutex resultMutex;
+            JobPool jobs{};
+            for (const auto* ori : objectsToLoad)
+            {
+                jobs.AddTask([ori, &result, &resultMutex, this]() {
+                    auto object = _objectRepository.LoadObject(ori);
+                    if (object != nullptr)
+                    {
+                        std::lock_guard<std::mutex> guard(resultMutex);
+                        result.push_back(std::move(object));
+                    }
+                });
+            }
+            jobs.Join();
+            return result;
+        }
+
+        void LoadObjects(
+            const ObjectList& objectList, std::vector<std::unique_ptr<Object>>&& preloaded, bool reportProgress) override
+        {
+            // Register and load the objects read earlier, as LoadObjects does for the ones it reads itself.
+            std::vector<Object*> registered;
+            for (auto& object : preloaded)
+            {
+                const auto* ori = _objectRepository.FindObject(object->GetDescriptor());
+                if (ori == nullptr || ori->LoadedObject != nullptr)
+                    continue;
+                auto* loadedObject = object.get();
+                _objectRepository.RegisterLoadedObject(ori, std::move(object));
+                loadedObject->Load();
+                registered.push_back(loadedObject);
+            }
+            preloaded.clear();
+
+            try
+            {
+                LoadObjects(objectList, reportProgress);
+            }
+            catch (...)
+            {
+                for (auto* object : registered)
+                {
+                    if (GetLoadedObjectEntryIndex(object) == kObjectEntryIndexNull)
+                        UnloadObject(object);
+                }
+                throw;
+            }
+        }
+
         void UnloadObjects(const std::vector<ObjectEntryDescriptor>& entries) override
         {
             // TODO there are two performance issues here:
