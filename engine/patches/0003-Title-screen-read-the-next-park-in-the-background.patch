+        bool CanLoadInBackground(size_t saveIndex) const
+        {
+            if (_initialLoadCommand || _synchronous || gPreviewingTitleSequenceInGame || gOpenRCT2Headless)
+                return false;
+            if (saveIndex >= _sequence->Saves.size())
+                return false;
+            return ParkImporter::ExtensionIsOpenRCT2ParkFile(Path::GetExtension(_sequence->Saves[saveIndex]));
+        }
+
+        void StartBackgroundLoad(size_t saveIndex)
+        {
+            auto load = std::make_unique<BackgroundLoad>();
+            load->saveIndex = saveIndex;
+            load->hintPath = _sequence->Saves[saveIndex];
+            LOG_VERBOSE("TitleSequencePlayer: reading %s in the background", load->hintPath.c_str());
+            const TitleSequence* sequence = _sequence.get(); // outlives the thread: Eject() joins first
+            load->thread = std::thread([sequence, l = load.get()]() { RunBackgroundLoad(*sequence, *l); });
+            _background = std::move(load);
+        }
+
+        static void RunBackgroundLoad(const TitleSequence& sequence, BackgroundLoad& load)
+        {
+            try
+            {
+                auto parkHandle = TitleSequenceGetParkHandle(sequence, load.saveIndex);
+                if (parkHandle == nullptr)
+                {
+                    throw std::runtime_error("park not found in the sequence");
+                }
+                load.importer = ParkImporter::Create(parkHandle->HintPath);
+                load.result.emplace(load.importer->LoadFromStream(parkHandle->Stream.get(), false));
+
+                load.objects = GetContext()->GetObjectManager().PreloadObjects(load.result->RequiredObjects);
+                load.ok = true;
+            }
+            catch (const std::exception& e)
+            {
+                load.error = e.what();
+            }
+            catch (...)
+            {
+                load.error = "unknown error";
+            }
+            load.done = true;
+        }
+
+        /** Main-thread half of a background load: objects, import and playback setup. */
+        bool FinishBackgroundLoad(BackgroundLoad& load)
+        {
+            LOG_VERBOSE("TitleSequencePlayer::FinishBackgroundLoad(%s)", load.hintPath.c_str());
+            bool success = false;
+            try
+            {
+                WindowSetFlagForAllViewports(ViewportFlag::renderingInhibited, true);
+
+                auto& objectManager = GetContext()->GetObjectManager();
+                objectManager.LoadObjects(load.result->RequiredObjects, std::move(load.objects), false);
+
+                auto& gameState = getGameState();
+                load.importer->Import(gameState);
+
+                MapAnimations::MarkAllTiles();
+                PrepareParkForPlayback();
+                success = true;
+            }
+            catch (const std::exception& e)
+            {
+                Console::Error::WriteLine("Unable to load park: %s (%s)", load.hintPath.c_str(), e.what());
+            }
+            WindowSetFlagForAllViewports(ViewportFlag::renderingInhibited, false);
+            return success;
+        }
+
+        void DiscardBackgroundLoad()
+        {
+            if (_background != nullptr)
+            {
+                _stale.push_back(std::move(_background));
+            }
+        }
+
+        void ReapStaleLoads()
+        {
+            for (auto it = _stale.begin(); it != _stale.end();)
+            {
+                if ((*it)->done)
+                {
+                    (*it)->thread.join();
+                    it = _stale.erase(it);
+                }
+                else
+                {
+                    ++it;
+                }
+            }
+        }
+
