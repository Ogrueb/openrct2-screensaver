     static std::vector<ViewportRideMusicInstance> _musicInstances;
     static std::vector<RideMusicChannel> _musicChannels;
 
+    // Title screen park switches cross-fade: the previous park's channels fade out while the new
+    // park's fade in, over kTitleFadeTime of real time.
+    using FadeClock = std::chrono::steady_clock;
+    constexpr auto kTitleFadeTime = std::chrono::milliseconds(1500);
+    static std::vector<RideMusicChannel> _fadingChannels;
+    static FadeClock::time_point _titleFadeStart{};
+
+    // Title screen with park music: a park whose rides play exactly one custom (non-stock) music
+    // object treats it as the park's soundtrack, played from one ride at an even volume, centered.
+    constexpr int16_t kSoundtrackVolume = -700; // The loudest a ride gets in a viewport
+    struct TitleSoundtrack
+    {
+        ObjectEntryIndex Music = kObjectEntryIndexNull;
+        ::RideId Ride = ::RideId::GetNull();
+    };
+    static TitleSoundtrack _parkSoundtrack;   // Chosen when the park appears
+    static TitleSoundtrack _soundtrack;       // Playing this tick
+    static uint32_t _soundtrackTick = UINT32_MAX;
+    static bool _soundtrackActive = false;
+
+    static void ForgetTitleSoundtrack()
+    {
+        _parkSoundtrack = {};
+        _soundtrack = {};
+        _soundtrackTick = UINT32_MAX;
+        _soundtrackActive = false;
+    }
+
+    static float TitleFadeProgress()
+    {
+        auto elapsed = FadeClock::now() - _titleFadeStart;
+        if (elapsed >= kTitleFadeTime)
+            return 1.0f;
+        return std::chrono::duration<float>(elapsed) / std::chrono::duration<float>(kTitleFadeTime);
+    }
+
+    static float ChannelStartGain()
+    {
+        return gLegacyScene == LegacyScene::titleSequence ? TitleFadeProgress() : 1.0f;
+    }
+
     void StopAllChannels()
     {
         _musicChannels.clear();
+        _fadingChannels.clear();
+        ForgetTitleSoundtrack();
+    }
+
+    static void ChooseTitleSoundtrack();
+
+    void FadeOutAllChannels()
+    {
+        for (auto& channel : _musicChannels)
+        {
+            // Circus music plays an audio object's shared sample, which the park switch unloads
+            if (channel.Source != nullptr)
+            {
+                _fadingChannels.push_back(std::move(channel));
+            }
+        }
+        _musicChannels.clear();
+        ChooseTitleSoundtrack();
+        _titleFadeStart = FadeClock::now();
+    }
+
+    static bool IsStockMusic(const MusicObject& musicObject)
+    {
+        auto id = musicObject.GetIdentifier();
+        for (std::string_view prefix : { "rct1.", "rct2.", "rct2tt.", "rct2ww.", "openrct2." })
+        {
+            if (id.starts_with(prefix))
+                return true;
+        }
+        return false;
+    }
+
+    static bool PlaysMusic(const Ride& ride, ObjectEntryIndex music)
+    {
+        return ride.status == RideStatus::open && ride.flags.has(RideFlag::music) && ride.music == music;
+    }
+
+    // The single custom music object the open rides play, and the first ride playing it; none when
+    // there are none or several
+    static TitleSoundtrack FindTitleSoundtrack()
+    {
+        TitleSoundtrack found;
+        auto& objManager = GetContext()->GetObjectManager();
+        for (auto& ride : RideManager(getGameState()))
+        {
+            if (ride.status != RideStatus::open || !ride.flags.has(RideFlag::music))
+                continue;
+            auto* musicObject = objManager.GetLoadedObject<MusicObject>(ride.music);
+            if (musicObject == nullptr || IsStockMusic(*musicObject))
+                continue;
+            if (found.Music == kObjectEntryIndexNull)
+                found = { ride.music, ride.id };
+            else if (found.Music != ride.music)
+                return {};
+        }
+        return found;
+    }
+
+    // Chosen when a title park is put on screen, from the rides as saved: companions open hidden
+    // rides with their own custom music for sound effects later, which must not count
+    static void ChooseTitleSoundtrack()
+    {
+        ForgetTitleSoundtrack();
+        _parkSoundtrack = FindTitleSoundtrack();
+    }
+
+    // Which soundtrack plays this tick, on the title screen with Ride music chosen: the park's own
+    // while its ride is open and plays it; otherwise (a companion swapped the music rides, as
+    // Constellations' eclipse does) the single custom music the open rides play, if there is one
+    static void UpdateTitleSoundtrack()
+    {
+        auto tick = getGameState().currentTicks;
+        if (tick == _soundtrackTick)
+            return;
+        _soundtrackTick = tick;
+
+        _soundtrackActive = false;
+        if (gLegacyScene != LegacyScene::titleSequence || Config::Get().sound.titleMusic != TitleMusicKind::parkMusic
+            || _parkSoundtrack.Music == kObjectEntryIndexNull)
+            return;
+        const auto* ride = GetRide(_parkSoundtrack.Ride);
+        if (ride != nullptr && PlaysMusic(*ride, _parkSoundtrack.Music))
+        {
+            _soundtrack = _parkSoundtrack;
+        }
+        else
+        {
+            ride = GetRide(_soundtrack.Ride);
+            if (ride == nullptr || !PlaysMusic(*ride, _soundtrack.Music))
+                _soundtrack = FindTitleSoundtrack();
+        }
+        _soundtrackActive = _soundtrack.Music != kObjectEntryIndexNull;
     }
 
     void ClearAllViewportInstances()
