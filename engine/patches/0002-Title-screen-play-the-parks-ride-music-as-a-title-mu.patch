@@ -253,11 +410,36 @@ namespace OpenRCT2::RideAudio
      */
     void UpdateMusicChannels()
     {
-        if (gLegacyScene == LegacyScene::scenarioEditor || gLegacyScene == LegacyScene::titleSequence)
+        if (gLegacyScene == LegacyScene::scenarioEditor)
             return;
 
+        if (gLegacyScene == LegacyScene::titleSequence)
+        {
+            // The title screen plays ride music only when it is the chosen title music; the choice
+            // stands in for the in-game "Ride music" checkbox there.
+            if (gGameSoundsOff || Config::Get().sound.titleMusic != TitleMusicKind::parkMusic)
+            {
+                StopAllChannels();
+                return;
+            }
+
+            UpdateTitleSoundtrack();
+            const auto progress = TitleFadeProgress();
+            if (progress >= 1.0f)
+            {
+                _fadingChannels.clear();
+            }
+            for (auto& channel : _fadingChannels)
+            {
+                channel.SetGain(1.0f - progress);
+            }
+            for (auto& channel : _musicChannels)
+            {
+                channel.SetGain(progress);
+            }
+        }
         // TODO Allow circus music (CSS24) to play if ride music is disabled (that should be sound)
-        if (gGameSoundsOff || !Config::Get().sound.rideMusicEnabled)
+        else if (gGameSoundsOff || !Config::Get().sound.rideMusicEnabled)
             return;
 
         StopInactiveRideMusicChannels();
@@ -380,6 +562,16 @@ namespace OpenRCT2::RideAudio
      */
     void UpdateMusicInstance(Ride& ride, const CoordsXYZ& rideCoords, uint16_t sampleRate)
     {
+        UpdateTitleSoundtrack();
+        if (_soundtrackActive && ride.music == _soundtrack.Music)
+        {
+            if (ride.id == _soundtrack.Ride && !gGameSoundsOff && gMusicTrackingViewport != nullptr)
+                RideUpdateMusicPosition(ride, kSoundtrackVolume, 0, sampleRate);
+            else
+                RideUpdateMusicPosition(ride);
+            return;
+        }
+
         if (gLegacyScene != LegacyScene::scenarioEditor && !gGameSoundsOff && gMusicTrackingViewport != nullptr)
         {
             auto rotatedCoords = Translate3DTo2DWithZ(GetCurrentRotation(), rideCoords);
