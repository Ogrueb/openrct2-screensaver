+
+// Image list use for the perf log (fragmentation over many park switches).
+OpenRCT2::PerfLog::ImageListStats OpenRCT2::PerfLog::GetImageListStats()
+{
+    ImageListStats stats;
+    stats.used = _allocatedImageCount;
+    if (!_initialised)
+    {
+        stats.freeRuns = 1;
+        stats.largestFreeRun = kMaxImages;
+        return stats;
+    }
+    for (const auto& list : _freeLists)
+    {
+        stats.freeRuns++;
+        stats.largestFreeRun = std::max(stats.largestFreeRun, list.Count);
+    }
+    return stats;
+}
