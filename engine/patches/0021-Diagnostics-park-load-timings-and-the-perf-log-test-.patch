+namespace OpenRCT2::Title
+{
+    // Times each stage of a title-screen park load and appends the result to
+    // <user dir>/rct-screensaver-engine.log, so the breakdown can be read without a console.
+    class LoadTimer
+    {
+        using clock = std::chrono::steady_clock;
+        std::string _park;
+        clock::time_point _start = clock::now();
+        clock::time_point _last = _start;
+        std::string _line;
+
+    public:
+        explicit LoadTimer(std::string park)
+            : _park(std::move(park))
+        {
+        }
+
+        void Stage(const char* name)
+        {
+            auto now = clock::now();
+            auto ms = std::chrono::duration_cast<std::chrono::microseconds>(now - _last).count() / 1000.0;
+            _last = now;
+            Stage(name, ms);
+        }
+
+        /** A part of the previous stage, shown in brackets. */
+        void Detail(const char* name, double ms)
+        {
+            char buf[96];
+            snprintf(buf, sizeof(buf), " [%s=%.1fms]", name, ms);
+            _line += buf;
+        }
+
+        /** A count belonging to the previous stage, shown in brackets. */
+        void Count(const char* name, size_t n)
+        {
+            char buf[96];
+            snprintf(buf, sizeof(buf), " [%s=%zu]", name, n);
+            _line += buf;
+        }
+
+        /** A stage that was timed elsewhere (for example on another thread). */
+        void Stage(const char* name, double ms)
+        {
+            char buf[96];
+            snprintf(buf, sizeof(buf), " %s=%.1fms", name, ms);
+            _line += buf;
+        }
+
+        ~LoadTimer()
+        {
+            auto total = std::chrono::duration_cast<std::chrono::microseconds>(clock::now() - _start).count() / 1000.0;
+            char buf[64];
+            snprintf(buf, sizeof(buf), " total=%.1fms", total);
+            _line += buf;
+            try
+            {
+                auto& env = GetContext()->GetPlatformEnvironment();
+                auto path = Path::Combine(env.GetDirectoryPath(DirBase::user), u8"rct-screensaver-engine.log");
+                std::ofstream out(path, std::ios::app);
+                out << "load " << _park << _line << "\n";
+                PerfLog::Event("load", _park + _line);
+            }
+            catch (...)
+            {
+            }
+            Console::WriteLine("[rct-screensaver] load %s%s", _park.c_str(), _line.c_str());
+        }
+    };
+} // namespace OpenRCT2::Title
