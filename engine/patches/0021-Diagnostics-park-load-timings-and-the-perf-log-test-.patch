@@ -0,0 +1,74 @@
+/*****************************************************************************
+ * Copyright (c) 2014-2026 OpenRCT2 developers
+ *
+ * For a complete list of all authors, please refer to contributors.md
+ * Interested in contributing? Visit https://github.com/OpenRCT2/OpenRCT2
+ *
+ * OpenRCT2 is licensed under the GNU General Public License version 3.
+ *****************************************************************************/
+
+// A performance log for test runs (--perf-log <file>). Off, and free, unless the
+// flag is given. One line per drawn frame (where its time went), a sample of memory and counts
+// every 10 s, and events (park loads, marks from the plugin). Read by tools/perfreport.py.
+
+#pragma once
+
+#include <chrono>
+#include <cstdint>
+#include <string>
+
+namespace OpenRCT2::PerfLog
+{
+    enum class Stage : uint8_t
+    {
+        tick,    // Context::Tick: the scene (simulation, title player) and the script engine's tick
+        script,  // every plugin call (hooks, intervals, UI callbacks), also counted inside tick
+        input,   // input handling and window updates
+        paint,   // BeginDraw and the painter
+        present, // EndDraw: copy to the screen, the overlay, vsync waits
+        count,
+    };
+
+    /** Opens the log; called once from the command line. quitAfterSeconds > 0 quits the game then. */
+    void Open(const std::string& path, double quitAfterSeconds);
+    bool IsEnabled();
+
+    /** Time since the log was opened, in milliseconds. */
+    double Now();
+
+    void AddStageTime(Stage stage, double ms);
+    void CountTick();
+
+    /** Ends a drawn frame: writes its line, a sample when one is due, and quits when the run is over. */
+    void FrameDrawn();
+
+    /** An event line: kind is one word, text the rest of the line. */
+    void Event(const char* kind, const std::string& text);
+
+    /** A mark from the plugin (scripting: screensaver.perfMark). */
+    void Mark(const std::string& text);
+
+    /** Image list use, filled in by drawing/Image.cpp. */
+    struct ImageListStats
+    {
+        uint32_t used = 0;
+        uint32_t freeRuns = 0;
+        uint32_t largestFreeRun = 0;
+    };
+    ImageListStats GetImageListStats();
+
+    /** Times a stage while in scope; nested scopes of the same stage count once. */
+    class ScopedStage
+    {
+        using clock = std::chrono::steady_clock;
+        Stage _stage;
+        bool _active;
+        clock::time_point _start;
+
+    public:
+        explicit ScopedStage(Stage stage);
+        ~ScopedStage();
+        ScopedStage(const ScopedStage&) = delete;
+        ScopedStage& operator=(const ScopedStage&) = delete;
+    };
+} // namespace OpenRCT2::PerfLog
