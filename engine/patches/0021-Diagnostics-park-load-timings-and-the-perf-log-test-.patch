+
+// See PerfLog.h. The format (one record per line, comma separated, the record
+// type first; free text only as the last field):
+//   C,<ms>,<key=value ...>                 configuration, written with the first frame
+//   F,<ms>,<interval>,<ticks>,<tick>,<script>,<input>,<paint>,<present>,<viewX>,<viewY>,<zoom>,<rotation>
+//   M,<ms>,<sampleMs>,<privateBytes>,<workingSet>,<handles>,<gdi>,<jsMalloc>,<jsUsed>,<imgUsed>,
+//     <imgFreeRuns>,<imgLargestFree>,<guests>,<staff>,<vehicles>,<litter>,<entities>,<rides>
+//   E,<ms>,<kind>,<text>                   events: load (park switch stages), mark (from the plugin), quit
+// Times are milliseconds since the log was opened; F's interval is the time since the previous
+// drawn frame ended. Lines are buffered and flushed with every sample and event.
+
+#include "PerfLog.h"
+
+#include "Context.h"
+#include "GameState.h"
+#include "Version.h"
+#include "config/Config.h"
+#include "core/String.hpp"
+#include "drawing/IDrawingEngine.h"
+#include "entity/EntityRegistry.h"
+#include "interface/Viewport.h"
+#include "interface/Window.h"
+#include "interface/WindowBase.h"
+#include "ride/RideManager.hpp"
+
+#ifdef ENABLE_SCRIPTING
+    #include "scripting/ScriptEngine.h"
+#endif
+
+#include <array>
+#include <cstdio>
+
+#ifdef _WIN32
+    #ifndef WIN32_LEAN_AND_MEAN
+        #define WIN32_LEAN_AND_MEAN
+    #endif
+    #ifndef NOMINMAX
+        #define NOMINMAX
+    #endif
+    #include <windows.h>
+    #include <psapi.h>
+#elif defined(__linux__)
+    #include <unistd.h>
+#endif
+
+namespace OpenRCT2::PerfLog
+{
+    using clock = std::chrono::steady_clock;
+
+    static constexpr double kSampleIntervalMs = 10000.0;
+
+    static FILE* _file = nullptr;
+    static clock::time_point _origin;
+    static double _quitAfterMs = 0;
+    static bool _quitRequested = false;
+    static bool _configWritten = false;
+    static double _lastFrameEnd = -1;
+    static double _lastSample = -kSampleIntervalMs;
+    static uint32_t _ticks = 0;
+    static std::array<double, static_cast<size_t>(Stage::count)> _stageMs{};
+    static std::array<uint8_t, static_cast<size_t>(Stage::count)> _depth{};
+
+    static double ToMs(clock::duration d)
+    {
+        return std::chrono::duration_cast<std::chrono::microseconds>(d).count() / 1000.0;
+    }
+
+    void Open(const std::string& path, double quitAfterSeconds)
+    {
+        if (_file != nullptr || path.empty())
+            return;
+#ifdef _WIN32
+        _file = _wfopen(String::toWideChar(path).c_str(), L"w");
+#else
+        _file = std::fopen(path.c_str(), "w");
+#endif
+        if (_file == nullptr)
+        {
+            std::fprintf(stderr, "perf log: cannot open %s\n", path.c_str());
+            return;
+        }
+        std::setvbuf(_file, nullptr, _IOFBF, 1 << 16);
+        _origin = clock::now();
+        _quitAfterMs = quitAfterSeconds > 0 ? quitAfterSeconds * 1000.0 : 0;
+        std::fprintf(_file, "# rct-screensaver perf log 1\n");
+        std::fflush(_file);
+        std::atexit([] {
+            if (_file != nullptr)
+            {
+                std::fprintf(_file, "E,%.1f,exit,\n", Now());
+                std::fclose(_file);
+                _file = nullptr;
+            }
+        });
+    }
+
+    bool IsEnabled()
+    {
+        return _file != nullptr;
+    }
+
+    double Now()
+    {
+        return ToMs(clock::now() - _origin);
+    }
+
+    void AddStageTime(Stage stage, double ms)
+    {
+        _stageMs[static_cast<size_t>(stage)] += ms;
+    }
+
+    void CountTick()
+    {
+        _ticks++;
+    }
+
+    ScopedStage::ScopedStage(Stage stage)
+        : _stage(stage)
+        , _active(_file != nullptr && _depth[static_cast<size_t>(stage)]++ == 0)
+        , _start(_active ? clock::now() : clock::time_point{})
+    {
+    }
+
+    ScopedStage::~ScopedStage()
+    {
+        if (_file == nullptr)
+            return;
+        auto& depth = _depth[static_cast<size_t>(_stage)];
+        if (depth > 0)
+            depth--;
+        if (_active)
+            _stageMs[static_cast<size_t>(_stage)] += ToMs(clock::now() - _start);
+    }
+
+    static void WriteConfig()
+    {
+        const auto& general = Config::Get().general;
+        const char* engine = "none";
+        switch (general.drawingEngine)
+        {
+            case DrawingEngine::softwareWithHardwareDisplay:
+                engine = "software";
+                break;
+            case DrawingEngine::openGL:
+                engine = "opengl";
+                break;
+            default:
+                break;
+        }
+        std::fprintf(
+            _file, "C,%.1f,version=%s engine=%s multithreading=%d uncap_fps=%d vsync=%d scale=%.2f fullscreen=%d window=%dx%d\n",
+            Now(), gVersionInfoFull, engine, general.multiThreading ? 1 : 0, general.uncapFPS ? 1 : 0,
+            general.useVSync ? 1 : 0, general.windowScale, general.fullscreenMode, ContextGetWidth(), ContextGetHeight());
+    }
+
+    struct ProcessMemory
+    {
+        uint64_t privateBytes = 0;
+        uint64_t workingSet = 0;
+        uint32_t handles = 0;
+        uint32_t gdi = 0;
+    };
+
+    static ProcessMemory GetProcessMemory()
+    {
+        ProcessMemory m;
+#ifdef _WIN32
+        PROCESS_MEMORY_COUNTERS_EX pmc{};
+        pmc.cb = sizeof(pmc);
+        if (K32GetProcessMemoryInfo(GetCurrentProcess(), reinterpret_cast<PROCESS_MEMORY_COUNTERS*>(&pmc), sizeof(pmc)))
+        {
+            m.privateBytes = pmc.PrivateUsage;
+            m.workingSet = pmc.WorkingSetSize;
+        }
+        DWORD handles = 0;
+        if (GetProcessHandleCount(GetCurrentProcess(), &handles))
+            m.handles = handles;
+        m.gdi = GetGuiResources(GetCurrentProcess(), GR_GDIOBJECTS);
+#elif defined(__linux__)
+        if (FILE* f = std::fopen("/proc/self/statm", "r"))
+        {
+            unsigned long size = 0, resident = 0, shared = 0, text = 0, lib = 0, data = 0;
+            if (std::fscanf(f, "%lu %lu %lu %lu %lu %lu", &size, &resident, &shared, &text, &lib, &data) == 6)
+            {
+                auto page = static_cast<uint64_t>(sysconf(_SC_PAGESIZE));
+                m.privateBytes = data * page;
+                m.workingSet = resident * page;
+            }
+            std::fclose(f);
+        }
+#endif
+        return m;
+    }
+
+    static void WriteSample(double now)
+    {
+        auto start = clock::now();
+        auto mem = GetProcessMemory();
+
+        int64_t jsMalloc = 0, jsUsed = 0;
+#ifdef ENABLE_SCRIPTING
+        if (auto* rt = Scripting::ScriptEngine::GetRuntime())
+        {
+            JSMemoryUsage usage{};
+            JS_ComputeMemoryUsage(rt, &usage);
+            jsMalloc = usage.malloc_size;
+            jsUsed = usage.memory_used_size;
+        }
+#endif
+        auto images = GetImageListStats();
+
+        auto& gameState = getGameState();
+        auto& entities = gameState.entities;
+        uint32_t guests = entities.getEntityListCount(EntityType::guest);
+        uint32_t staff = entities.getEntityListCount(EntityType::staff);
+        uint32_t vehicles = entities.getEntityListCount(EntityType::vehicle);
+        uint32_t litter = entities.getEntityListCount(EntityType::litter);
+        uint32_t all = 0;
+        for (size_t i = 0; i < static_cast<size_t>(EntityType::count); i++)
+            all += entities.getEntityListCount(static_cast<EntityType>(i));
+        size_t rides = RideManager(gameState).size();
+
+        double sampleMs = ToMs(clock::now() - start);
+        std::fprintf(
+            _file, "M,%.1f,%.2f,%llu,%llu,%u,%u,%lld,%lld,%u,%u,%u,%u,%u,%u,%u,%u,%zu\n", now, sampleMs,
+            static_cast<unsigned long long>(mem.privateBytes), static_cast<unsigned long long>(mem.workingSet), mem.handles,
+            mem.gdi, static_cast<long long>(jsMalloc), static_cast<long long>(jsUsed), images.used, images.freeRuns,
+            images.largestFreeRun, guests, staff, vehicles, litter, all, rides);
+        std::fflush(_file);
+    }
+
+    void FrameDrawn()
+    {
+        if (_file == nullptr)
+            return;
+        if (!_configWritten)
+        {
+            WriteConfig();
+            _configWritten = true;
+        }
+
+        double now = Now();
+        double interval = _lastFrameEnd < 0 ? 0 : now - _lastFrameEnd;
+        _lastFrameEnd = now;
+
+        int32_t viewX = 0, viewY = 0, zoom = 0, rotation = 0;
+        if (auto* w = WindowGetMain(); w != nullptr && w->viewport != nullptr)
+        {
+            viewX = w->viewport->viewPos.x;
+            viewY = w->viewport->viewPos.y;
+            zoom = static_cast<int8_t>(w->viewport->zoom);
+            rotation = w->viewport->rotation;
+        }
+
+        auto ms = [](Stage s) { return _stageMs[static_cast<size_t>(s)]; };
+        std::fprintf(
+            _file, "F,%.1f,%.2f,%u,%.2f,%.2f,%.2f,%.2f,%.2f,%d,%d,%d,%d\n", now, interval, _ticks, ms(Stage::tick),
+            ms(Stage::script), ms(Stage::input), ms(Stage::paint), ms(Stage::present), viewX, viewY, zoom, rotation);
+        _stageMs.fill(0);
+        _ticks = 0;
+
+        if (now - _lastSample >= kSampleIntervalMs)
+        {
+            _lastSample = now;
+            WriteSample(now);
+        }
+
+        if (_quitAfterMs > 0 && now >= _quitAfterMs && !_quitRequested)
+        {
+            _quitRequested = true;
+            Event("quit", "run time reached");
+            ContextQuit();
+        }
+    }
+
+    void Event(const char* kind, const std::string& text)
+    {
+        if (_file == nullptr)
+            return;
+        std::string clean = text;
+        for (auto& c : clean)
+        {
+            if (c == '\n' || c == '\r')
+                c = ' ';
+        }
+        std::fprintf(_file, "E,%.1f,%s,%s\n", Now(), kind, clean.c_str());
+        std::fflush(_file);
+    }
+
+    void Mark(const std::string& text)
+    {
+        Event("mark", text);
+    }
+} // namespace OpenRCT2::PerfLog
