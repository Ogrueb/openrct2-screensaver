+
+using namespace OpenRCT2;
+
+namespace OpenRCT2::Ui::Screensaver::Overlay
+{
+    struct Rect
+    {
+        int32_t left{};
+        int32_t top{};
+        int32_t right{}; // exclusive
+        int32_t bottom{};
+
+        bool empty() const
+        {
+            return right <= left || bottom <= top;
+        }
+
+        void unite(const Rect& other)
+        {
+            if (other.empty())
+                return;
+            if (empty())
+            {
+                *this = other;
+                return;
+            }
+            left = std::min(left, other.left);
+            top = std::min(top, other.top);
+            right = std::max(right, other.right);
+            bottom = std::max(bottom, other.bottom);
+        }
+
+        Rect intersect(const Rect& other) const
+        {
+            Rect r{ std::max(left, other.left), std::max(top, other.top), std::min(right, other.right),
+                    std::min(bottom, other.bottom) };
+            return r.empty() ? Rect{} : r;
+        }
+    };
+
+    struct TextLine
+    {
+        std::vector<uint8_t> coverage;
+        int32_t width{};
+        int32_t height{};
+        int32_t x{}; // within the box
+        int32_t y{};
+    };
+
+    struct TextLayout
+    {
+        std::string key;
+        std::vector<TextLine> lines;
+        int32_t width{};
+        int32_t height{};
+        int32_t boxWidth{};
+    };
+
+    struct Node
+    {
+        Element element;
+        uint64_t seq{};
+        TextLayout layout;
+        Rect bounds; // output pixels, at _scale
+        bool fading{};
+        float fadeFrom{};
+        float fadeTo{};
+        int32_t fadeMs{};
+        std::chrono::steady_clock::time_point fadeStart;
+    };
+
+    struct Picture
+    {
+        bool loaded{};
+        int32_t width{};
+        int32_t height{};
+        std::vector<uint32_t> pixels; // premultiplied ARGB
+    };
+
+    static std::unordered_map<std::string, Node> _nodes;
+    static uint64_t _nextSeq = 1;
+    static float _scale = 0.0f;
+    static int32_t _width = 0;
+    static int32_t _height = 0;
+    static std::vector<uint32_t> _buffer;
+    static Rect _dirty;
+    static bool _bufferEmpty = true;
+    static bool _uploadAll = true;
+    static std::string _defaultRegular;
+    static std::string _defaultBold;
+    static std::map<std::string, std::shared_ptr<Picture>> _pictures;
+
+#pragma region Paths and fonts
+
+    static std::string ResolvePath(const std::string& path)
+    {
+        if (path.empty() || Path::IsAbsolute(path))
+            return path;
+        auto& env = GetContext()->GetPlatformEnvironment();
+        return Path::Combine(env.GetDirectoryPath(DirBase::user, DirId::plugins), path);
+    }
+
+    static std::vector<std::string> DefaultFontCandidates(bool bold)
+    {
+        std::vector<std::string> result;
+        auto& configured = bold ? _defaultBold : _defaultRegular;
+        if (!configured.empty())
+            result.push_back(ResolvePath(configured));
+#ifdef _WIN32
+        const char* windir = std::getenv("WINDIR");
+        std::string fonts = std::string(windir != nullptr ? windir : "C:\\Windows") + "\\Fonts\\";
+        if (bold)
+        {
+            result.push_back(fonts + "segoeuib.ttf");
+            result.push_back(fonts + "arialbd.ttf");
+        }
+        result.push_back(fonts + "segoeui.ttf");
+        result.push_back(fonts + "arial.ttf");
+#elif defined(__APPLE__)
+        if (bold)
+            result.push_back("/System/Library/Fonts/Supplemental/Arial Bold.ttf");
+        result.push_back("/System/Library/Fonts/Supplemental/Arial.ttf");
+        result.push_back("/Library/Fonts/Arial.ttf");
+#else
+        if (bold)
+        {
+            result.push_back("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf");
+            result.push_back("/usr/share/fonts/TTF/DejaVuSans-Bold.ttf");
+            result.push_back("/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf");
+        }
+        result.push_back("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf");
+        result.push_back("/usr/share/fonts/TTF/DejaVuSans.ttf");
+        result.push_back("/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf");
+#endif
+        return result;
+    }
+
+#ifndef DISABLE_TTF
+    static std::map<std::string, TTF_Font*> _fonts;
+    static bool _ttfReady = false;
+    static bool _ttfFailed = false;
+
+    static TTF_Font* OpenFontFile(const std::string& path, int32_t pixelSize)
+    {
+        auto key = path + "|" + std::to_string(pixelSize);
+        auto it = _fonts.find(key);
+        if (it != _fonts.end())
+            return it->second;
+        TTF_Font* font = nullptr;
+        if (File::Exists(path))
+        {
+            font = TTF_OpenFont(path.c_str(), pixelSize);
+        }
+        _fonts[key] = font;
+        return font;
+    }
+
+    static TTF_Font* GetFont(const TextStyle& style, float scale)
+    {
+        if (!_ttfReady)
+        {
+            if (_ttfFailed)
+                return nullptr;
+            if (TTF_Init() != 0)
+            {
+                LOG_ERROR("Screensaver overlay: FreeType did not start");
+                _ttfFailed = true;
+                return nullptr;
+            }
+            _ttfReady = true;
+        }
+        int32_t pixelSize = std::max(1, static_cast<int32_t>(std::lround(style.size * scale)));
+        if (!style.font.empty())
+        {
+            auto font = OpenFontFile(ResolvePath(style.font), pixelSize);
+            if (font != nullptr)
+                return font;
+        }
+        for (const auto& path : DefaultFontCandidates(style.bold))
+        {
+            auto font = OpenFontFile(path, pixelSize);
+            if (font != nullptr)
+                return font;
+        }
+        return nullptr;
+    }
+
+    static int32_t TextWidth(TTF_Font* font, const std::string& text)
+    {
+        int w = 0;
+        int h = 0;
+        if (text.empty() || TTF_SizeUTF8(font, text.c_str(), &w, &h) != 0)
+            return 0;
+        return w;
+    }
+
+    // Splits text into lines: at line breaks, and between words where a line would pass wrapWidth.
+    static std::vector<std::string> WrapText(TTF_Font* font, const std::string& text, int32_t wrapWidth)
+    {
+        std::vector<std::string> lines;
+        size_t start = 0;
+        while (start <= text.size())
+        {
+            auto end = text.find('\n', start);
+            if (end == std::string::npos)
+                end = text.size();
+            std::string paragraph = text.substr(start, end - start);
+            if (!paragraph.empty() && paragraph.back() == '\r')
+                paragraph.pop_back();
+
+            if (wrapWidth <= 0 || TextWidth(font, paragraph) <= wrapWidth)
+            {
+                lines.push_back(paragraph);
+            }
+            else
+            {
+                std::string line;
+                size_t pos = 0;
+                while (pos < paragraph.size())
+                {
+                    auto space = paragraph.find(' ', pos);
+                    if (space == std::string::npos)
+                        space = paragraph.size();
+                    std::string word = paragraph.substr(pos, space - pos);
+                    std::string candidate = line.empty() ? word : line + " " + word;
+                    if (!line.empty() && TextWidth(font, candidate) > wrapWidth)
+                    {
+                        lines.push_back(line);
+                        line = word;
+                    }
+                    else
+                    {
+                        line = candidate;
+                    }
+                    pos = space + 1;
+                }
+                lines.push_back(line);
+            }
+            start = end + 1;
+        }
+        return lines;
+    }
+#endif
+
+#pragma endregion
+
+#pragma region Layout
+
+    static std::string LayoutKey(const std::string& text, const TextStyle& style, float scale)
+    {
+        return text + '\x1f' + style.font + '\x1f' + std::to_string(style.size) + '\x1f' + (style.bold ? "b" : "r") + '\x1f'
+            + std::to_string(static_cast<int>(style.align)) + '\x1f' + std::to_string(style.wrap) + '\x1f'
+            + std::to_string(style.lineHeight) + '\x1f' + std::to_string(scale);
+    }
+
+    static TextLayout LayoutText(const std::string& text, const TextStyle& style, float scale)
+    {
+        TextLayout layout;
+        layout.key = LayoutKey(text, style, scale);
+#ifndef DISABLE_TTF
+        auto font = GetFont(style, scale);
+        if (font == nullptr)
+            return layout;
+        int32_t wrapWidth = static_cast<int32_t>(std::lround(style.wrap * scale));
+        int32_t advance = std::max(1, static_cast<int32_t>(std::lround(style.size * style.lineHeight * scale)));
+        auto lines = WrapText(font, text, wrapWidth);
+        int32_t y = 0;
+        for (const auto& lineText : lines)
+        {
+            TextLine line;
+            line.y = y;
+            if (!lineText.empty())
+            {
+                TTFSurface* surface = TTF_RenderUTF8(font, lineText.c_str(), true);
+                if (surface != nullptr)
+                {
+                    line.width = surface->w;
+                    line.height = surface->h;
+                    auto src = static_cast<const uint8_t*>(surface->pixels);
+                    line.coverage.assign(src, src + static_cast<size_t>(surface->w) * surface->h);
+                    TTFFreeSurface(surface);
+                }
+            }
+            layout.width = std::max(layout.width, line.width);
+            layout.height = std::max(layout.height, y + std::max(line.height, advance));
+            layout.lines.push_back(std::move(line));
+            y += advance;
+        }
+        layout.boxWidth = wrapWidth > 0 ? wrapWidth : layout.width;
+        for (auto& line : layout.lines)
+        {
+            switch (style.align)
+            {
+                case Align::left:
+                    line.x = 0;
+                    break;
+                case Align::centre:
+                    line.x = (layout.boxWidth - line.width) / 2;
+                    break;
+                case Align::right:
+                    line.x = layout.boxWidth - line.width;
+                    break;
+            }
+        }
+#endif
+        return layout;
+    }
+
+    static std::shared_ptr<Picture> GetPicture(const std::string& src)
+    {
+        auto path = ResolvePath(src);
+        auto it = _pictures.find(path);
+        if (it != _pictures.end())
+            return it->second;
+        auto picture = std::make_shared<Picture>();
+        try
+        {
+            auto image = Imaging::ReadFromFile(path, ImageFormat::png32);
+            picture->width = static_cast<int32_t>(image.Width);
+            picture->height = static_cast<int32_t>(image.Height);
+            picture->pixels.resize(static_cast<size_t>(picture->width) * picture->height);
+            for (size_t i = 0; i < picture->pixels.size(); i++)
+            {
+                const uint8_t* p = &image.Pixels[i * 4];
+                uint32_t a = p[3];
+                uint32_t r = (p[0] * a + 127) / 255;
+                uint32_t g = (p[1] * a + 127) / 255;
+                uint32_t b = (p[2] * a + 127) / 255;
+                picture->pixels[i] = (a << 24) | (r << 16) | (g << 8) | b;
+            }
+            picture->loaded = true;
+        }
+        catch (const std::exception& e)
+        {
+            LOG_ERROR("Screensaver overlay: cannot read image %s: %s", path.c_str(), e.what());
+        }
+        _pictures[path] = picture;
+        return picture;
+    }
+
+    static int32_t Px(float v, float scale)
+    {
+        return static_cast<int32_t>(std::lround(v * scale));
+    }
+
+    static Rect ComputeBounds(Node& node, float scale)
+    {
+        if (scale <= 0.0f)
+            return {};
+        const auto& e = node.element;
+        switch (e.kind)
+        {
+            case Kind::rect:
+                return { Px(e.x, scale), Px(e.y, scale), Px(e.x + e.width, scale), Px(e.y + e.height, scale) };
+            case Kind::text:
+            {
+                auto key = LayoutKey(e.text, e.style, scale);
+                if (node.layout.key != key)
+                    node.layout = LayoutText(e.text, e.style, scale);
+                int32_t left = Px(e.x, scale);
+                if (e.style.wrap <= 0.0f)
+                {
+                    if (e.style.align == Align::centre)
+                        left -= node.layout.boxWidth / 2;
+                    else if (e.style.align == Align::right)
+                        left -= node.layout.boxWidth;
+                }
+                int32_t top = Px(e.y, scale);
+                int32_t shadow = e.style.shadow.a != 0 ? std::max(1, Px(1.0f, scale)) : 0;
+                return { left, top, left + node.layout.boxWidth + shadow, top + node.layout.height + shadow };
+            }
+            case Kind::image:
+            {
+                int32_t left = Px(e.x, scale);
+                int32_t top = Px(e.y, scale);
+                int32_t w = Px(e.width, scale);
+                int32_t h = Px(e.height, scale);
+                if (w <= 0 || h <= 0)
+                {
+                    auto picture = GetPicture(e.src);
+                    w = picture->width;
+                    h = picture->height;
+                }
+                return { left, top, left + w, top + h };
+            }
+        }
+        return {};
+    }
+
+#pragma endregion
+
+#pragma region Rasterizing
+
+    static inline void Blend(uint32_t& dst, uint32_t a, uint32_t r, uint32_t g, uint32_t b)
+    {
+        // premultiplied "over"
+        if (a == 0 && r == 0 && g == 0 && b == 0)
+            return;
+        uint32_t inv = 255 - a;
+        uint32_t da = (dst >> 24) & 0xFF;
+        uint32_t dr = (dst >> 16) & 0xFF;
+        uint32_t dg = (dst >> 8) & 0xFF;
+        uint32_t db = dst & 0xFF;
+        da = a + (da * inv + 127) / 255;
+        dr = r + (dr * inv + 127) / 255;
+        dg = g + (dg * inv + 127) / 255;
+        db = b + (db * inv + 127) / 255;
+        dst = (std::min(da, 255u) << 24) | (std::min(dr, 255u) << 16) | (std::min(dg, 255u) << 8) | std::min(db, 255u);
+    }
+
+    static void FillRect(const Rect& area, const Rect& clip, Colour colour, float opacity)
+    {
+        auto r = area.intersect(clip);
+        if (r.empty())
+            return;
+        uint32_t a = static_cast<uint32_t>(std::lround(colour.a * std::clamp(opacity, 0.0f, 1.0f)));
+        if (a == 0)
+            return;
+        uint32_t pr = (colour.r * a + 127) / 255;
+        uint32_t pg = (colour.g * a + 127) / 255;
+        uint32_t pb = (colour.b * a + 127) / 255;
+        for (int32_t y = r.top; y < r.bottom; y++)
+        {
+            uint32_t* row = &_buffer[static_cast<size_t>(y) * _width];
+            for (int32_t x = r.left; x < r.right; x++)
+                Blend(row[x], a, pr, pg, pb);
+        }
+    }
+
+    static void DrawCoverage(
+        const std::vector<uint8_t>& coverage, int32_t w, int32_t h, int32_t left, int32_t top, const Rect& clip, Colour colour,
+        float opacity)
+    {
+        Rect r = Rect{ left, top, left + w, top + h }.intersect(clip);
+        if (r.empty())
+            return;
+        uint32_t alpha = static_cast<uint32_t>(std::lround(colour.a * std::clamp(opacity, 0.0f, 1.0f)));
+        if (alpha == 0)
+            return;
+        for (int32_t y = r.top; y < r.bottom; y++)
+        {
+            const uint8_t* src = &coverage[static_cast<size_t>(y - top) * w];
+            uint32_t* row = &_buffer[static_cast<size_t>(y) * _width];
+            for (int32_t x = r.left; x < r.right; x++)
+            {
+                uint32_t c = src[x - left];
+                if (c == 0)
+                    continue;
+                uint32_t a = (alpha * c + 127) / 255;
+                Blend(row[x], a, (colour.r * a + 127) / 255, (colour.g * a + 127) / 255, (colour.b * a + 127) / 255);
+            }
+        }
+    }
+
+    static void DrawText(Node& node, const Rect& clip)
+    {
+        const auto& style = node.element.style;
+        int32_t shadow = style.shadow.a != 0 ? std::max(1, Px(1.0f, _scale)) : 0;
+        int32_t left = node.bounds.left;
+        int32_t top = node.bounds.top;
+        for (const auto& line : node.layout.lines)
+        {
+            if (line.coverage.empty())
+                continue;
+            if (shadow > 0)
+            {
+                DrawCoverage(
+                    line.coverage, line.width, line.height, left + line.x + shadow, top + line.y + shadow, clip, style.shadow,
+                    node.element.opacity);
+            }
+            DrawCoverage(
+                line.coverage, line.width, line.height, left + line.x, top + line.y, clip, style.colour, node.element.opacity);
+        }
+    }
+
+    static void DrawImage(Node& node, const Rect& clip)
+    {
+        auto picture = GetPicture(node.element.src);
+        if (!picture->loaded || picture->width == 0 || picture->height == 0)
+            return;
+        const auto& b = node.bounds;
+        auto r = b.intersect(clip);
+        if (r.empty())
+            return;
+        uint32_t opacity = static_cast<uint32_t>(std::lround(255.0f * std::clamp(node.element.opacity, 0.0f, 1.0f)));
+        if (opacity == 0)
+            return;
+        float sx = static_cast<float>(picture->width) / (b.right - b.left);
+        float sy = static_cast<float>(picture->height) / (b.bottom - b.top);
+        for (int32_t y = r.top; y < r.bottom; y++)
+        {
+            int32_t py = std::min(picture->height - 1, static_cast<int32_t>((y - b.top + 0.5f) * sy));
+            uint32_t* row = &_buffer[static_cast<size_t>(y) * _width];
+            const uint32_t* src = &picture->pixels[static_cast<size_t>(py) * picture->width];
+            for (int32_t x = r.left; x < r.right; x++)
+            {
+                int32_t px = std::min(picture->width - 1, static_cast<int32_t>((x - b.left + 0.5f) * sx));
+                uint32_t p = src[px];
+                uint32_t a = ((p >> 24) * opacity + 127) / 255;
+                uint32_t pr = (((p >> 16) & 0xFF) * opacity + 127) / 255;
+                uint32_t pg = (((p >> 8) & 0xFF) * opacity + 127) / 255;
+                uint32_t pb = ((p & 0xFF) * opacity + 127) / 255;
+                Blend(row[x], a, pr, pg, pb);
+            }
+        }
+    }
+
+    static void DrawNode(Node& node, const Rect& clip)
+    {
+        const auto& e = node.element;
+        if (e.opacity <= 0.0f || node.bounds.intersect(clip).empty())
+            return;
+        switch (e.kind)
+        {
+            case Kind::rect:
+            {
+                const auto& b = node.bounds;
+                int32_t bw = e.borderWidth > 0.0f && e.border.a != 0 ? std::max(1, Px(e.borderWidth, _scale)) : 0;
+                Rect inner{ b.left + bw, b.top + bw, b.right - bw, b.bottom - bw };
+                FillRect(inner, clip, e.fill, e.opacity);
+                if (bw > 0)
+                {
+                    FillRect({ b.left, b.top, b.right, b.top + bw }, clip, e.border, e.opacity);
+                    FillRect({ b.left, b.bottom - bw, b.right, b.bottom }, clip, e.border, e.opacity);
+                    FillRect({ b.left, b.top + bw, b.left + bw, b.bottom - bw }, clip, e.border, e.opacity);
+                    FillRect({ b.right - bw, b.top + bw, b.right, b.bottom - bw }, clip, e.border, e.opacity);
+                }
+                break;
+            }
+            case Kind::text:
+                DrawText(node, clip);
+                break;
+            case Kind::image:
+                DrawImage(node, clip);
+                break;
+        }
+    }
+
+    static void Rasterise(const Rect& area)
+    {
+        Rect clip = area.intersect({ 0, 0, _width, _height });
+        if (clip.empty())
+            return;
+        for (int32_t y = clip.top; y < clip.bottom; y++)
+        {
+            std::fill_n(&_buffer[static_cast<size_t>(y) * _width + clip.left], clip.right - clip.left, 0u);
+        }
+        std::vector<Node*> order;
+        order.reserve(_nodes.size());
+        for (auto& [id, node] : _nodes)
+            order.push_back(&node);
+        std::sort(order.begin(), order.end(), [](const Node* a, const Node* b) {
+            if (a->element.z != b->element.z)
+                return a->element.z < b->element.z;
+            return a->seq < b->seq;
+        });
+        for (auto* node : order)
+            DrawNode(*node, clip);
+    }
+
+#pragma endregion
+
+    void Set(const std::string& id, const Element& element)
+    {
+        auto it = _nodes.find(id);
+        if (it != _nodes.end())
+        {
+            _dirty.unite(it->second.bounds);
+            it->second.element = element;
+            it->second.fading = false;
+        }
+        else
+        {
+            Node node;
+            node.element = element;
+            node.seq = _nextSeq++;
+            it = _nodes.emplace(id, std::move(node)).first;
+        }
+        it->second.bounds = ComputeBounds(it->second, _scale);
+        _dirty.unite(it->second.bounds);
+    }
+
+    bool Remove(const std::string& id)
+    {
+        auto it = _nodes.find(id);
+        if (it == _nodes.end())
+            return false;
+        _dirty.unite(it->second.bounds);
+        _nodes.erase(it);
+        return true;
+    }
+
+    void Clear()
+    {
+        for (auto& [id, node] : _nodes)
+            _dirty.unite(node.bounds);
+        _nodes.clear();
+        _pictures.clear();
+    }
+
+    bool Fade(const std::string& id, float opacity, int32_t ms)
+    {
+        auto it = _nodes.find(id);
+        if (it == _nodes.end())
+            return false;
+        auto& node = it->second;
+        opacity = std::clamp(opacity, 0.0f, 1.0f);
+        if (ms <= 0)
+        {
+            node.fading = false;
+            node.element.opacity = opacity;
+            _dirty.unite(node.bounds);
+            return true;
+        }
+        node.fading = true;
+        node.fadeFrom = node.element.opacity;
+        node.fadeTo = opacity;
+        node.fadeMs = ms;
+        node.fadeStart = std::chrono::steady_clock::now();
+        return true;
+    }
+
+    Size MeasureText(const std::string& text, const TextStyle& style)
+    {
+        float scale = _scale > 0.0f ? _scale : 1.0f;
+        auto layout = LayoutText(text, style, scale);
+        return { layout.width / scale, layout.height / scale };
+    }
+
+    void SetDefaultFonts(const std::string& regular, const std::string& bold)
+    {
+        _defaultRegular = regular;
+        _defaultBold = bold;
+        // Re-layout text in the new fonts.
+        for (auto& [id, node] : _nodes)
+        {
+            node.layout.key.clear();
+            _dirty.unite(node.bounds);
+            node.bounds = ComputeBounds(node, _scale);
+            _dirty.unite(node.bounds);
+        }
+    }
+
+    void RequestFullUpload()
+    {
+        _uploadAll = true;
+    }
+
+    float GetScale()
+    {
+        return _scale > 0.0f ? _scale : 1.0f;
+    }
+
+    bool Prepare(int32_t width, int32_t height, int32_t gameWidth, Frame& frame)
+    {
+        if (width <= 0 || height <= 0)
+            return false;
+        if (_nodes.empty() && _bufferEmpty)
+        {
+            // Nothing drawn and nothing to draw; the engines' copy may be stale from here on.
+            _dirty = {};
+            _uploadAll = true;
+            return false;
+        }
+
+        float scale = static_cast<float>(width) / std::max(1, gameWidth);
+        if (width != _width || height != _height || std::abs(scale - _scale) > 0.0001f)
+        {
+            _width = width;
+            _height = height;
+            _scale = scale;
+            _buffer.assign(static_cast<size_t>(width) * height, 0u);
+            for (auto& [id, node] : _nodes)
+                node.bounds = ComputeBounds(node, _scale);
+            _dirty = { 0, 0, width, height };
+        }
+
+        auto now = std::chrono::steady_clock::now();
+        for (auto& [id, node] : _nodes)
+        {
+            if (!node.fading)
+                continue;
+            float t = std::chrono::duration<float, std::milli>(now - node.fadeStart).count() / node.fadeMs;
+            if (t >= 1.0f)
+            {
+                t = 1.0f;
+                node.fading = false;
+            }
+            node.element.opacity = node.fadeFrom + (node.fadeTo - node.fadeFrom) * t;
+            _dirty.unite(node.bounds);
+        }
+
+        if (_uploadAll)
+        {
+            _dirty = { 0, 0, _width, _height };
+            _uploadAll = false;
+        }
+        Rect dirty = _dirty.intersect({ 0, 0, _width, _height });
+        _dirty = {};
+        if (!dirty.empty())
+        {
+            Rasterise(dirty);
+        }
+        _bufferEmpty = _nodes.empty();
+
+        frame.pixels = _buffer.data();
+        frame.width = _width;
+        frame.height = _height;
+        frame.dirtyX = dirty.left;
+        frame.dirtyY = dirty.top;
+        frame.dirtyWidth = dirty.empty() ? 0 : dirty.right - dirty.left;
+        frame.dirtyHeight = dirty.empty() ? 0 : dirty.bottom - dirty.top;
+        return true;
+    }
+} // namespace OpenRCT2::Ui::Screensaver::Overlay
diff --git a/src/openrct2-ui/screensaver/Overlay.h b/src/openrct2-ui/screensaver/Overlay.h
