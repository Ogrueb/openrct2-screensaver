index 0000000..cb74ffd
--- /dev/null
+++ b/src/openrct2-ui/screensaver/Overlay.h
@@ -0,0 +1,112 @@
+/*****************************************************************************
+ * Copyright (c) 2014-2026 OpenRCT2 developers
+ *
+ * For a complete list of all authors, please refer to contributors.md
+ * Interested in contributing? Visit https://github.com/OpenRCT2/OpenRCT2
+ *
+ * OpenRCT2 is licensed under the GNU General Public License version 3.
+ *****************************************************************************/
+
+// A retained scene of rectangles, text and images that a plugin describes and the
+// drawing engines composite over the frame at the window's full resolution, with real alpha.
+// Positions and sizes are in game pixels; the scene is rasterized on the CPU into a premultiplied
+// ARGB buffer at the output size, and only where it changed.
+
+#pragma once
+
+#include <cstdint>
+#include <optional>
+#include <string>
+
+namespace OpenRCT2::Ui::Screensaver::Overlay
+{
+    struct Colour
+    {
+        uint8_t r{};
+        uint8_t g{};
+        uint8_t b{};
+        uint8_t a{};
+    };
+
+    enum class Kind : uint8_t
+    {
+        rect,
+        text,
+        image,
+    };
+
+    enum class Align : uint8_t
+    {
+        left,
+        centre,
+        right,
+    };
+
+    struct TextStyle
+    {
+        std::string font; // a .ttf/.otf path, absolute or under the user plugin folder; empty: default
+        float size = 16.0f; // game pixels
+        bool bold = false;
+        Colour colour{ 255, 255, 255, 255 };
+        Align align = Align::left;
+        float wrap = 0.0f;        // wrap width in game pixels; 0: no wrapping
+        float lineHeight = 1.25f; // times size
+        Colour shadow{};          // a drop shadow one game pixel down and right; alpha 0: none
+    };
+
+    struct Element
+    {
+        Kind kind = Kind::rect;
+        float x{};
+        float y{};
+        float width{};  // rect, image (0: the image's own size in output pixels)
+        float height{}; // rect, image
+        float opacity = 1.0f;
+        int32_t z{};
+        // rect
+        Colour fill{};
+        Colour border{};
+        float borderWidth{};
+        // text
+        std::string text;
+        TextStyle style;
+        // image: a PNG path, absolute or under the user plugin folder
+        std::string src;
+    };
+
+    struct Size
+    {
+        float width{};
+        float height{};
+    };
+
+    void Set(const std::string& id, const Element& element);
+    bool Remove(const std::string& id);
+    void Clear();
+    // Runs the element's opacity to the target over ms of real time, without plugin work per frame.
+    bool Fade(const std::string& id, float opacity, int32_t ms);
+    Size MeasureText(const std::string& text, const TextStyle& style);
+    void SetDefaultFonts(const std::string& regular, const std::string& bold);
+    // The output size over the game size (OpenRCT2's scale factor), as of the last frame.
+    float GetScale();
+
+    struct Frame
+    {
+        const uint32_t* pixels{}; // premultiplied 0xAARRGGBB, width * height
+        int32_t width{};
+        int32_t height{};
+        // The part that changed since the last frame (width 0: nothing).
+        int32_t dirtyX{};
+        int32_t dirtyY{};
+        int32_t dirtyWidth{};
+        int32_t dirtyHeight{};
+    };
+
+    // The engine's copy of the overlay was lost (a new texture): the next frame reports everything.
+    void RequestFullUpload();
+
+    // Called by the drawing engines once per presented frame with the output size in pixels.
+    // Returns false when there is nothing to draw.
+    // gameWidth is the game's own width in game pixels (the output is that times the scale factor).
+    bool Prepare(int32_t width, int32_t height, int32_t gameWidth, Frame& frame);
+} // namespace OpenRCT2::Ui::Screensaver::Overlay
diff --git a/src/openrct2-ui/screensaver/OverlayCompositor.cpp b/src/openrct2-ui/screensaver/OverlayCompositor.cpp
new file mode 100644
index 0000000..aa445cd
--- /dev/null
+++ b/src/openrct2-ui/screensaver/OverlayCompositor.cpp
@@ -0,0 +1,276 @@
+/*****************************************************************************
+ * Copyright (c) 2014-2026 OpenRCT2 developers
+ *
+ * For a complete list of all authors, please refer to contributors.md
+ * Interested in contributing? Visit https://github.com/OpenRCT2/OpenRCT2
+ *
+ * OpenRCT2 is licensed under the GNU General Public License version 3.
+ *****************************************************************************/
+
+#include "OverlayCompositor.h"
+
+#include "Overlay.h"
+#include "Screensaver.h"
+
+#include <SDL.h>
+#include <openrct2/Context.h>
+#include <openrct2/Diagnostic.h>
+
+#ifndef DISABLE_OPENGL
+    #include "../drawing/engines/opengl/OpenGLAPI.h"
+#endif
+
+namespace OpenRCT2::Ui::Screensaver
+{
+#pragma region Software engine (SDL renderer)
+
+    static SDL_Renderer* _sdlOwner = nullptr;
+    static SDL_Texture* _sdlTexture = nullptr;
+    static int32_t _sdlWidth = 0;
+    static int32_t _sdlHeight = 0;
+
+    void ReleaseOverlay(SDL_Renderer* renderer)
+    {
+        if (_sdlTexture != nullptr && _sdlOwner == renderer)
+        {
+            SDL_DestroyTexture(_sdlTexture);
+        }
+        _sdlTexture = nullptr;
+        _sdlOwner = nullptr;
+    }
+
+    void CompositeOverlay(SDL_Renderer* renderer)
+    {
+        if (!IsActive() || renderer == nullptr)
+            return;
+        int w = 0;
+        int h = 0;
+        if (SDL_GetRendererOutputSize(renderer, &w, &h) != 0 || w <= 0 || h <= 0)
+            return;
+
+        if (_sdlTexture == nullptr || _sdlOwner != renderer || w != _sdlWidth || h != _sdlHeight)
+        {
+            ReleaseOverlay(_sdlOwner);
+            _sdlTexture = SDL_CreateTexture(renderer, SDL_PIXELFORMAT_ARGB8888, SDL_TEXTUREACCESS_STREAMING, w, h);
+            if (_sdlTexture == nullptr)
+            {
+                LOG_ERROR("Screensaver overlay: cannot create a %dx%d texture: %s", w, h, SDL_GetError());
+                return;
+            }
+            // The overlay is premultiplied.
+            auto premultiplied = SDL_ComposeCustomBlendMode(
+                SDL_BLENDFACTOR_ONE, SDL_BLENDFACTOR_ONE_MINUS_SRC_ALPHA, SDL_BLENDOPERATION_ADD, SDL_BLENDFACTOR_ONE,
+                SDL_BLENDFACTOR_ONE_MINUS_SRC_ALPHA, SDL_BLENDOPERATION_ADD);
+            if (SDL_SetTextureBlendMode(_sdlTexture, premultiplied) != 0)
+            {
+                LOG_WARNING("Screensaver overlay: no premultiplied blending in this renderer, edges will be darker");
+                SDL_SetTextureBlendMode(_sdlTexture, SDL_BLENDMODE_BLEND);
+            }
+            _sdlOwner = renderer;
+            _sdlWidth = w;
+            _sdlHeight = h;
+            Overlay::RequestFullUpload();
+        }
+
+        Overlay::Frame frame;
+        if (!Overlay::Prepare(w, h, ContextGetWidth(), frame))
+            return;
+        if (frame.dirtyWidth > 0 && frame.dirtyHeight > 0)
+        {
+            SDL_Rect rect{ frame.dirtyX, frame.dirtyY, frame.dirtyWidth, frame.dirtyHeight };
+            const uint32_t* src = frame.pixels + static_cast<size_t>(frame.dirtyY) * frame.width + frame.dirtyX;
+            SDL_UpdateTexture(_sdlTexture, &rect, src, frame.width * 4);
+        }
+        SDL_RenderCopy(renderer, _sdlTexture, nullptr, nullptr);
+    }
+
+#pragma endregion
+
+#pragma region OpenGL engine
+
+#ifndef DISABLE_OPENGL
+    static constexpr const char* kVertexShader = R"(#version 330 core
+in vec2 vPosition;
+out vec2 fTextureCoordinate;
+void main()
+{
+    fTextureCoordinate = vec2((vPosition.x + 1.0) * 0.5, (1.0 - vPosition.y) * 0.5);
+    gl_Position = vec4(vPosition, 0.0, 1.0);
+}
+)";
+
+    static constexpr const char* kFragmentShader = R"(#version 330 core
+in vec2 fTextureCoordinate;
+out vec4 fragColor;
+uniform sampler2D uTexture;
+void main()
+{
+    fragColor = texture(uTexture, fTextureCoordinate);
+}
+)";
+
+    static SDL_GLContext _glOwner = nullptr;
+    static bool _glFailed = false;
+    static GLuint _glProgram = 0;
+    static GLuint _glVao = 0;
+    static GLuint _glVbo = 0;
+    static GLuint _glTexture = 0;
+    static int32_t _glWidth = 0;
+    static int32_t _glHeight = 0;
+
+    static GLuint CompileShader(GLenum type, const char* source)
+    {
+        GLuint shader = glCreateShader(type);
+        glShaderSource(shader, 1, &source, nullptr);
+        glCompileShader(shader);
+        GLint status = GL_FALSE;
+        glGetShaderiv(shader, GL_COMPILE_STATUS, &status);
+        if (status != GL_TRUE)
+        {
+            char log[1024]{};
+            glGetShaderInfoLog(shader, sizeof(log), nullptr, log);
+            LOG_ERROR("Screensaver overlay: shader did not compile: %s", log);
+            glDeleteShader(shader);
+            return 0;
+        }
+        return shader;
+    }
+
+    static bool CreateGLObjects()
+    {
+        GLuint vs = CompileShader(GL_VERTEX_SHADER, kVertexShader);
+        GLuint fs = CompileShader(GL_FRAGMENT_SHADER, kFragmentShader);
+        if (vs == 0 || fs == 0)
+            return false;
+        _glProgram = glCreateProgram();
+        glAttachShader(_glProgram, vs);
+        glAttachShader(_glProgram, fs);
+        glBindFragDataLocation(_glProgram, 0, "fragColor");
+        glLinkProgram(_glProgram);
+        glDetachShader(_glProgram, vs);
+        glDetachShader(_glProgram, fs);
+        glDeleteShader(vs);
+        glDeleteShader(fs);
+        GLint status = GL_FALSE;
+        glGetProgramiv(_glProgram, GL_LINK_STATUS, &status);
+        if (status != GL_TRUE)
+        {
+            char log[1024]{};
+            glGetProgramInfoLog(_glProgram, sizeof(log), nullptr, log);
+            LOG_ERROR("Screensaver overlay: shader program did not link: %s", log);
+            return false;
+        }
+
+        static constexpr GLfloat kQuad[] = { -1.0f, -1.0f, 1.0f, -1.0f, -1.0f, 1.0f, 1.0f, 1.0f };
+        glGenVertexArrays(1, &_glVao);
+        glGenBuffers(1, &_glVbo);
+        glBindVertexArray(_glVao);
+        glBindBuffer(GL_ARRAY_BUFFER, _glVbo);
+        glBufferData(GL_ARRAY_BUFFER, sizeof(kQuad), kQuad, GL_STATIC_DRAW);
+        GLint position = glGetAttribLocation(_glProgram, "vPosition");
+        glVertexAttribPointer(position, 2, GL_FLOAT, GL_FALSE, 2 * sizeof(GLfloat), nullptr);
+        glEnableVertexAttribArray(position);
+
+        glUseProgram(_glProgram);
+        OpenGLState::CurrentProgram = _glProgram;
+        glUniform1i(glGetUniformLocation(_glProgram, "uTexture"), 0);
+
+        glGenTextures(1, &_glTexture);
+        return true;
+    }
+
+    void ReleaseOverlayGL()
+    {
+        if (_glOwner != nullptr && _glOwner == SDL_GL_GetCurrentContext())
+        {
+            if (_glTexture != 0)
+                glDeleteTextures(1, &_glTexture);
+            if (_glVbo != 0)
+                glDeleteBuffers(1, &_glVbo);
+            if (_glVao != 0)
+                glDeleteVertexArrays(1, &_glVao);
+            if (_glProgram != 0)
+            {
+                if (OpenGLState::CurrentProgram == _glProgram)
+                    OpenGLState::CurrentProgram = 0;
+                glDeleteProgram(_glProgram);
+            }
+        }
+        _glOwner = nullptr;
+        _glProgram = _glVao = _glVbo = _glTexture = 0;
+        _glWidth = _glHeight = 0;
+        _glFailed = false;
+    }
+
+    void CompositeOverlayGL(SDL_Window* window)
+    {
+        if (!IsActive() || window == nullptr)
+            return;
+        auto context = SDL_GL_GetCurrentContext();
+        if (context != _glOwner)
+        {
+            ReleaseOverlayGL();
+            _glOwner = context;
+            if (!CreateGLObjects())
+            {
+                _glFailed = true;
+            }
+        }
+        if (_glFailed)
+            return;
+
+        int w = 0;
+        int h = 0;
+        SDL_GL_GetDrawableSize(window, &w, &h);
+        if (w <= 0 || h <= 0)
+            return;
+
+        OpenGLAPI::SetTexture(0, GL_TEXTURE_2D, _glTexture);
+        if (w != _glWidth || h != _glHeight)
+        {
+            glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, w, h, 0, GL_BGRA, GL_UNSIGNED_BYTE, nullptr);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+            _glWidth = w;
+            _glHeight = h;
+            Overlay::RequestFullUpload();
+        }
+
+        Overlay::Frame frame;
+        if (!Overlay::Prepare(w, h, ContextGetWidth(), frame))
+            return;
+        if (frame.dirtyWidth > 0 && frame.dirtyHeight > 0)
+        {
+            glPixelStorei(GL_UNPACK_ROW_LENGTH, frame.width);
+            const uint32_t* src = frame.pixels + static_cast<size_t>(frame.dirtyY) * frame.width + frame.dirtyX;
+            glTexSubImage2D(
+                GL_TEXTURE_2D, 0, frame.dirtyX, frame.dirtyY, frame.dirtyWidth, frame.dirtyHeight, GL_BGRA, GL_UNSIGNED_BYTE,
+                src);
+            glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
+        }
+
+        glBindFramebuffer(GL_FRAMEBUFFER, 0);
+        glViewport(0, 0, w, h);
+        glDisable(GL_DEPTH_TEST);
+        glEnable(GL_BLEND);
+        glBlendFunc(GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
+        glUseProgram(_glProgram);
+        OpenGLState::CurrentProgram = _glProgram;
+        glBindVertexArray(_glVao);
+        glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+        glDisable(GL_BLEND);
+    }
+#else
+    void CompositeOverlayGL(SDL_Window*)
+    {
+    }
+
+    void ReleaseOverlayGL()
+    {
+    }
+#endif
+
+#pragma endregion
+} // namespace OpenRCT2::Ui::Screensaver
