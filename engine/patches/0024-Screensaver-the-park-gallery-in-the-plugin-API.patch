+namespace OpenRCT2::Ui::Gallery
+{
+#pragma region Folders
+
+    u8string OwnFolder()
+    {
+        auto& env = GetContext()->GetPlatformEnvironment();
+        return Path::Combine(env.GetDirectoryPath(DirBase::user), u8"gallery");
+    }
+
+    std::vector<u8string> AddedFolders()
+    {
+        std::vector<u8string> folders;
+        for (auto folder : String::split(Config::Get().general.fileBrowserGalleryFolders, "|"))
+        {
+            if (!folder.empty())
+                folders.emplace_back(folder);
+        }
+        return folders;
+    }
+
+    void SetAddedFolders(const std::vector<u8string>& folders)
+    {
+        u8string joined;
+        for (const auto& folder : folders)
+        {
+            if (!joined.empty())
+                joined += '|';
+            joined += folder;
+        }
+        Config::Get().general.fileBrowserGalleryFolders = joined;
+        Config::Save();
+        Refresh();
+    }
+
+    u8string NormalisedFolder(const u8string& folder)
+    {
+        auto absolute = Path::GetAbsolute(folder);
+        while (absolute.size() > 1 && (absolute.back() == '/' || absolute.back() == '\\'))
+            absolute.pop_back();
+        return absolute;
+    }
+
+    bool IsGalleryFolder(const u8string& folder)
+    {
+        const auto normalised = NormalisedFolder(folder);
+        if (Path::Equals(normalised, NormalisedFolder(OwnFolder())))
+            return true;
+        for (const auto& added : AddedFolders())
+        {
+            if (Path::Equals(normalised, NormalisedFolder(added)))
+                return true;
+        }
+        return false;
+    }
+
+    bool AddFolder(const u8string& folder)
+    {
+        std::error_code ec;
+        if (folder.empty() || !fs::is_directory(fs::u8path(folder), ec) || IsGalleryFolder(folder))
+            return false;
+        auto folders = AddedFolders();
+        folders.push_back(NormalisedFolder(folder));
+        SetAddedFolders(folders);
+        return true;
+    }
+
+    bool RemoveFolder(const u8string& folder)
+    {
+        auto folders = AddedFolders();
+        const auto normalised = NormalisedFolder(folder);
+        auto it = std::find_if(folders.begin(), folders.end(), [&normalised](const u8string& added) {
+            return Path::Equals(NormalisedFolder(added), normalised);
+        });
+        if (it == folders.end())
+            return false;
+        folders.erase(it);
+        SetAddedFolders(folders);
+        return true;
+    }
+
+#pragma endregion
+
+#pragma region Renders
+
+    u8string PreviewRenderFolder()
+    {
+        auto& env = GetContext()->GetPlatformEnvironment();
+        return Path::Combine(env.GetDirectoryPath(DirBase::cache), u8"previews");
+    }
+
+    u8string PreviewRenderPath(const u8string& path, uint64_t size, time_t modified)
+    {
+        // FNV-1a over the render version, path, size and time; a new version redoes renders and failures
+        constexpr std::string_view kRenderVersion = "5|";
+        uint64_t hash = 0xcbf29ce484222325ull;
+        auto mix = [&hash](std::string_view text) {
+            for (auto c : text)
+            {
+                hash ^= static_cast<uint8_t>(c);
+                hash *= 0x100000001b3ull;
+            }
+        };
+        mix(kRenderVersion);
+        mix(path);
+        mix("|" + std::to_string(size) + "|" + std::to_string(static_cast<int64_t>(modified)));
+        char name[32];
+        std::snprintf(name, sizeof(name), "%016llx.png", static_cast<unsigned long long>(hash));
+        return Path::Combine(PreviewRenderFolder(), name);
+    }
+
+    // Runs a command and waits for it, its output discarded; true when it exits normally.
+    static bool RunHidden(const std::vector<u8string>& args)
+    {
+#ifdef _WIN32
+        // Quoted as the C runtime parses command lines
+        std::wstring commandLine;
+        for (const auto& arg : args)
+        {
+            if (!commandLine.empty())
+                commandLine += L' ';
+            auto wide = String::toWideChar(arg);
+            commandLine += L'"';
+            size_t backslashes = 0;
+            for (auto c : wide)
+            {
+                if (c == L'\\')
+                {
+                    backslashes++;
+                    continue;
+                }
+                commandLine.append(c == L'"' ? backslashes * 2 + 1 : backslashes, L'\\');
+                backslashes = 0;
+                commandLine += c;
+            }
+            commandLine.append(backslashes * 2, L'\\');
+            commandLine += L'"';
+        }
+
+        STARTUPINFOW startupInfo{};
+        startupInfo.cb = sizeof(startupInfo);
+        PROCESS_INFORMATION processInfo{};
+        if (!CreateProcessW(
+                nullptr, commandLine.data(), nullptr, nullptr, FALSE, CREATE_NO_WINDOW | IDLE_PRIORITY_CLASS, nullptr,
+                nullptr, &startupInfo, &processInfo))
+        {
+            return false;
+        }
+        WaitForSingleObject(processInfo.hProcess, INFINITE);
+        CloseHandle(processInfo.hThread);
+        CloseHandle(processInfo.hProcess);
+        return true;
+#else
+        std::vector<char*> argv;
+        for (const auto& arg : args)
+            argv.push_back(const_cast<char*>(arg.c_str()));
+        argv.push_back(nullptr);
+
+        pid_t pid = fork();
+        if (pid == 0)
+        {
+            int devNull = open("/dev/null", O_RDWR);
+            if (devNull >= 0)
+            {
+                dup2(devNull, STDIN_FILENO);
+                dup2(devNull, STDOUT_FILENO);
+                dup2(devNull, STDERR_FILENO);
+            }
+            if (nice(19) == -1)
+            {
+                // Normal priority then
+            }
+            execv(argv[0], argv.data());
+            _exit(127);
+        }
+        if (pid < 0)
+            return false;
+        int status = 0;
+        while (waitpid(pid, &status, 0) < 0)
+        {
+            if (errno != EINTR)
+                return false;
+        }
+        return WIFEXITED(status);
+#endif
+    }
+
+    bool RenderPreview(const u8string& parkPath, const u8string& renderPath)
+    {
+        Path::CreateDirectory(PreviewRenderFolder());
+        const auto partPath = renderPath + u8".part.png";
+        // Subcommands take no data path options, so the render uses the default user folder's settings
+        RunHidden({ Platform::GetCurrentExecutablePath(), "screenshot", parkPath, partPath, "preview",
+                    std::to_string(kRenderWidth), std::to_string(kRenderHeight) });
+        if (File::Exists(partPath) && File::Move(partPath, renderPath))
+            return true;
+
+        File::Delete(partPath);
+        File::WriteAllBytes(Path::WithExtension(renderPath, u8".none"), nullptr, 0);
+        return false;
+    }
+
+    bool PreviewRenderFailed(const u8string& renderPath)
+    {
+        return File::Exists(Path::WithExtension(renderPath, u8".none"));
+    }
+
+#pragma endregion
+
+#pragma region Index
+
+    static constexpr const char* kPattern = "*.park;*.sv6;*.sc6;*.sv4;*.sc4;*.zip";
+    static constexpr auto kRescanInterval = std::chrono::seconds(10);
+    static constexpr size_t kInfoBatch = 8;
+    static constexpr int32_t kIndexVersion = 1;
+
+    // What the index keeps of a file between sessions
+    struct Info
+    {
+        uint64_t size{};
+        int64_t modified{};
+        u8string name;
+        int32_t mapWidth{};
+        int32_t mapHeight{};
+        int32_t year{};
+        int32_t month{};
+        int32_t day{};
+    };
+
+    struct ScanResult
+    {
+        std::vector<FolderInfo> folders;
+        std::vector<Entry> entries;
+    };
+
+    struct ReadResult
+    {
+        u8string path;
+        Info info;
+    };
+
+    static std::vector<FolderInfo> _folders;
+    static std::vector<Entry> _entries;
+    static std::unordered_map<u8string, size_t> _byPath;
+    static std::unordered_map<u8string, Info> _known;
+    static bool _knownLoaded;
+    static bool _knownDirty;
+    static uint32_t _version = 1;
+    static bool _scanned;
+    static bool _rescanWanted;
+    static std::chrono::steady_clock::time_point _lastScan;
+    static BackgroundWorker::Job _scanJob;
+    static BackgroundWorker::Job _readJob;
+    static BackgroundWorker::Job _renderJob;
+    static std::vector<u8string> _renderQueue;
+
+    static u8string IndexPath()
+    {
+        auto& env = GetContext()->GetPlatformEnvironment();
+        return Path::Combine(env.GetDirectoryPath(DirBase::cache), u8"gallery-index.json");
+    }
+
+    static u8string LowerExtension(const u8string& path)
+    {
+        auto extension = Path::GetExtension(path);
+        if (!extension.empty() && extension[0] == '.')
+            extension.erase(0, 1);
+        std::transform(extension.begin(), extension.end(), extension.begin(), [](unsigned char c) {
+            return static_cast<char>(std::tolower(c));
+        });
+        return extension;
+    }
+
+    static bool CanRender(const Entry& entry)
+    {
+        return entry.kind != "zip";
+    }
+
+    // Only parks in the game's own format carry a name, map size and date that can be read quickly
+    static bool CanRead(const Entry& entry)
+    {
+        return entry.kind == "park";
+    }
+
+    static void LoadKnown()
+    {
+        if (_knownLoaded)
+            return;
+        _knownLoaded = true;
+        const auto path = IndexPath();
+        if (!File::Exists(path))
+            return;
+        try
+        {
+            auto root = Json::ReadFromFile(path);
+            if (Json::GetNumber<int32_t>(root["version"]) != kIndexVersion)
+                return;
+            for (auto item : Json::AsArray(root["files"]))
+            {
+                Info info;
+                info.size = Json::GetNumber<uint64_t>(item["size"]);
+                info.modified = Json::GetNumber<int64_t>(item["modified"]);
+                info.name = Json::GetString(item["name"]);
+                info.mapWidth = Json::GetNumber<int32_t>(item["mapWidth"]);
+                info.mapHeight = Json::GetNumber<int32_t>(item["mapHeight"]);
+                info.year = Json::GetNumber<int32_t>(item["year"]);
+                info.month = Json::GetNumber<int32_t>(item["month"]);
+                info.day = Json::GetNumber<int32_t>(item["day"]);
+                auto file = Json::GetString(item["path"]);
+                if (!file.empty())
+                    _known[file] = std::move(info);
+            }
+        }
+        catch (const std::exception& e)
+        {
+            LOG_WARNING("Park gallery: cannot read %s: %s", path.c_str(), e.what());
+        }
+    }
+
+    // Keeps what is known of the files still in the gallery
+    static void SaveKnown()
+    {
+        _knownDirty = false;
+        json_t files = json_t::array();
+        for (const auto& entry : _entries)
+        {
+            auto it = _known.find(entry.path);
+            if (it == _known.end())
+                continue;
+            const auto& info = it->second;
+            files.push_back({ { "path", entry.path },
+                              { "size", info.size },
+                              { "modified", info.modified },
+                              { "name", info.name },
+                              { "mapWidth", info.mapWidth },
+                              { "mapHeight", info.mapHeight },
+                              { "year", info.year },
+                              { "month", info.month },
+                              { "day", info.day } });
+        }
+        json_t root = { { "version", kIndexVersion }, { "files", std::move(files) } };
+        try
+        {
+            Path::CreateDirectory(Path::GetDirectory(IndexPath()));
+            Json::WriteToFile(IndexPath(), root, 0);
+        }
+        catch (const std::exception& e)
+        {
+            LOG_WARNING("Park gallery: cannot write %s: %s", IndexPath().c_str(), e.what());
+        }
+    }
+
+    static void SetPicture(Entry& entry)
+    {
+        if (!CanRender(entry))
+        {
+            entry.picture.clear();
+            entry.pictureState = PictureState::none;
+            return;
+        }
+        auto renderPath = PreviewRenderPath(entry.path, entry.size, static_cast<time_t>(entry.modified));
+        if (File::Exists(renderPath))
+        {
+            entry.picture = renderPath;
+            entry.pictureState = PictureState::ready;
+        }
+        else
+        {
+            entry.picture.clear();
+            entry.pictureState = PreviewRenderFailed(renderPath) ? PictureState::none : PictureState::pending;
+        }
+    }
+
+    // Lists every gallery folder (in the background): files, sizes, times and pictures
+    static ScanResult Scan(const u8string& own, const std::vector<u8string>& added)
+    {
+        ScanResult result;
+        Path::CreateDirectory(own);
+        std::vector<std::pair<u8string, bool>> folders{ { own, true } };
+        for (const auto& folder : added)
+            folders.emplace_back(folder, false);
+
+        std::unordered_set<u8string> seen;
+        for (const auto& [folder, isOwn] : folders)
+        {
+            FolderInfo info;
+            info.path = folder;
+            info.name = Path::GetFileName(folder);
+            info.own = isOwn;
+            auto scanner = Path::scanDirectory(Path::Combine(folder, kPattern), true);
+            while (scanner->next())
+            {
+                const auto& path = scanner->getPath();
+                if (!seen.insert(path).second)
+                    continue;
+                Entry entry;
+                entry.path = path;
+                entry.folder = folder;
+                entry.file = Path::GetFileName(path);
+                entry.kind = LowerExtension(path);
+                entry.name = Path::GetFileNameWithoutExtension(path);
+                entry.size = Platform::GetFileSize(path);
+                entry.modified = static_cast<int64_t>(Platform::FileGetModifiedTime(path));
+                entry.read = !CanRead(entry);
+                SetPicture(entry);
+                result.entries.push_back(std::move(entry));
+                info.count++;
+            }
+            result.folders.push_back(std::move(info));
+        }
+        return result;
+    }
+
+    // Reads a park's name, map size and date (in the background)
+    static Info ReadInfo(const u8string& path, uint64_t size, int64_t modified)
+    {
+        Info info;
+        info.size = size;
+        info.modified = modified;
+        try
+        {
+            auto stream = FileStream(path, FileMode::open);
+            ClassifiedFileInfo classified;
+            if (!TryClassifyFile(&stream, &classified) || classified.Type != ::FileType::park)
+                return info;
+
+            auto& objectRepository = GetContext()->GetObjectRepository();
+            auto importer = ParkImporter::CreateParkFile(objectRepository);
+            importer->LoadFromStream(&stream, false, true, path.c_str());
+            auto preview = importer->GetParkPreview();
+            auto mapSize = importer->GetMapSize();
+            info.name = preview.parkName;
+            info.year = preview.year;
+            info.month = preview.month;
+            info.day = preview.day;
+            info.mapWidth = mapSize.x;
+            info.mapHeight = mapSize.y;
+        }
+        catch (const std::exception& e)
+        {
+            LOG_WARNING("Park gallery: cannot read %s: %s", path.c_str(), e.what());
+        }
+        return info;
+    }
+
+    static void ApplyInfo(Entry& entry, const Info& info)
+    {
+        if (!info.name.empty())
+            entry.name = info.name;
+        entry.mapWidth = info.mapWidth;
+        entry.mapHeight = info.mapHeight;
+        entry.year = info.year;
+        entry.month = info.month;
+        entry.day = info.day;
+        entry.read = true;
+    }
+
+    static bool SameListing(const std::vector<Entry>& a, const std::vector<Entry>& b)
+    {
+        if (a.size() != b.size())
+            return false;
+        for (size_t i = 0; i < a.size(); i++)
+        {
+            if (a[i].path != b[i].path || a[i].size != b[i].size || a[i].modified != b[i].modified
+                || a[i].pictureState != b[i].pictureState || a[i].folder != b[i].folder)
+                return false;
+        }
+        return true;
+    }
+
+    static void TakeScan(ScanResult result)
+    {
+        _scanned = true;
+        _lastScan = std::chrono::steady_clock::now();
+
+        bool foldersChanged = result.folders.size() != _folders.size();
+        for (size_t i = 0; !foldersChanged && i < result.folders.size(); i++)
+        {
+            foldersChanged = result.folders[i].path != _folders[i].path || result.folders[i].count != _folders[i].count;
+        }
+
+        for (auto& entry : result.entries)
+        {
+            if (entry.read)
+                continue;
+            auto it = _known.find(entry.path);
+            if (it != _known.end() && it->second.size == entry.size && it->second.modified == entry.modified)
+                ApplyInfo(entry, it->second);
+        }
+
+        const bool changed = foldersChanged || !SameListing(result.entries, _entries);
+        _folders = std::move(result.folders);
+        _entries = std::move(result.entries);
+        _byPath.clear();
+        for (size_t i = 0; i < _entries.size(); i++)
+            _byPath[_entries[i].path] = i;
+        if (changed)
+        {
+            _version++;
+            _knownDirty = true;
+        }
+    }
+
+    static Entry* FindEntry(const u8string& path)
+    {
+        auto it = _byPath.find(path);
+        return it != _byPath.end() ? &_entries[it->second] : nullptr;
+    }
+
+    void Update()
+    {
+        LoadKnown();
+        auto& worker = GetContext()->GetBackgroundWorker();
+
+        const auto now = std::chrono::steady_clock::now();
+        if (!_scanJob.isValid() && (!_scanned || _rescanWanted || now - _lastScan >= kRescanInterval))
+        {
+            _rescanWanted = false;
+            _scanJob = worker.addJob(
+                [own = OwnFolder(), added = AddedFolders()]() { return Scan(own, added); },
+                [](ScanResult result) { TakeScan(std::move(result)); });
+        }
+
+        if (_scanned && !_readJob.isValid())
+        {
+            std::vector<std::tuple<u8string, uint64_t, int64_t>> batch;
+            for (const auto& entry : _entries)
+            {
+                if (!entry.read)
+                    batch.emplace_back(entry.path, entry.size, entry.modified);
+                if (batch.size() >= kInfoBatch)
+                    break;
+            }
+            if (!batch.empty())
+            {
+                _readJob = worker.addJob(
+                    [batch]() {
+                        std::vector<ReadResult> results;
+                        for (const auto& [path, size, modified] : batch)
+                            results.push_back({ path, ReadInfo(path, size, modified) });
+                        return results;
+                    },
+                    [](std::vector<ReadResult> results) {
+                        for (auto& result : results)
+                        {
+                            auto* entry = FindEntry(result.path);
+                            if (entry != nullptr && entry->size == result.info.size
+                                && entry->modified == result.info.modified)
+                                ApplyInfo(*entry, result.info);
+                            _known[result.path] = std::move(result.info);
+                        }
+                        _knownDirty = true;
+                        _version++;
+                    });
+            }
+            else if (_knownDirty)
+            {
+                SaveKnown();
+            }
+        }
+
+        while (!_renderJob.isValid() && !_renderQueue.empty())
+        {
+            auto path = _renderQueue.front();
+            _renderQueue.erase(_renderQueue.begin());
+            auto* entry = FindEntry(path);
+            if (entry == nullptr || entry->pictureState != PictureState::pending)
+                continue;
+            auto renderPath = PreviewRenderPath(entry->path, entry->size, static_cast<time_t>(entry->modified));
+            _renderJob = worker.addJob(
+                [path, renderPath]() { return RenderPreview(path, renderPath); },
+                [path](bool) {
+                    if (auto* rendered = FindEntry(path))
+                    {
+                        SetPicture(*rendered);
+                        if (rendered->pictureState == PictureState::pending)
+                            rendered->pictureState = PictureState::none;
+                    }
+                    _version++;
+                });
+        }
+    }
+
+    std::vector<FolderInfo> GetFolders()
+    {
+        Update();
+        return _folders;
+    }
