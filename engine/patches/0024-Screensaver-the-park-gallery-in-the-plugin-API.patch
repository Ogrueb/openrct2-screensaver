+    std::vector<Entry> GetEntries()
+    {
+        Update();
+        return _entries;
+    }
+
+    uint32_t GetVersion()
+    {
+        Update();
+        return _version;
+    }
+
+    void Refresh()
+    {
+        _rescanWanted = true;
+    }
+
+    void RequestPictures(const std::vector<u8string>& paths)
+    {
+        _renderQueue.clear();
+        std::unordered_set<u8string> queued;
+        for (const auto& path : paths)
+        {
+            auto* entry = FindEntry(path);
+            if (entry != nullptr && entry->pictureState == PictureState::pending && queued.insert(path).second)
+                _renderQueue.push_back(path);
+        }
+        Update();
+    }
