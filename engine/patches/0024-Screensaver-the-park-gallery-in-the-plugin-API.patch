+        }
+        auto folder = Path::Combine(ScreensaverFolder(), "playlists");
+        std::error_code ec;
+        fs::create_directories(fs::u8path(folder), ec);
+        Ui::FileDialogDesc desc;
+        desc.Type = Ui::FileDialogType::save;
+        desc.Title = "New playlist: name it";
+        desc.InitialDirectory = folder;
+        desc.DefaultFilename = Path::Combine(folder, "New playlist.toml");
+        desc.Filters.emplace_back("Playlist", "*.toml");
+        u8string path;
+        try
+        {
+            path = ShowDialog(desc);
+        }
+        catch (const std::exception& e)
+        {
+            error = std::string("No file dialog: ") + e.what();
+            return false;
+        }
+        if (path.empty())
+        {
+            cancelled = true;
+            return false;
+        }
+        auto list = WriteParkList(paths, error);
+        if (list.empty())
+            return false;
+        return StartTask(
+            "new", "", { "--live-new-parks", list, "--to", path, "--openrct2", ConverterPath() }, error);
