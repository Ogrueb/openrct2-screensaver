+
+// The park gallery: the gallery folder in the user directory and the folders the user added to it
+// (config.ini file_browser_gallery_folders), their preview renders, and an index of their parks.
+//
+// Preview renders: each park is rendered once, framed on the area it is built on, by running this
+// executable's "screenshot <file> <image> preview" command in the background. The pictures are kept in
+// the cache folder under a name made from the file's path, size and modification time, so a park that
+// changes is rendered again; a file that cannot be rendered leaves an empty ".none" file.
+//
+// The index lists every park in the gallery folders (subfolders included) with its name, map size and
+// date, read in the background and kept in the cache folder (gallery-index.json), so only new and
+// changed files are read again. Its functions are for the main thread; they start the background work
+// themselves, so a caller that asks regularly (each frame or tick) keeps it going.
+
+#pragma once
+
+#include <openrct2/core/StringTypes.h>
+
+#include <cstdint>
+#include <ctime>
+#include <vector>
+
+namespace OpenRCT2::Ui::Gallery
+{
+    // Folders
+
+    u8string OwnFolder();
+    std::vector<u8string> AddedFolders();
+    void SetAddedFolders(const std::vector<u8string>& folders);
+    u8string NormalisedFolder(const u8string& folder);
+    bool IsGalleryFolder(const u8string& folder);
+
+    // Adds a folder to the gallery; false when it is one already or is not a folder.
+    bool AddFolder(const u8string& folder);
+    // Removes an added folder; false when it is not one.
+    bool RemoveFolder(const u8string& folder);
+
+    // Renders
+
+    constexpr int32_t kRenderWidth = 250;
+    constexpr int32_t kRenderHeight = kRenderWidth / 5 * 4;
+
+    u8string PreviewRenderFolder();
+    u8string PreviewRenderPath(const u8string& path, uint64_t size, time_t modified);
+    // Renders a park's preview into the cache (blocking, for a background thread); true when the picture
+    // is there afterwards.
+    bool RenderPreview(const u8string& parkPath, const u8string& renderPath);
+    bool PreviewRenderFailed(const u8string& renderPath);
+
+    // Index
+
+    enum class PictureState : uint8_t
+    {
+        ready,   // `picture` is a PNG in the render cache
+        pending, // not rendered yet
+        none,    // cannot be rendered (a download, or the render failed)
+    };
+
+    struct FolderInfo
+    {
+        u8string path;
+        u8string name;
+        uint32_t count{}; // parks in it and its subfolders
+        bool own{};       // the user directory's gallery folder (cannot be removed)
+    };
+
+    struct Entry
+    {
+        u8string path;
+        u8string folder; // the gallery folder it was found under
+        u8string name;   // the park's saved name, else the file name without its extension
+        u8string file;   // the file name
+        u8string kind;   // the extension without its dot, lower case: "park", "sv6", "zip"...
+        int32_t mapWidth{};
+        int32_t mapHeight{};
+        int32_t year{}; // the park's own date (0 when unknown)
+        int32_t month{};
+        int32_t day{};
+        int64_t modified{}; // seconds since 1970
+        uint64_t size{};
+        bool read{}; // name, map size and date have been read from the file
+        u8string picture;
+        PictureState pictureState{ PictureState::pending };
+    };
+
+    std::vector<FolderInfo> GetFolders();
+    std::vector<Entry> GetEntries();
+
+    // Bumps whenever folders, entries or a picture change.
+    uint32_t GetVersion();
+
+    // Lists the folders again (it also happens by itself every few seconds while the index is asked for).
+    void Refresh();
+
+    // Renders the pictures of these parks, one at a time in the background; a new call replaces the
+    // parks still waiting.
+    void RequestPictures(const std::vector<u8string>& paths);
+
+    // Whether the file is a park in the gallery's index.
+    bool Contains(const u8string& path);
+
+    // Keeps the background work going; the other index functions call it too.
+    void Update();
+} // namespace OpenRCT2::Ui::Gallery
