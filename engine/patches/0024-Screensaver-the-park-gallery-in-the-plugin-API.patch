+    bool NewPlaylistFrom(const std::vector<u8string>& paths, bool& cancelled, std::string& error)
+    {
+        cancelled = false;
+        if (!CanStartTask(error))
+            return false;
+        // Checked before the dialog, written after it
+        for (const auto& path : paths)
+        {
+            if (!Gallery::Contains(path))
+            {
+                error = "Not a park in the gallery: " + path;
+                return false;
