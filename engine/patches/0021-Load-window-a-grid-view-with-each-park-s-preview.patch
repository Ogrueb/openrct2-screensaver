     static constexpr uint16_t kDateTimeGap = 2;
 
+    // Grid view: each file is a tile with a reduced copy of its preview image and its name below.
+    static constexpr int32_t kThumbnailWidth = kPreviewWidthScreenshot / 2;
+    static constexpr int32_t kThumbnailHeight = kThumbnailWidth / 5 * 4;
+    static constexpr int32_t kTileGap = 6;
+    static constexpr int32_t kTileWidth = kThumbnailWidth + 2 + kTileGap;
+    static constexpr int32_t kTileHeight = kThumbnailHeight + 2 + kListRowHeight + kTileGap;
+    static constexpr size_t kMaxThumbnails = 512;
+
+    struct Thumbnail
+    {
+        bool hasImage{};
+        uint8_t width{};
+        uint8_t height{};
+        std::vector<PaletteIndex> pixels;
+        ImageIndex imageId{ kImageIndexUndefined };
+        uint32_t lastUsed{};
+    };
+
+    // Thumbnails stay for the session, keyed by path and modification time; their image slots
+    // are allocated while a window shows them and freed when it closes.
+    static std::unordered_map<u8string, Thumbnail> _thumbnails;
+    static uint32_t _thumbnailClock;
+
+    static u8string ThumbnailKey(const LoadSaveListItem& item)
+    {
+        return item.path + "|" + std::to_string(static_cast<int64_t>(item.dateModified));
+    }
+
+    static ParkPreview ReadParkPreview(const u8string& path)
+    {
+        try
+        {
+            auto fs = FileStream(path, FileMode::open);
+
+            ClassifiedFileInfo info;
+            if (!TryClassifyFile(&fs, &info) || info.Type != ::FileType::park)
+                return ParkPreview{};
+
+            auto& objectRepository = GetContext()->GetObjectRepository();
+            auto parkImporter = ParkImporter::CreateParkFile(objectRepository);
+            parkImporter->LoadFromStream(&fs, false, true, path.c_str());
+            return parkImporter->GetParkPreview();
+        }
+        catch (const std::exception& e)
+        {
+            LOG_ERROR("Could not get preview:", e.what());
+            return ParkPreview{};
+        }
+    }
+
+    // The preview image of the kind the preview setting asks for (else the other kind), reduced by
+    // whole steps to fit a tile: palette images can only be sampled, not blended.
+    static Thumbnail MakeThumbnail(const ParkPreview& preview)
+    {
+        const auto wanted = Config::Get().general.fileBrowserPreviewType == ParkPreviewPref::miniMap
+            ? PreviewImageType::miniMap
+            : PreviewImageType::screenshot;
+        const PreviewImage* image = nullptr;
+        for (const auto& candidate : preview.images)
+        {
+            if (candidate.type == wanted || (image == nullptr && candidate.type != PreviewImageType::logo))
+                image = &candidate;
+        }
+
+        Thumbnail thumbnail;
+        if (image == nullptr || image->width == 0 || image->height == 0)
+            return thumbnail;
+
+        const int32_t stepX = (image->width + kThumbnailWidth - 1) / kThumbnailWidth;
+        const int32_t stepY = (image->height + kThumbnailHeight - 1) / kThumbnailHeight;
+        const int32_t step = std::max({ 1, stepX, stepY });
+        thumbnail.width = static_cast<uint8_t>(image->width / step);
+        thumbnail.height = static_cast<uint8_t>(image->height / step);
+        thumbnail.pixels.resize(thumbnail.width * thumbnail.height);
+        for (int32_t y = 0; y < thumbnail.height; y++)
+        {
+            for (int32_t x = 0; x < thumbnail.width; x++)
+            {
+                thumbnail.pixels[y * thumbnail.width + x] = image->pixels[(y * step) * image->width + x * step];
+            }
+        }
+        thumbnail.hasImage = true;
+        return thumbnail;
+    }
+
+    static void FreeThumbnailImages()
+    {
+        for (auto& [key, thumbnail] : _thumbnails)
+        {
+            if (thumbnail.imageId != kImageIndexUndefined)
+            {
+                GfxObjectFreeImages(thumbnail.imageId, 1);
+                thumbnail.imageId = kImageIndexUndefined;
+            }
+        }
+    }
+
+    // Drops the least recently drawn thumbnails once there are too many.
+    static void TrimThumbnails()
+    {
+        if (_thumbnails.size() < kMaxThumbnails)
+            return;
+
+        std::vector<std::pair<uint32_t, u8string>> byAge;
+        byAge.reserve(_thumbnails.size());
+        for (const auto& [key, thumbnail] : _thumbnails)
+            byAge.emplace_back(thumbnail.lastUsed, key);
+        std::sort(byAge.begin(), byAge.end());
+        for (size_t i = 0; i < byAge.size() / 4; i++)
+        {
+            auto it = _thumbnails.find(byAge[i].second);
+            if (it->second.imageId != kImageIndexUndefined)
+                GfxObjectFreeImages(it->second.imageId, 1);
+            _thumbnails.erase(it);
+        }
+    }
