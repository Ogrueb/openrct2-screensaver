+        bool CanShowGrid() const
+        {
+            return type != LoadSaveType::track && type != LoadSaveType::heightmap;
+        }
+
+        bool IsGridView() const
+        {
+            return Config::Get().general.fileBrowserGridView && CanShowGrid();
+        }
+
+        int32_t GetGridColumns() const
+        {
+            return std::max(1, (widgets[WIDX_SCROLL].width() - 1 - kScrollBarWidth) / kTileWidth);
+        }
+
+        // The list item under a point in the scroll area, or -1.
+        int32_t GetItemAt(const ScreenCoordsXY& screenCoords) const
+        {
+            if (!IsGridView())
+            {
+                int32_t item = screenCoords.y / kScrollableRowHeight;
+                return item < numListItems ? item : -1;
+            }
+
+            const int32_t columns = GetGridColumns();
+            const int32_t column = screenCoords.x / kTileWidth;
+            if (screenCoords.x < 0 || screenCoords.y < 0 || column >= columns)
+                return -1;
+            int32_t item = (screenCoords.y / kTileHeight) * columns + column;
+            return item < numListItems ? item : -1;
+        }
+
+        // The thumbnail of a file, or nullptr while it is not read yet (it is then asked for).
+        Thumbnail* GetThumbnail(const LoadSaveListItem& item)
+        {
+            auto key = ThumbnailKey(item);
+            auto it = _thumbnails.find(key);
+            if (it == _thumbnails.end())
+            {
+                if (_thumbnailsWanted.size() < 64)
+                    _thumbnailsWanted.emplace_back(key, item.path);
+                return nullptr;
+            }
+
+            auto& thumbnail = it->second;
+            thumbnail.lastUsed = _thumbnailClock;
+            if (thumbnail.hasImage && thumbnail.imageId == kImageIndexUndefined)
+            {
+                G1Element g1{};
+                g1.offset = reinterpret_cast<uint8_t*>(thumbnail.pixels.data());
+                g1.width = thumbnail.width;
+                g1.height = thumbnail.height;
+                thumbnail.imageId = GfxObjectAllocateImages(&g1, 1);
+            }
+            return &thumbnail;
+        }
+
+        // Reads one wanted thumbnail at a time in the background, the first tile drawn first.
+        void LoadNextThumbnail()
+        {
+            if (_thumbnailLoadJob.isValid() || _thumbnailsWanted.empty())
+                return;
+
+            auto [key, path] = _thumbnailsWanted.front();
+            _thumbnailsWanted.clear();
+            if (_thumbnails.contains(key))
+            {
+                invalidate();
+                return;
+            }
+
+            auto& bgWorker = GetContext()->GetBackgroundWorker();
+            _thumbnailLoadJob = bgWorker.addJob(
+                [path]() { return MakeThumbnail(ReadParkPreview(path)); },
+                [key](Thumbnail thumbnail) {
+                    TrimThumbnails();
+                    thumbnail.lastUsed = _thumbnailClock;
+                    _thumbnails[key] = std::move(thumbnail);
+
+                    auto* windowMgr = GetContext()->GetUiContext().GetWindowManager();
+                    if (auto* wnd = windowMgr->FindByClass(WindowClass::loadsave); wnd != nullptr)
+                        wnd->invalidate();
+                });
+        }
+
+        void DrawGrid(RenderTarget& rt)
+        {
+            _thumbnailClock++;
+            _thumbnailsWanted.clear();
+
+            const int32_t columns = GetGridColumns();
+            for (int32_t i = 0; i < numListItems; i++)
+            {
+                const ScreenCoordsXY tilePos{ (i % columns) * kTileWidth, (i / columns) * kTileHeight };
+                if (tilePos.y > rt.y + rt.height)
+                    break;
+                if (tilePos.y + kTileHeight < rt.y)
+                    continue;
+
+                const auto& item = _listItems[i];
+                const ScreenCoordsXY frameStart = tilePos + ScreenCoordsXY{ kTileGap / 2, kTileGap / 2 };
+                const ScreenCoordsXY frameEnd = frameStart + ScreenCoordsXY{ kThumbnailWidth + 1, kThumbnailHeight + 1 };
+
+                if (i == selectedListItem)
+                {
+                    Rectangle::filter(
+                        rt, { tilePos, tilePos + ScreenCoordsXY{ kTileWidth - 1, kTileHeight - 1 } },
+                        FilterPaletteID::paletteDarken1);
+                }
+
+                Rectangle::fillInset(
+                    rt, { frameStart, frameEnd }, colours[1], Rectangle::BorderStyle::inset, Rectangle::FillBrightness::dark,
+                    Rectangle::FillMode::dontLightenWhenInset);
+
+                const ScreenCoordsXY imageArea = frameStart + ScreenCoordsXY{ 1, 1 };
+                if (item.type == FileType::directory)
+                {
+                    GfxDrawSprite(
+                        rt, ImageId(SPR_G2_FOLDER), imageArea + ScreenCoordsXY{ kThumbnailWidth / 2 - 6, kThumbnailHeight / 2 - 6 });
+                }
+                else if (const auto* thumbnail = GetThumbnail(item); thumbnail != nullptr && thumbnail->hasImage)
+                {
+                    if (thumbnail->imageId != kImageIndexUndefined)
+                    {
+                        const ScreenCoordsXY offset{ (kThumbnailWidth - thumbnail->width) / 2,
+                                                     (kThumbnailHeight - thumbnail->height) / 2 };
+                        GfxDrawSprite(rt, ImageId(thumbnail->imageId), imageArea + offset);
+                    }
+                }
+                else
+                {
+                    auto text = thumbnail == nullptr ? LanguageGetString(STR_LOADING_GENERIC)
+                                                     : LanguageGetString(STR_NO_PREVIEW_AVAILABLE);
+                    auto ft = Formatter();
+                    ft.Add<const char*>(text);
+                    drawTextEllipsised(
+                        rt, imageArea + ScreenCoordsXY{ kThumbnailWidth / 2, kThumbnailHeight / 2 - 6 }, kThumbnailWidth - 4,
+                        STR_STRING, ft,
+                        { ColourWithFlags{ Drawing::Colour::white }.withFlag(ColourFlag::withOutline, true),
+                          TextAlignment::centre });
+                }
+
+                // A marker before the name of the file that is loaded now
+                StringId stringId = i == selectedListItem ? STR_WINDOW_COLOUR_2_STRINGID : STR_BLACK_STRING;
+                auto name = item.loaded ? "» " + item.name : item.name;
+                auto ft = Formatter();
+                ft.Add<StringId>(STR_STRING);
+                ft.Add<const char*>(name.c_str());
+                drawTextEllipsised(
+                    rt, { frameStart.x + (kThumbnailWidth + 2) / 2, frameEnd.y + 2 }, kThumbnailWidth + 2, stringId, ft,
+                    { TextAlignment::centre });
+            }
+        }
