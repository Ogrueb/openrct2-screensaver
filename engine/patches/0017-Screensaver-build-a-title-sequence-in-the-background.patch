+        // build(sequence) starts the registered generator for that title sequence in the background;
+        // throws with the reason when it cannot start.
+        static JSValue build(JSContext* ctx, JSValue, int argc, JSValue* argv)
+        {
+            if (argc < 1 || !JS_IsString(argv[0]))
+            {
+                JS_ThrowTypeError(ctx, "build(sequence): sequence must be a string");
+                return JS_EXCEPTION;
+            }
+            std::string error;
+            if (!Ui::Screensaver::Build::Start(JSToStdString(ctx, argv[0]), error))
+            {
+                JS_ThrowPlainError(ctx, "%s", error.c_str());
+                return JS_EXCEPTION;
+            }
+            return JS_UNDEFINED;
+        }
+
+        // { state: "idle" | "running" | "done" | "failed" | "cancelled", sequence, exitCode, started,
+        //   finished (ms since 1970), error }
+        static JSValue buildStatus_get(JSContext* ctx, JSValue)
+        {
+            auto status = Ui::Screensaver::Build::GetStatus();
+            JSValue obj = JS_NewObject(ctx);
+            JS_SetPropertyStr(ctx, obj, "state", JSFromStdString(ctx, Ui::Screensaver::Build::StateName(status.state)));
+            JS_SetPropertyStr(ctx, obj, "sequence", JSFromStdString(ctx, status.sequence));
+            JS_SetPropertyStr(ctx, obj, "exitCode", JS_NewInt32(ctx, status.exitCode));
+            JS_SetPropertyStr(ctx, obj, "started", JS_NewFloat64(ctx, static_cast<double>(status.started)));
+            JS_SetPropertyStr(ctx, obj, "finished", JS_NewFloat64(ctx, static_cast<double>(status.finished)));
+            JS_SetPropertyStr(ctx, obj, "error", JSFromStdString(ctx, status.error));
+            return obj;
+        }
