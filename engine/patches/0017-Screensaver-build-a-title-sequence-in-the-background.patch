+/*****************************************************************************
+ * Copyright (c) 2014-2026 OpenRCT2 developers
+ *
+ * For a complete list of all authors, please refer to contributors.md
+ * Interested in contributing? Visit https://github.com/OpenRCT2/OpenRCT2
+ *
+ * OpenRCT2 is licensed under the GNU General Public License version 3.
+ *****************************************************************************/
+
+// Building a title sequence with an external generator while the game runs, and taking the result
+// into the title sequence that plays.
+//
+// The generator is named in <user directory>/screensaver/generator.json ({"python": ..., "script":
+// ...}), which only the generator's own installer writes: a plugin passes just the sequence's name
+// and cannot choose what runs. The build runs in the background with no console window, its output
+// in <user directory>/screensaver/build.log; it writes the new sequence to
+// <user directory>/screensaver/build/live/<name> and never touches the installed one. Apply() then
+// copies that into the installed sequence folder and reloads the playing sequence's script, at a
+// moment the plugin chooses (no park is being read then).
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+namespace OpenRCT2::Ui::Screensaver::Build
+{
+    enum class State : uint8_t
+    {
+        idle,
+        running,
+        done,      // the generator exited with code 0
+        failed,    // it could not start, or exited with another code
+        cancelled, // Cancel() stopped it
+    };
+
+    struct Status
+    {
+        State state = State::idle;
+        std::string sequence;
+        int32_t exitCode = 0;
+        int64_t started = 0;  // ms since 1970
+        int64_t finished = 0; // ms since 1970
+        std::string error;
+    };
+
+    const char* StateName(State state);
+
+    // Starts the generator for the title sequence of that name. False (with the reason in `error`)
+    // when no generator is registered, the name is not acceptable or a build is running already.
+    bool Start(const std::string& sequence, std::string& error);
+
+    Status GetStatus();
+
+    // Stops a running build; false when none runs.
+    bool Cancel();
+
+    // Copies the built sequence of that name into the installed title sequence of the same name,
+    // which must be the one playing and a folder, and reloads its script; the park on screen keeps
+    // playing until the next seek. False with the reason in `error`.
+    bool Apply(const std::string& sequence, std::string& error);
+} // namespace OpenRCT2::Ui::Screensaver::Build
