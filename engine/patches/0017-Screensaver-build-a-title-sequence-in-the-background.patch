+
+#ifdef _WIN32
+// clang-format off
+    // windows.h needs to be included first
+    #ifndef WIN32_LEAN_AND_MEAN
+        #define WIN32_LEAN_AND_MEAN
+    #endif
+    #ifndef NOMINMAX
+        #define NOMINMAX
+    #endif
+    #include <windows.h>
+// clang-format on
+#else
+    #include <cerrno>
+    #include <csignal>
+    #include <cstdlib>
+    #include <fcntl.h>
+    #include <sys/types.h>
+    #include <sys/wait.h>
+    #include <unistd.h>
+#endif
+
+#include "Build.h"
+
+#include <openrct2/Context.h>
+#include <openrct2/Diagnostic.h>
+#include <openrct2/OpenRCT2.h>
+#include <openrct2/PlatformEnvironment.h>
+#include <openrct2/core/File.h>
+#include <openrct2/core/FileSystem.hpp>
+#include <openrct2/core/Json.hpp>
+#include <openrct2/core/Path.hpp>
+#include <openrct2/core/String.hpp>
+#include <openrct2/scenes/title/TitleScene.h>
+#include <openrct2/scenes/title/TitleSequenceManager.h>
+#include <openrct2/scenes/title/TitleSequencePlayer.h>
+
+#include <chrono>
+#include <mutex>
+#include <optional>
+#include <set>
+#include <thread>
+#include <vector>
+
+namespace OpenRCT2::Ui::Screensaver::Build
+{
+    namespace
+    {
+        // Shared with the thread that waits for the generator. Never destroyed: the thread may still
+        // be waiting when the game exits (the generator then finishes on its own; it only ever
+        // writes its own build folder).
+        struct Shared
+        {
+            std::mutex mutex;
+            Status status;
+#ifdef _WIN32
+            HANDLE process = nullptr;
+#else
+            pid_t pid = 0;
+#endif
+            bool cancelled = false;
+        };
+
+        Shared& GetShared()
+        {
+            static auto* shared = new Shared();
+            return *shared;
+        }
+
+        int64_t Now()
+        {
+            return std::chrono::duration_cast<std::chrono::milliseconds>(
+                       std::chrono::system_clock::now().time_since_epoch())
+                .count();
+        }
+
+        u8string ScreensaverFolder()
+        {
+            auto user = GetContext()->GetPlatformEnvironment().GetDirectoryPath(DirBase::user);
+            return Path::Combine(user, "screensaver");
+        }
+
+        // A sequence name as the generator writes it: a playlist's name, used as a folder name.
+        bool IsSequenceName(const std::string& name)
+        {
+            if (name.empty() || name.size() > 128 || name == "." || name == ".." || name[0] == '-')
+                return false;
+            for (unsigned char c : name)
+            {
+                if (c < 0x20 || c == 0x7F || c == '/' || c == '\\' || c == '"' || c == ':' || c == '*' || c == '?'
+                    || c == '<' || c == '>' || c == '|')
+                    return false;
+            }
+            return true;
+        }
+
+        struct Generator
+        {
+            std::string python;
+            std::string script;
+        };
+
+        // The generator registered by its installer, or nullopt with the reason.
+        std::optional<Generator> ReadGenerator(std::string& error)
+        {
+            auto path = Path::Combine(ScreensaverFolder(), "generator.json");
+            std::error_code ec;
+            if (!fs::is_regular_file(fs::u8path(path), ec))
+            {
+                error = "No generator registered (" + path + "): install the playlist once with mksequence.py --install";
+                return std::nullopt;
+            }
+            Generator generator;
+            try
+            {
+                auto json = Json::ReadFromFile(path, 64 * 1024);
+                if (!json.is_object() || !json["python"].is_string() || !json["script"].is_string())
+                {
+                    error = path + " names no python and script";
+                    return std::nullopt;
+                }
+                generator.python = json["python"].get<std::string>();
+                generator.script = json["script"].get<std::string>();
+            }
+            catch (const std::exception& e)
+            {
+                error = path + ": " + e.what();
+                return std::nullopt;
+            }
+            auto python = fs::u8path(generator.python);
+            auto script = fs::u8path(generator.script);
+            // Not is_regular_file: the Microsoft Store's python.exe is an app execution alias.
+            if (!python.is_absolute() || !fs::exists(python, ec) || fs::is_directory(python, ec))
+            {
+                error = "Python not found: " + generator.python;
+                return std::nullopt;
+            }
+            if (!script.is_absolute() || !fs::is_regular_file(script, ec) || script.filename() != fs::u8path("mksequence.py"))
+            {
+                error = "Generator not found: " + generator.script;
+                return std::nullopt;
+            }
+            return generator;
+        }
+
+        void Finish(int32_t exitCode, const std::string& error)
+        {
+            auto& shared = GetShared();
+            std::lock_guard lock(shared.mutex);
+            shared.status.exitCode = exitCode;
+            shared.status.finished = Now();
+            shared.status.error = error;
+            shared.status.state = shared.cancelled ? State::cancelled : exitCode == 0 ? State::done : State::failed;
+#ifdef _WIN32
+            if (shared.process != nullptr)
+            {
+                CloseHandle(shared.process);
+                shared.process = nullptr;
+            }
+#else
+            shared.pid = 0;
+#endif
+            LOG_INFO("Screensaver build of \"%s\": %s (exit code %d)", shared.status.sequence.c_str(),
+                StateName(shared.status.state), exitCode);
+        }
+
+#ifdef _WIN32
+        // One argument as CommandLineToArgvW reads it back.
+        std::wstring Quote(const std::wstring& arg)
+        {
+            std::wstring out = L"\"";
+            size_t backslashes = 0;
+            for (wchar_t c : arg)
+            {
+                if (c == L'\\')
+                {
+                    backslashes++;
+                    continue;
+                }
+                if (c == L'"')
+                    out.append(backslashes * 2 + 1, L'\\');
+                else
+                    out.append(backslashes, L'\\');
+                backslashes = 0;
+                out.push_back(c);
+            }
+            out.append(backslashes * 2, L'\\');
+            out.push_back(L'"');
+            return out;
+        }
+
+        bool Launch(const std::vector<std::string>& args, const std::string& cwd, const std::string& log, std::string& error)
+        {
+            std::wstring commandLine;
+            for (const auto& arg : args)
+            {
+                if (!commandLine.empty())
+                    commandLine.push_back(L' ');
+                commandLine += Quote(String::toWideChar(arg));
+            }
+            SECURITY_ATTRIBUTES sa{ static_cast<DWORD>(sizeof(SECURITY_ATTRIBUTES)), nullptr, TRUE };
+            auto wlog = String::toWideChar(log);
+            HANDLE output = CreateFileW(
+                wlog.c_str(), GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_DELETE, &sa, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL,
+                nullptr);
+            if (output == INVALID_HANDLE_VALUE)
+            {
+                error = "Cannot write " + log;
+                return false;
+            }
+            HANDLE input = CreateFileW(L"NUL", GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, &sa, OPEN_EXISTING, 0, nullptr);
+            STARTUPINFOW si{};
+            si.cb = sizeof(si);
+            si.dwFlags = STARTF_USESTDHANDLES;
+            si.hStdInput = input;
+            si.hStdOutput = output;
+            si.hStdError = output;
+            PROCESS_INFORMATION pi{};
+            // UTF-8 output whatever the console code page (park names), and no console window.
+            SetEnvironmentVariableW(L"PYTHONUTF8", L"1");
+            SetEnvironmentVariableW(L"PYTHONIOENCODING", L"utf-8");
+            auto app = String::toWideChar(args[0]);
+            auto wcwd = String::toWideChar(cwd);
+            BOOL ok = CreateProcessW(
+                app.c_str(), commandLine.data(), nullptr, nullptr, TRUE, CREATE_NO_WINDOW | BELOW_NORMAL_PRIORITY_CLASS,
+                nullptr, wcwd.c_str(), &si, &pi);
+            CloseHandle(output);
+            if (input != INVALID_HANDLE_VALUE)
+                CloseHandle(input);
+            if (!ok)
+            {
+                error = "Cannot start " + args[0] + " (error " + std::to_string(GetLastError()) + ")";
+                return false;
+            }
+            CloseHandle(pi.hThread);
+            {
+                auto& shared = GetShared();
+                std::lock_guard lock(shared.mutex);
+                shared.process = pi.hProcess;
+            }
+            std::thread([process = pi.hProcess]() {
+                WaitForSingleObject(process, INFINITE);
+                DWORD code = 1;
+                GetExitCodeProcess(process, &code);
+                Finish(static_cast<int32_t>(code), code == 0 ? "" : "The generator failed (exit code " + std::to_string(code) + ")");
+            }).detach();
+            return true;
+        }
+#else
+        bool Launch(const std::vector<std::string>& args, const std::string& cwd, const std::string& log, std::string& error)
+        {
+            // Everything the child needs is prepared before fork: it only calls async-signal-safe functions.
+            std::vector<char*> argv;
+            for (const auto& arg : args)
+                argv.push_back(const_cast<char*>(arg.c_str()));
+            argv.push_back(nullptr);
+            int output = open(log.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+            if (output < 0)
+            {
+                error = "Cannot write " + log;
+                return false;
+            }
+            int input = open("/dev/null", O_RDONLY | O_CLOEXEC);
+            setenv("PYTHONUTF8", "1", 1);
+            setenv("PYTHONIOENCODING", "utf-8", 1);
+            pid_t pid = fork();
+            if (pid == 0)
+            {
+                setpgid(0, 0); // its own group: Cancel() stops anything it starts too
+                if (input >= 0)
+                    dup2(input, STDIN_FILENO);
+                dup2(output, STDOUT_FILENO);
+                dup2(output, STDERR_FILENO);
+                if (chdir(cwd.c_str()) != 0)
+                    _exit(126);
+                execv(argv[0], argv.data());
+                _exit(127);
+            }
+            close(output);
+            if (input >= 0)
+                close(input);
+            if (pid < 0)
+            {
+                error = "Cannot start " + args[0];
+                return false;
+            }
+            {
+                auto& shared = GetShared();
+                std::lock_guard lock(shared.mutex);
+                shared.pid = pid;
+            }
+            std::thread([pid]() {
+                int status = 0;
+                while (waitpid(pid, &status, 0) < 0 && errno == EINTR)
+                {
+                }
+                int32_t code = WIFEXITED(status) ? WEXITSTATUS(status) : 128 + (WIFSIGNALED(status) ? WTERMSIG(status) : 0);
+                Finish(code, code == 0 ? "" : "The generator failed (exit code " + std::to_string(code) + ")");
+            }).detach();
+            return true;
+        }
+#endif
+    } // namespace
+
+    const char* StateName(State state)
+    {
+        switch (state)
+        {
+            case State::running:
+                return "running";
+            case State::done:
+                return "done";
+            case State::failed:
+                return "failed";
+            case State::cancelled:
+                return "cancelled";
+            default:
+                return "idle";
+        }
+    }
+
+    bool Start(const std::string& sequence, std::string& error)
+    {
+        if (!IsSequenceName(sequence))
+        {
+            error = "Not a title sequence name: " + sequence;
+            return false;
+        }
+        auto& shared = GetShared();
+        {
+            std::lock_guard lock(shared.mutex);
+            if (shared.status.state == State::running)
+            {
+                error = "A build is running already (" + shared.status.sequence + ")";
+                return false;
+            }
+        }
+        auto generator = ReadGenerator(error);
+        if (!generator)
+            return false;
+        auto folder = ScreensaverFolder();
+        std::error_code ec;
+        fs::create_directories(fs::u8path(folder), ec);
+        auto user = GetContext()->GetPlatformEnvironment().GetDirectoryPath(DirBase::user);
+        // The repository's root: the generator's folder's parent (tools/mksequence.py).
+        auto cwd = fs::u8path(generator->script).parent_path().parent_path().u8string();
+        std::vector<std::string> args = {
+            generator->python, generator->script, "--live-build", sequence, "--user-dir", user,
+        };
+        {
+            std::lock_guard lock(shared.mutex);
+            shared.status = Status{ State::running, sequence, 0, Now(), 0, "" };
+            shared.cancelled = false;
+        }
+        if (!Launch(args, std::string(cwd.begin(), cwd.end()), Path::Combine(folder, "build.log"), error))
+        {
+            std::lock_guard lock(shared.mutex);
+            shared.status.state = State::failed;
+            shared.status.finished = Now();
+            shared.status.error = error;
+            return false;
+        }
+        LOG_INFO("Screensaver build of \"%s\" started", sequence.c_str());
+        return true;
+    }
+
+    Status GetStatus()
+    {
+        auto& shared = GetShared();
+        std::lock_guard lock(shared.mutex);
+        return shared.status;
+    }
+
+    bool Cancel()
+    {
+        auto& shared = GetShared();
+        std::lock_guard lock(shared.mutex);
+        if (shared.status.state != State::running)
+            return false;
+        shared.cancelled = true;
+#ifdef _WIN32
+        if (shared.process != nullptr)
+            TerminateProcess(shared.process, 1);
+#else
+        if (shared.pid > 0)
+            kill(-shared.pid, SIGTERM);
+#endif
+        return true;
+    }
+
+    bool Apply(const std::string& sequence, std::string& error)
+    {
+        if (!IsSequenceName(sequence))
+        {
+            error = "Not a title sequence name: " + sequence;
+            return false;
+        }
+        if (GetStatus().state == State::running)
+        {
+            error = "A build is running";
+            return false;
+        }
+        if (!TitleIsPreviewingSequence() && gLegacyScene != LegacyScene::titleSequence)
+        {
+            error = "No title sequence is playing";
+            return false;
+        }
+        auto* item = TitleSequenceManager::GetItem(TitleGetCurrentSequence());
+        if (item == nullptr || item->Name != sequence)
+        {
+            error = "The title sequence \"" + sequence + "\" is not the one playing";
+            return false;
+        }
+        if (item->IsZip)
+        {
+            error = "The title sequence \"" + sequence + "\" is a .parkseq file; install it with mksequence.py --install";
+            return false;
+        }
+        auto built = fs::u8path(Path::Combine(ScreensaverFolder(), "build", "live", sequence));
+        auto target = fs::u8path(item->Path);
+        std::error_code ec;
+        if (!fs::is_regular_file(built / "script.txt", ec))
+        {
+            error = "No build of \"" + sequence + "\" to apply";
+            return false;
+        }
+        // The new files first (each written beside its place and renamed over it), the script last.
+        std::set<fs::path> names;
+        std::vector<fs::path> parks;
+        for (fs::directory_iterator it(built, ec), end; !ec && it != end; it.increment(ec))
+        {
+            auto name = it->path().filename();
+            auto ext = String::toUpper(name.extension().u8string());
+            if (it->is_regular_file(ec) && (ext == ".PARK" || ext == ".SV6" || ext == ".SC6" || ext == ".SV4" || ext == ".SC4"))
+            {
+                parks.push_back(name);
+                names.insert(name);
+            }
+        }
+        if (ec)
+        {
+            error = "Cannot read the build: " + ec.message();
+            return false;
+        }
+        auto copy = [&](const fs::path& name) {
+            auto temp = target / fs::u8path(name.u8string() + ".tmp");
+            fs::copy_file(built / name, temp, fs::copy_options::overwrite_existing, ec);
+            if (!ec)
+                fs::rename(temp, target / name, ec);
+            if (ec)
+            {
+                std::error_code ignored;
+                fs::remove(temp, ignored);
+                error = "Cannot write " + (target / name).u8string() + ": " + ec.message();
+                return false;
+            }
+            return true;
+        };
+        for (const auto& name : parks)
+        {
+            // Unchanged files stay as they are.
+            if (fs::exists(target / name, ec) && fs::file_size(target / name, ec) == fs::file_size(built / name, ec))
+            {
+                auto a = File::ReadAllBytes((target / name).u8string());
+                auto b = File::ReadAllBytes((built / name).u8string());
+                if (a == b)
+                    continue;
+            }
+            if (!copy(name))
+                return false;
+        }
+        if (!copy(fs::u8path("script.txt")))
+            return false;
+        // Parks the new script no longer names; one that cannot be removed now is left behind.
+        for (fs::directory_iterator it(target, ec), end; !ec && it != end; it.increment(ec))
+        {
+            auto name = it->path().filename();
+            auto ext = String::toUpper(name.extension().u8string());
+            if ((ext == ".PARK" || ext == ".SV6" || ext == ".SC6" || ext == ".SV4" || ext == ".SC4") && !names.count(name))
+            {
+                std::error_code ignored;
+                fs::remove(it->path(), ignored);
+            }
+        }
+        auto* player = static_cast<ITitleSequencePlayer*>(TitleGetSequencePlayer());
+        if (player == nullptr || !player->Reload())
+        {
+            error = "The new title sequence was copied but could not be reloaded";
+            return false;
+        }
+        LOG_INFO("Screensaver build of \"%s\" applied", sequence.c_str());
+        return true;
+    }
+} // namespace OpenRCT2::Ui::Screensaver::Build
