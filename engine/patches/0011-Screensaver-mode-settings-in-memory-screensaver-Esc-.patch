diff --git a/src/openrct2-ui/screensaver/Screensaver.cpp b/src/openrct2-ui/screensaver/Screensaver.cpp
new file mode 100644
index 0000000..01b6650
--- /dev/null
+++ b/src/openrct2-ui/screensaver/Screensaver.cpp
@@ -0,0 +1,404 @@
+/*****************************************************************************
+ * Copyright (c) 2014-2026 OpenRCT2 developers
+ *
+ * For a complete list of all authors, please refer to contributors.md
+ * Interested in contributing? Visit https://github.com/OpenRCT2/OpenRCT2
+ *
+ * OpenRCT2 is licensed under the GNU General Public License version 3.
+ *****************************************************************************/
+
+#include "Screensaver.h"
+
+#include "../input/InputManager.h"
+
+#include <SDL.h>
+#include <openrct2/Context.h>
+#include <openrct2/Diagnostic.h>
+#include <openrct2/Game.h>
+#include <openrct2/Input.h>
+#include <openrct2/OpenRCT2.h>
+#include <openrct2/audio/Audio.h>
+#include <openrct2/config/Config.h>
+#include <openrct2/drawing/Drawing.Screen.h>
+#include <openrct2/interface/Window.h>
+#include <openrct2/interface/WindowBase.h>
+#include <openrct2/scenes/title/TitleScene.h>
+#include <openrct2/ui/UiContext.h>
+#include <openrct2/ui/WindowManager.h>
+
+#include <unordered_map>
+
+using namespace OpenRCT2;
+using namespace OpenRCT2::Ui;
+
+namespace OpenRCT2::Ui::Screensaver
+{
+    // The config values the mode overrides, as they were before entering.
+    struct ConfigValues
+    {
+        int32_t fullscreenMode{};
+        bool uncapFPS{};
+        bool enableLightFx{};
+        bool enableLightFxForVehicles{};
+        bool renderWeatherGloom{};
+        TitleMusicKind titleMusic{};
+    };
+
+    struct HiddenWindow
+    {
+        bool transparent;
+        bool visible;
+    };
+
+    static bool _active = false;
+    static bool _flagEntered = false;
+    static bool _cursorVisible = true;
+    static Settings _settings;
+    static ConfigValues _saved;
+    static ConfigValues _live;
+    static uint8_t _savedGameSpeed = 1;
+    static std::unordered_map<WindowBase*, HiddenWindow> _hidden;
+    static ChangeListener _changeListener;
+    static MouseListener _mouseListener;
+    static ScreenCoordsXY _lastMouse{ -1, -1 };
+
+    static ConfigValues ReadConfig()
+    {
+        auto& config = Config::Get();
+        ConfigValues values;
+        values.fullscreenMode = config.general.fullscreenMode;
+        values.uncapFPS = config.general.uncapFPS;
+        values.enableLightFx = config.general.enableLightFx;
+        values.enableLightFxForVehicles = config.general.enableLightFxForVehicles;
+        values.renderWeatherGloom = config.general.renderWeatherGloom;
+        values.titleMusic = config.sound.titleMusic;
+        return values;
+    }
+
+    static void WriteConfig(const ConfigValues& values)
+    {
+        auto& config = Config::Get();
+        config.general.fullscreenMode = values.fullscreenMode;
+        config.general.uncapFPS = values.uncapFPS;
+        config.general.enableLightFx = values.enableLightFx;
+        config.general.enableLightFxForVehicles = values.enableLightFxForVehicles;
+        config.general.renderWeatherGloom = values.renderWeatherGloom;
+        config.sound.titleMusic = values.titleMusic;
+    }
+
+    // Config::Save while the mode is on writes the user's own values, never the mode's.
+    static void OnConfigSave(bool writing)
+    {
+        if (writing)
+        {
+            _live = ReadConfig();
+            WriteConfig(_saved);
+        }
+        else
+        {
+            WriteConfig(_live);
+        }
+    }
+
+    static int32_t FullscreenModeFor(WindowStyle style, int32_t current)
+    {
+        switch (style)
+        {
+            case WindowStyle::windowed:
+                return EnumValue(FullscreenMode::windowed);
+            case WindowStyle::borderless:
+                return EnumValue(FullscreenMode::fullscreenDesktop);
+            case WindowStyle::fullscreen:
+                return EnumValue(FullscreenMode::fullscreen);
+            default:
+                return current;
+        }
+    }
+
+    static void SetWindowMode(int32_t mode)
+    {
+        auto& uiContext = GetContext()->GetUiContext();
+        uiContext.SetFullscreenMode(static_cast<FullscreenMode>(mode));
+    }
+
+    static void RestartTitleMusic()
+    {
+        Audio::StopTitleMusic();
+        Audio::PlayTitleMusic();
+    }
+
+    // Applies the settings over the user's values (_saved), in memory only.
+    static void ApplySettings()
+    {
+        auto& config = Config::Get();
+        auto previous = ReadConfig();
+
+        config.general.fullscreenMode = FullscreenModeFor(_settings.windowStyle, _saved.fullscreenMode);
+        // 40 fps: one frame per game tick, as the camera moves once per tick.
+        config.general.uncapFPS = false;
+        config.general.enableLightFx = _settings.lightEffects;
+        config.general.enableLightFxForVehicles = _settings.lightEffects && _saved.enableLightFxForVehicles;
+        config.general.renderWeatherGloom = _settings.weatherGloom;
+        config.sound.titleMusic = _settings.titleMusic ? static_cast<TitleMusicKind>(*_settings.titleMusic)
+                                                       : _saved.titleMusic;
+        if (_settings.gameSpeed && *_settings.gameSpeed >= 1 && *_settings.gameSpeed <= 4)
+        {
+            gGameSpeed = static_cast<uint8_t>(*_settings.gameSpeed);
+        }
+
+        if (config.general.fullscreenMode != previous.fullscreenMode)
+        {
+            SetWindowMode(config.general.fullscreenMode);
+        }
+        if (config.sound.titleMusic != previous.titleMusic)
+        {
+            RestartTitleMusic();
+        }
+        Drawing::GfxInvalidateScreen();
+    }
+
+    static void RestoreConfig()
+    {
+        auto current = ReadConfig();
+        WriteConfig(_saved);
+        Config::SetSaveHook(nullptr);
+        gGameSpeed = _savedGameSpeed;
+        if (current.fullscreenMode != _saved.fullscreenMode)
+        {
+            SetWindowMode(_saved.fullscreenMode);
+        }
+        if (current.titleMusic != _saved.titleMusic)
+        {
+            RestartTitleMusic();
+        }
+    }
+
+    // Every window but the park's own stays open and hidden while the mode is on: transparent
+    // and invisible, so the window code draws the park under it and nothing of it.
+    static void HideWindows()
+    {
+        WindowVisitEach([](WindowBase* w) {
+            if (w->classification == WindowClass::mainWindow || w->flags.has(WindowFlag::dead))
+                return;
+            if (w->flags.has(WindowFlag::hidden) && _hidden.find(w) != _hidden.end())
+                return;
+            w->invalidate();
+            _hidden[w] = { w->flags.has(WindowFlag::transparent), w->isVisible };
+            w->flags.set(WindowFlag::transparent);
+            w->flags.set(WindowFlag::hidden); // (the visibility update would show it again every tick)
+            w->isVisible = false;
+        });
+    }
+
+    static void ShowWindows()
+    {
+        WindowVisitEach([](WindowBase* w) {
+            auto it = _hidden.find(w);
+            if (it == _hidden.end() || w->flags.has(WindowFlag::dead))
+                return;
+            if (!it->second.transparent)
+                w->flags.unset(WindowFlag::transparent);
+            w->flags.unset(WindowFlag::hidden);
+            w->isVisible = it->second.visible;
+            w->invalidate();
+        });
+        _hidden.clear();
+    }
+
+    static void CloseTitleWindows()
+    {
+        auto* windowMgr = GetWindowManager();
+        windowMgr->CloseByClass(WindowClass::titleMenu);
+        windowMgr->CloseByClass(WindowClass::titleExit);
+        windowMgr->CloseByClass(WindowClass::titleOptions);
+        windowMgr->CloseByClass(WindowClass::titleLogo);
+        windowMgr->CloseByClass(WindowClass::titleVersion);
+        windowMgr->CloseByClass(WindowClass::changelog);
+    }
+
+    static void Notify(bool active)
+    {
+        if (_changeListener)
+        {
+            _changeListener(active);
+        }
+    }
+
+    static void Deactivate(bool reopenMenu)
+    {
+        if (!_active)
+            return;
+        _active = false;
+        ShowWindows();
+        RestoreConfig();
+        SDL_ShowCursor(SDL_ENABLE);
+        _cursorVisible = true;
+        if (reopenMenu && gLegacyScene == LegacyScene::titleSequence)
+        {
+            TitleCreateWindows();
+        }
+        Drawing::GfxInvalidateScreen();
+        LOG_INFO("Screensaver mode off");
+        Notify(false);
+    }
+
+    bool IsActive()
+    {
+        return _active;
+    }
+
+    bool LaunchedByFlag()
+    {
+        return gOpenRCT2ScreensaverLaunch;
+    }
+
+    bool Enter()
+    {
+        if (_active)
+            return true;
+        if (gLegacyScene != LegacyScene::titleSequence || gOpenRCT2Headless)
+            return false;
+
+        CloseTitleWindows();
+        _active = true;
+        _saved = ReadConfig();
+        _savedGameSpeed = gGameSpeed;
+        Config::SetSaveHook(OnConfigSave);
+        ApplySettings();
+        HideWindows();
+        _lastMouse = { -1, -1 };
+        LOG_INFO("Screensaver mode on");
+        Notify(true);
+        return true;
+    }
+
+    void Exit()
+    {
+        if (!_active)
+            return;
+        if (LaunchedByFlag())
+        {
+            Deactivate(false);
+            ContextQuit();
+            return;
+        }
+        Deactivate(true);
+    }
+
+    const Settings& GetSettings()
+    {
+        return _settings;
+    }
+
+    void Configure(const Settings& settings)
+    {
+        _settings = settings;
+        if (_active)
+        {
+            ApplySettings();
+        }
+    }
+
+    void SetCursorVisible(bool visible)
+    {
+        _cursorVisible = visible;
+        if (_active)
+        {
+            SDL_ShowCursor(visible ? SDL_ENABLE : SDL_DISABLE);
+        }
+    }
+
+    bool IsCursorVisible()
+    {
+        return _cursorVisible;
+    }
+
+    void SetChangeListener(ChangeListener listener)
+    {
+        _changeListener = std::move(listener);
+    }
+
+    void SetMouseListener(MouseListener listener)
+    {
+        _mouseListener = std::move(listener);
+    }
+
+    void Tick()
+    {
+        if (_active && gLegacyScene != LegacyScene::titleSequence)
+        {
+            // A park was opened or the scene changed under the mode.
+            Deactivate(false);
+        }
+        if (!_active && !_flagEntered && LaunchedByFlag() && gLegacyScene == LegacyScene::titleSequence)
+        {
+            _flagEntered = true;
+            Enter();
+        }
+        if (_active)
+        {
+            HideWindows();
+        }
+    }
+
+    static void SendMouse(MouseEventKind kind, const ScreenCoordsXY& coords, int32_t button, int32_t delta)
+    {
+        if (_mouseListener)
+        {
+            _mouseListener(MouseEvent{ kind, coords.x, coords.y, button, delta });
+        }
+    }
+
+    bool HandleMouse(const ScreenCoordsXY& coords, MouseState state)
+    {
+        if (!_active)
+            return false;
+        switch (state)
+        {
+            case MouseState::leftPress:
+                SendMouse(MouseEventKind::down, coords, 0, 0);
+                break;
+            case MouseState::leftRelease:
+                SendMouse(MouseEventKind::up, coords, 0, 0);
+                break;
+            case MouseState::rightPress:
+                SendMouse(MouseEventKind::down, coords, 1, 0);
+                break;
+            case MouseState::rightRelease:
+                SendMouse(MouseEventKind::up, coords, 1, 0);
+                break;
+            case MouseState::released:
+                if (coords != _lastMouse)
+                {
+                    _lastMouse = coords;
+                    SendMouse(MouseEventKind::move, coords, 0, 0);
+                }
+                break;
+        }
+        return true;
+    }
+
+    bool HandleWheel(int32_t relativeWheel)
+    {
+        if (!_active)
+            return false;
+        if (relativeWheel != 0)
+        {
+            // SDL wheel steps are stored as -1 per step away from the user (UiContext).
+            SendMouse(MouseEventKind::wheel, ContextGetCursorState()->position, 0, -relativeWheel);
+        }
+        return true;
+    }
+
+    bool HandleKey(const InputEvent& e)
+    {
+        if (!_active || e.deviceKind != InputDeviceKind::keyboard)
+            return false;
+        if (e.button == SDLK_ESCAPE && e.state == InputEventState::down)
+        {
+            Exit();
+            return true;
+        }
+        return false;
+    }
+} // namespace OpenRCT2::Ui::Screensaver
