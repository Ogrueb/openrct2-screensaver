+ *****************************************************************************/
+
+// The `screensaver` global (mode, settings, mouse).
+
+#pragma once
+
+#ifdef ENABLE_SCRIPTING
+
+    #include "../screensaver/Screensaver.h"
+
+    #include <openrct2/Context.h>
+    #include <openrct2/scripting/ScriptEngine.h>
+    #include <vector>
+
+namespace OpenRCT2::Scripting
+{
+    class ScScreensaver;
+    extern ScScreensaver gScScreensaver;
+
+    namespace ScreensaverJS
+    {
+        inline std::optional<double> GetNumber(JSContext* ctx, JSValue obj, const char* name)
+        {
+            JSValue val = JS_GetPropertyStr(ctx, obj, name);
+            std::optional<double> result;
+            if (JS_IsNumber(val))
+            {
+                double d = 0;
+                if (JS_ToFloat64(ctx, &d, val) == 0)
+                    result = d;
+            }
+            JS_FreeValue(ctx, val);
+            return result;
+        }
+
+        inline float GetFloat(JSContext* ctx, JSValue obj, const char* name, float def)
+        {
+            auto v = GetNumber(ctx, obj, name);
+            return v ? static_cast<float>(*v) : def;
+        }
+
+        inline std::optional<bool> GetBool(JSContext* ctx, JSValue obj, const char* name)
+        {
+            JSValue val = JS_GetPropertyStr(ctx, obj, name);
+            std::optional<bool> result;
+            if (JS_IsBool(val))
+                result = JS_ToBool(ctx, val) != 0;
+            JS_FreeValue(ctx, val);
+            return result;
+        }
+
+        inline std::optional<std::string> GetString(JSContext* ctx, JSValue obj, const char* name)
+        {
+            JSValue val = JS_GetPropertyStr(ctx, obj, name);
+            std::optional<std::string> result;
+            if (JS_IsString(val))
+                result = JSToStdString(ctx, val);
+            JS_FreeValue(ctx, val);
+            return result;
+        }
+
+        inline OpenRCT2::Ui::Screensaver::Settings GetSettings(JSContext* ctx, JSValue obj)
+        {
+            using namespace OpenRCT2::Ui::Screensaver;
+            Settings settings = OpenRCT2::Ui::Screensaver::GetSettings();
+            if (!JS_IsObject(obj))
+                return settings;
+            if (auto v = GetString(ctx, obj, "window"))
+            {
+                if (*v == "keep")
+                    settings.windowStyle = WindowStyle::keep;
+                else if (*v == "windowed")
+                    settings.windowStyle = WindowStyle::windowed;
+                else if (*v == "fullscreen")
+                    settings.windowStyle = WindowStyle::fullscreen;
+                else
+                    settings.windowStyle = WindowStyle::borderless;
+            }
+            JSValue music = JS_GetPropertyStr(ctx, obj, "titleMusic");
+            if (JS_IsNull(music))
+                settings.titleMusic.reset();
+            else if (auto v = GetNumber(ctx, obj, "titleMusic"))
+                settings.titleMusic = static_cast<int32_t>(*v);
+            JS_FreeValue(ctx, music);
+            JSValue speed = JS_GetPropertyStr(ctx, obj, "gameSpeed");
+            if (JS_IsNull(speed))
+                settings.gameSpeed.reset();
+            else if (auto v = GetNumber(ctx, obj, "gameSpeed"))
+                settings.gameSpeed = static_cast<int32_t>(*v);
+            JS_FreeValue(ctx, speed);
+            if (auto v = GetBool(ctx, obj, "lightEffects"))
+                settings.lightEffects = *v;
+            if (auto v = GetBool(ctx, obj, "weatherGloom"))
+                settings.weatherGloom = *v;
+            return settings;
+        }
+
+        inline JSValue SettingsToJS(JSContext* ctx, const OpenRCT2::Ui::Screensaver::Settings& settings)
+        {
+            using namespace OpenRCT2::Ui::Screensaver;
+            static constexpr const char* kStyles[] = { "keep", "windowed", "borderless", "fullscreen" };
+            JSValue obj = JS_NewObject(ctx);
+            JS_SetPropertyStr(ctx, obj, "window", JS_NewString(ctx, kStyles[static_cast<size_t>(settings.windowStyle)]));
+            JS_SetPropertyStr(
+                ctx, obj, "titleMusic", settings.titleMusic ? JS_NewInt32(ctx, *settings.titleMusic) : JS_NULL);
+            JS_SetPropertyStr(ctx, obj, "gameSpeed", settings.gameSpeed ? JS_NewInt32(ctx, *settings.gameSpeed) : JS_NULL);
+            JS_SetPropertyStr(ctx, obj, "lightEffects", JS_NewBool(ctx, settings.lightEffects));
+            JS_SetPropertyStr(ctx, obj, "weatherGloom", JS_NewBool(ctx, settings.weatherGloom));
+            return obj;
+        }
+
+        struct Listener
+        {
+            std::shared_ptr<Plugin> owner;
+            JSCallback callback;
+        };
+
+        inline std::vector<Listener>& ChangeListeners()
+        {
+            static std::vector<Listener> listeners;
+            return listeners;
+        }
+
+        inline std::vector<Listener>& MouseListeners()
+        {
+            static std::vector<Listener> listeners;
+            return listeners;
+        }
+
+        inline void Dispatch(std::vector<Listener>& listeners, const std::function<JSValue(JSContext*)>& makeArg)
+        {
+            auto& scriptEngine = GetContext()->GetScriptEngine();
+            // A callback may add or remove listeners.
+            auto copy = listeners;
+            for (auto& listener : copy)
+            {
+                if (listener.owner == nullptr)
+                    continue;
+                JSContext* ctx = listener.owner->GetContext();
+                scriptEngine.ExecutePluginCall(listener.owner, listener.callback.callback, { makeArg(ctx) }, false);
+            }
+        }
+
+        inline void InstallListeners()
+        {
+            using namespace OpenRCT2::Ui::Screensaver;
+            SetChangeListener([](bool active) {
+                Dispatch(ChangeListeners(), [active](JSContext* ctx) { return JS_NewBool(ctx, active); });
+            });
+            SetMouseListener([](const MouseEvent& e) {
+                static constexpr const char* kKinds[] = { "move", "down", "up", "wheel" };
+                Dispatch(MouseListeners(), [&e](JSContext* ctx) {
+                    JSValue obj = JS_NewObject(ctx);
+                    JS_SetPropertyStr(ctx, obj, "type", JS_NewString(ctx, kKinds[static_cast<size_t>(e.kind)]));
+                    JS_SetPropertyStr(ctx, obj, "x", JS_NewInt32(ctx, e.x));
+                    JS_SetPropertyStr(ctx, obj, "y", JS_NewInt32(ctx, e.y));
+                    JS_SetPropertyStr(ctx, obj, "button", JS_NewInt32(ctx, e.button));
+                    JS_SetPropertyStr(ctx, obj, "delta", JS_NewInt32(ctx, e.delta));
+                    return obj;
+                });
+            });
+        }
+
+        inline void AddListener(std::vector<Listener>& listeners, JSContext* ctx, JSValue func)
+        {
+            auto& scriptEngine = GetContext()->GetScriptEngine();
+            auto plugin = scriptEngine.GetExecInfo().GetCurrentPlugin();
+            if (plugin == nullptr || !JS_IsFunction(ctx, func))
+                return;
+            listeners.push_back({ plugin, JSCallback(ctx, func) });
+        }
+
+        inline void RemovePlugin(const std::shared_ptr<Plugin>& plugin)
+        {
+            for (auto* listeners : { &ChangeListeners(), &MouseListeners() })
+            {
+                std::erase_if(*listeners, [&plugin](const Listener& l) { return l.owner == plugin; });
+            }
+        }
+    } // namespace ScreensaverJS
+
+    class ScScreensaver final : public ScBase
+    {
+    public:
+        void Register(JSContext* ctx)
+        {
+            static constexpr JSCFunctionListEntry funcs[] = {
+                JS_CGETSET_DEF("active", ScScreensaver::active_get, nullptr),
+                JS_CGETSET_DEF("launchedByFlag", ScScreensaver::launchedByFlag_get, nullptr),
+                JS_CGETSET_DEF("settings", ScScreensaver::settings_get, nullptr),
+                JS_CGETSET_DEF("cursorVisible", ScScreensaver::cursorVisible_get, ScScreensaver::cursorVisible_set),
+                JS_CFUNC_DEF("enter", 1, ScScreensaver::enter),
+                JS_CFUNC_DEF("exit", 0, ScScreensaver::exit),
+                JS_CFUNC_DEF("configure", 1, ScScreensaver::configure),
+                JS_CFUNC_DEF("onChange", 1, ScScreensaver::onChange),
+                JS_CFUNC_DEF("onMouse", 1, ScScreensaver::onMouse),
+            };
+            RegisterBase(ctx, "Screensaver", nullptr, funcs);
+            ScreensaverJS::InstallListeners();
+        }
+
+        JSValue New(JSContext* ctx)
+        {
+            return MakeWithOpaque(ctx, nullptr);
+        }
+
+        static void RemovePlugin(const std::shared_ptr<Plugin>& plugin)
+        {
+            ScreensaverJS::RemovePlugin(plugin);
+        }
+
+    private:
+        static JSValue active_get(JSContext* ctx, JSValue)
+        {
+            return JS_NewBool(ctx, Ui::Screensaver::IsActive());
+        }
+
+        static JSValue launchedByFlag_get(JSContext* ctx, JSValue)
+        {
+            return JS_NewBool(ctx, Ui::Screensaver::LaunchedByFlag());
+        }
+
+        static JSValue settings_get(JSContext* ctx, JSValue)
+        {
+            return ScreensaverJS::SettingsToJS(ctx, Ui::Screensaver::GetSettings());
+        }
+
+        static JSValue cursorVisible_get(JSContext* ctx, JSValue)
+        {
+            return JS_NewBool(ctx, Ui::Screensaver::IsCursorVisible());
+        }
+
+        static JSValue cursorVisible_set(JSContext* ctx, JSValue, JSValue value)
+        {
+            Ui::Screensaver::SetCursorVisible(JS_ToBool(ctx, value) != 0);
+            return JS_UNDEFINED;
+        }
+
+        static JSValue enter(JSContext* ctx, JSValue, int argc, JSValue* argv)
+        {
+            if (argc > 0 && JS_IsObject(argv[0]))
+                Ui::Screensaver::Configure(ScreensaverJS::GetSettings(ctx, argv[0]));
+            return JS_NewBool(ctx, Ui::Screensaver::Enter());
+        }
+
+        static JSValue exit(JSContext*, JSValue, int, JSValue*)
+        {
+            Ui::Screensaver::Exit();
+            return JS_UNDEFINED;
+        }
+
+        static JSValue configure(JSContext* ctx, JSValue, int argc, JSValue* argv)
+        {
+            Ui::Screensaver::Configure(ScreensaverJS::GetSettings(ctx, argv[0]));
+            return JS_UNDEFINED;
+        }
+
+        static JSValue onChange(JSContext* ctx, JSValue, int argc, JSValue* argv)
+        {
+            ScreensaverJS::AddListener(ScreensaverJS::ChangeListeners(), ctx, argv[0]);
+            return JS_UNDEFINED;
+        }
+
+        static JSValue onMouse(JSContext* ctx, JSValue, int argc, JSValue* argv)
+        {
+            ScreensaverJS::AddListener(ScreensaverJS::MouseListeners(), ctx, argv[0]);
+            return JS_UNDEFINED;
+        }
+    };
+
+} // namespace OpenRCT2::Scripting
+
+#endif
