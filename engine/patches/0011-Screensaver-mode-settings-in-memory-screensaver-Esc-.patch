+ *****************************************************************************/
+
+// A screensaver mode on the title screen. The park plays in one window with no
+// stock windows on top; a plugin draws its own interface in the overlay (Overlay.h) and gets the
+// mouse. The mode's settings are applied in memory on entry and restored on exit: config.ini never
+// sees them (Config::SetSaveFilter).
+
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <optional>
+#include <string>
+
+#include "../input/MouseInput.h"
+
+struct ScreenCoordsXY;
+
+namespace OpenRCT2::Ui
+{
+    struct InputEvent;
+}
+
+namespace OpenRCT2::Ui::Screensaver
+{
+    enum class WindowStyle : uint8_t
+    {
+        keep,
+        windowed,
+        borderless,
+        fullscreen,
+    };
+
+    // What the mode applies on entry. Unset values leave the game's own setting alone.
+    struct Settings
+    {
+        WindowStyle windowStyle = WindowStyle::borderless;
+        std::optional<int32_t> titleMusic; // TitleMusicKind
+        std::optional<int32_t> gameSpeed;  // 1-4
+        bool lightEffects = false;
+        bool weatherGloom = false;
+    };
+
+    enum class MouseEventKind : uint8_t
+    {
+        move,
+        down,
+        up,
+        wheel,
+    };
+
+    struct MouseEvent
+    {
+        MouseEventKind kind;
+        int32_t x;      // game pixels
+        int32_t y;
+        int32_t button; // 0 left, 1 right (down/up)
+        int32_t delta;  // wheel steps, positive away from the user
+    };
+
+    bool IsActive();
+    bool LaunchedByFlag();
+
+    // Enters the mode on the title screen. Returns false anywhere else.
+    bool Enter();
+    // Leaves the mode. In a --screensaver launch, leaving quits the game.
+    void Exit();
+
+    const Settings& GetSettings();
+    // Stores the settings for the next entry, and applies them at once while the mode is on.
+    void Configure(const Settings& settings);
+
+    using ChangeListener = std::function<void(bool active)>;
+    using MouseListener = std::function<void(const MouseEvent&)>;
+    // The mouse cursor while the mode is on (a controls bar hides it with itself).
+    void SetCursorVisible(bool visible);
+    bool IsCursorVisible();
+
+    void SetChangeListener(ChangeListener listener);
+    void SetMouseListener(MouseListener listener);
+
+    // Hooks called from upstream code.
+    void Tick();                                                                // GameHandleInput, every tick
+    bool HandleMouse(const ScreenCoordsXY& coords, OpenRCT2::MouseState state); // true: consumed
+    bool HandleWheel(int32_t relativeWheel);                                    // true: consumed
+    bool HandleKey(const InputEvent& e);                                        // true: consumed
+} // namespace OpenRCT2::Ui::Screensaver
