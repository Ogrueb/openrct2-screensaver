                 std::erase_if(*listeners, [&plugin](const Listener& l) { return l.owner == plugin; });
             }
         }
+
+        // Files: plain text files in one folder, <user directory>/screensaver/live, by bare name.
+        // A name is 1-128 characters of letters, digits, '.', '_' and '-', not starting with '.',
+        // and ends in ".json": no path separators, so nothing outside the folder can be reached.
+        constexpr size_t kMaxFileSize = 8 * 1024 * 1024;
+
+        inline bool IsFileName(const std::string& name)
+        {
+            if (name.empty() || name.size() > 128 || name[0] == '.' || name.size() < 6
+                || name.compare(name.size() - 5, 5, ".json") != 0)
+                return false;
+            return std::all_of(name.begin(), name.end(), [](char c) {
+                return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '.' || c == '_'
+                    || c == '-';
+            });
+        }
+
+        inline u8string FilesFolder()
+        {
+            auto user = GetContext()->GetPlatformEnvironment().GetDirectoryPath(DirBase::user);
+            return Path::Combine(user, "screensaver", "live");
+        }
+
+        inline std::optional<std::string> ReadFile(const std::string& name)
+        {
+            if (!IsFileName(name))
+                return std::nullopt;
+            std::error_code ec;
+            auto path = fs::u8path(Path::Combine(FilesFolder(), name));
+            if (!fs::is_regular_file(path, ec) || fs::file_size(path, ec) > kMaxFileSize || ec)
+                return std::nullopt;
+            std::ifstream in(path, std::ios::binary);
+            if (!in)
+                return std::nullopt;
+            return std::string(std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>());
+        }
+
+        // Written to a temporary file first, then renamed over the old one, so a reader never sees
+        // half a file.
+        inline bool WriteFile(const std::string& name, const std::string& text)
+        {
+            if (!IsFileName(name) || text.size() > kMaxFileSize)
+                return false;
+            std::error_code ec;
+            auto folder = fs::u8path(FilesFolder());
+            fs::create_directories(folder, ec);
+            auto path = folder / fs::u8path(name);
+            auto temp = folder / fs::u8path(name + ".tmp");
+            {
+                std::ofstream out(temp, std::ios::binary | std::ios::trunc);
+                if (!out)
+                    return false;
+                out.write(text.data(), static_cast<std::streamsize>(text.size()));
+                if (!out)
+                    return false;
+            }
+            fs::rename(temp, path, ec);
+            if (ec)
+            {
+                fs::remove(temp, ec);
+                return false;
+            }
+            return true;
+        }
+
+        inline std::vector<std::string> ListFiles()
+        {
+            std::vector<std::string> names;
+            std::error_code ec;
+            for (fs::directory_iterator it(fs::u8path(FilesFolder()), ec), end; !ec && it != end; it.increment(ec))
+            {
+                auto name = it->path().filename().u8string();
+                std::string s(name.begin(), name.end());
+                if (IsFileName(s) && it->is_regular_file(ec))
+                    names.push_back(s);
+            }
+            std::sort(names.begin(), names.end());
+            return names;
+        }
     } // namespace ScreensaverJS
 
