                 JS_CFUNC_DEF("onMouse", 1, ScScreensaver::onMouse),
+                JS_CGETSET_DEF("filesFolder", ScScreensaver::filesFolder_get, nullptr),
+                JS_CFUNC_DEF("readFile", 1, ScScreensaver::readFile),
+                JS_CFUNC_DEF("writeFile", 2, ScScreensaver::writeFile),
+                JS_CFUNC_DEF("listFiles", 0, ScScreensaver::listFiles),
+                JS_CGETSET_DEF("clipboard", ScScreensaver::clipboard_get, ScScreensaver::clipboard_set),
             };
             RegisterBase(ctx, "Screensaver", nullptr, funcs);
             ScreensaverJS::InstallListeners();
@@ -519,6 +609,54 @@ namespace OpenRCT2::Scripting
             ScreensaverJS::AddListener(ScreensaverJS::MouseListeners(), ctx, argv[0]);
             return JS_UNDEFINED;
         }
+
+        // Files in <user directory>/screensaver/live (see ScreensaverJS::IsFileName).
+        static JSValue filesFolder_get(JSContext* ctx, JSValue)
+        {
+            return JSFromStdString(ctx, ScreensaverJS::FilesFolder());
+        }
+
+        // The file's text, or null when the name is not allowed or there is no such file.
+        static JSValue readFile(JSContext* ctx, JSValue, int argc, JSValue* argv)
+        {
+            if (argc < 1 || !JS_IsString(argv[0]))
+                return JS_NULL;
+            auto text = ScreensaverJS::ReadFile(JSToStdString(ctx, argv[0]));
+            return text ? JSFromStdString(ctx, *text) : JS_NULL;
+        }
+
+        // Whether the file was written.
+        static JSValue writeFile(JSContext* ctx, JSValue, int argc, JSValue* argv)
+        {
+            if (argc < 2 || !JS_IsString(argv[0]) || !JS_IsString(argv[1]))
+                return JS_NewBool(ctx, false);
+            return JS_NewBool(ctx, ScreensaverJS::WriteFile(JSToStdString(ctx, argv[0]), JSToStdString(ctx, argv[1])));
+        }
+
+        static JSValue listFiles(JSContext* ctx, JSValue, int, JSValue*)
+        {
+            JSValue array = JS_NewArray(ctx);
+            uint32_t i = 0;
+            for (const auto& name : ScreensaverJS::ListFiles())
+                JS_SetPropertyUint32(ctx, array, i++, JSFromStdString(ctx, name));
+            return array;
+        }
+
+        // The system clipboard's text ("" when it holds none).
+        static JSValue clipboard_get(JSContext* ctx, JSValue)
+        {
+            char* text = SDL_GetClipboardText();
+            std::string result = text != nullptr ? text : "";
+            SDL_free(text);
+            return JSFromStdString(ctx, result);
+        }
+
+        static JSValue clipboard_set(JSContext* ctx, JSValue, JSValue value)
+        {
+            if (JS_IsString(value))
+                SDL_SetClipboardText(JSToStdString(ctx, value).c_str());
+            return JS_UNDEFINED;
+        }
     };
 
     inline JSValue ScScreensaver::overlay_get(JSContext* ctx, JSValue)
