             };
             RegisterBase(ctx, "Screensaver", nullptr, funcs);
             ScreensaverJS::InstallListeners();
@@ -683,8 +687,9 @@ namespace OpenRCT2::Scripting
             return JS_UNDEFINED;
         }
 
-        // { state: "idle" | "running" | "done" | "failed" | "cancelled", task: "build" | "export" |
-        //   "import" (empty before the first), sequence, exitCode, started, finished (ms since 1970), error }
+        // { state: "idle" | "running" | "done" | "failed" | "cancelled", task: "build" | "export" | "import" |
+        //   "add" | "new" | "copy" (empty before the first), sequence, exitCode, started, finished (ms since 1970),
+        //   error }
         static JSValue buildStatus_get(JSContext* ctx, JSValue)
         {
             auto status = Ui::Screensaver::Build::GetStatus();
@@ -757,6 +762,61 @@ namespace OpenRCT2::Scripting
             }
             return JS_NewBool(ctx, !cancelled);
         }
+
+        // addPark(sequence) shows the system's Open dialog for a park and adds the picked one to that
+        // title sequence's playlist, then builds it, in the background (buildStatus follows it). False
+        // when the dialog was closed; throws with the reason when it cannot start.
+        static JSValue addPark(JSContext* ctx, JSValue, int argc, JSValue* argv)
+        {
+            if (argc < 1 || !JS_IsString(argv[0]))
+            {
+                JS_ThrowTypeError(ctx, "addPark(sequence): sequence must be a string");
+                return JS_EXCEPTION;
+            }
+            bool cancelled = false;
+            std::string error;
+            if (!Ui::Screensaver::Build::AddPark(JSToStdString(ctx, argv[0]), cancelled, error) && !cancelled)
+            {
+                JS_ThrowPlainError(ctx, "%s", error.c_str());
+                return JS_EXCEPTION;
+            }
+            return JS_NewBool(ctx, !cancelled);
+        }
+
+        // newPlaylist() shows the system's folder dialog and makes a playlist of the parks in the picked
+        // folder, in the background (buildStatus follows it; the generator lists its parks). False when the dialog was
+        // closed; throws with the reason when it cannot start.
+        static JSValue newPlaylist(JSContext* ctx, JSValue, int, JSValue*)
+        {
+            bool cancelled = false;
+            std::string error;
+            if (!Ui::Screensaver::Build::NewPlaylist(cancelled, error) && !cancelled)
+            {
+                JS_ThrowPlainError(ctx, "%s", error.c_str());
+                return JS_EXCEPTION;
+            }
+            return JS_NewBool(ctx, !cancelled);
+        }
+
+        // copyPlaylist(sequence) shows the system's Save dialog to name a copy of that title sequence's
+        // playlist, then copies it in the background (applyBuild then plays the copy). False when
+        // the dialog was closed; throws with the reason when it cannot start.
+        static JSValue copyPlaylist(JSContext* ctx, JSValue, int argc, JSValue* argv)
+        {
+            if (argc < 1 || !JS_IsString(argv[0]))
+            {
+                JS_ThrowTypeError(ctx, "copyPlaylist(sequence): sequence must be a string");
+                return JS_EXCEPTION;
+            }
+            bool cancelled = false;
+            std::string error;
+            if (!Ui::Screensaver::Build::CopyPlaylist(JSToStdString(ctx, argv[0]), cancelled, error) && !cancelled)
+            {
+                JS_ThrowPlainError(ctx, "%s", error.c_str());
+                return JS_EXCEPTION;
+            }
+            return JS_NewBool(ctx, !cancelled);
+        }
     };
 
     inline JSValue ScScreensaver::overlay_get(JSContext* ctx, JSValue)
