-// The `screensaver` global (mode, settings, mouse, overlay, files, clipboard, builds, playlist bundles).
+// The `screensaver` global (mode, settings, mouse, overlay, files, clipboard, builds, playlist bundles,
+// parks and new playlists).
 
 #pragma once
 
@@ -542,6 +543,9 @@ namespace OpenRCT2::Scripting
                 JS_CFUNC_DEF("applyBuild", 1, ScScreensaver::applyBuild),
                 JS_CFUNC_DEF("exportPlaylist", 1, ScScreensaver::exportPlaylist),
                 JS_CFUNC_DEF("importPlaylist", 0, ScScreensaver::importPlaylist),
