+        // Runs the generator with these arguments after its own (`task` and `sequence` as the status
+        // reports them); one task at a time.
+        bool StartTask(
+            const std::string& task, const std::string& sequence, const std::vector<std::string>& extra, std::string& error)
+        {
+            auto& shared = GetShared();
+            {
+                std::lock_guard lock(shared.mutex);
+                if (shared.status.state == State::running)
+                {
+                    error = "A " + shared.status.task + " is running already"
+                        + (shared.status.sequence.empty() ? "" : " (" + shared.status.sequence + ")");
+                    return false;
+                }
+            }
+            auto generator = ReadGenerator(error);
+            if (!generator)
+                return false;
+            auto folder = ScreensaverFolder();
+            std::error_code ec;
+            fs::create_directories(fs::u8path(folder), ec);
+            auto user = GetContext()->GetPlatformEnvironment().GetDirectoryPath(DirBase::user);
+            // The repository's root: the generator's folder's parent (tools/mksequence.py).
+            auto cwd = fs::u8path(generator->script).parent_path().parent_path().u8string();
+            std::vector<std::string> args = { generator->python, generator->script };
+            args.insert(args.end(), extra.begin(), extra.end());
+            args.push_back("--user-dir");
+            args.push_back(user);
+            {
+                std::lock_guard lock(shared.mutex);
+                shared.status = Status{ State::running, task, sequence, 0, Now(), 0, "" };
+                shared.cancelled = false;
+            }
+            if (!Launch(args, std::string(cwd.begin(), cwd.end()), Path::Combine(folder, "build.log"), error))
+            {
+                std::lock_guard lock(shared.mutex);
+                shared.status.state = State::failed;
+                shared.status.finished = Now();
+                shared.status.error = error;
+                return false;
+            }
+            LOG_INFO("Screensaver %s of \"%s\" started", task.c_str(), sequence.c_str());
+            return true;
+        }
+
+        bool IsRunning()
+        {
+            auto& shared = GetShared();
+            std::lock_guard lock(shared.mutex);
+            return shared.status.state == State::running;
+        }
