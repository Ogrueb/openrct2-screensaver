+        // exportPlaylist(sequence) shows the system's Save dialog for a playlist bundle and exports
+        // that title sequence's playlist into the picked file in the background (buildStatus follows
+        // it). False when the dialog was closed; throws with the reason when it cannot start.
+        static JSValue exportPlaylist(JSContext* ctx, JSValue, int argc, JSValue* argv)
+        {
+            if (argc < 1 || !JS_IsString(argv[0]))
+            {
+                JS_ThrowTypeError(ctx, "exportPlaylist(sequence): sequence must be a string");
+                return JS_EXCEPTION;
+            }
+            bool cancelled = false;
+            std::string error;
+            if (!Ui::Screensaver::Build::Export(JSToStdString(ctx, argv[0]), cancelled, error) && !cancelled)
+            {
+                JS_ThrowPlainError(ctx, "%s", error.c_str());
+                return JS_EXCEPTION;
