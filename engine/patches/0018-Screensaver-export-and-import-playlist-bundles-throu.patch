+        // The folder the last bundle was picked in (this run only); first the user's documents.
+        u8string& BundleFolder()
+        {
+            static u8string folder;
+            if (folder.empty())
+            {
+#ifdef _WIN32
+                // The user directory is <Documents>\OpenRCT2.
+                auto user = GetContext()->GetPlatformEnvironment().GetDirectoryPath(DirBase::user);
+                folder = fs::u8path(user).parent_path().u8string();
+#else
+                folder = Platform::GetFolderPath(SpecialFolder::userHome);
+#endif
+            }
+            return folder;
+        }
+
+        // The system's file dialog for a playlist bundle: the picked file, or empty when closed.
+        u8string PickBundle(Ui::FileDialogType type, const u8string& title, const u8string& defaultName)
+        {
+            Ui::FileDialogDesc desc;
+            desc.Type = type;
+            desc.Title = title;
+            desc.InitialDirectory = BundleFolder();
+            desc.DefaultFilename = defaultName.empty() ? u8string() : Path::Combine(BundleFolder(), defaultName);
+            // (the first filter's extension is the one a Save dialog adds)
+            desc.Filters.emplace_back("Playlist bundle", "*.zip");
+            u8string picked;
+            try
+            {
+                picked = GetContext()->GetUiContext().ShowFileDialog(desc);
+            }
+            catch (const std::exception& e)
+            {
+                // No dialog on this system (on Linux: neither zenity nor kdialog)
+                LOG_ERROR("Screensaver: no file dialog: %s", e.what());
+                throw;
+            }
+            if (!picked.empty())
+                BundleFolder() = fs::u8path(picked).parent_path().u8string();
+            return picked;
+        }
+
+        // A file name for the bundle: the sequence's name with characters file systems refuse dropped.
+        u8string BundleName(const std::string& sequence)
+        {
+            u8string name;
+            for (unsigned char c : sequence)
+            {
+                if (c >= 0x20 && c != 0x7F && c != '/' && c != '\\' && c != '"' && c != ':' && c != '*' && c != '?'
+                    && c != '<' && c != '>' && c != '|')
+                    name.push_back(static_cast<char>(c));
+            }
+            return (name.empty() ? u8string("playlist") : name) + ".zip";
+        }
