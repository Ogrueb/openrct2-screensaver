diff --git a/src/openrct2-ui/scripting/ScScreensaver.hpp b/src/openrct2-ui/scripting/ScScreensaver.hpp
index fa2cb52..636d990 100644
--- a/src/openrct2-ui/scripting/ScScreensaver.hpp
+++ b/src/openrct2-ui/scripting/ScScreensaver.hpp
@@ -18,6 +18,7 @@
 
     #include <openrct2/Context.h>
     #include <openrct2/scripting/ScriptEngine.h>
+    #include <algorithm>
     #include <vector>
 
 namespace OpenRCT2::Scripting
@@ -211,6 +212,39 @@ namespace OpenRCT2::Scripting
                 settings.lightEffects = *v;
             if (auto v = GetBool(ctx, obj, "weatherGloom"))
                 settings.weatherGloom = *v;
+            if (auto v = GetBool(ctx, obj, "weather"))
+                settings.weather = *v;
+            if (auto v = GetString(ctx, obj, "timeOfDay"))
+                settings.timeOfDay = *v == "night" ? 1 : *v == "cycle" ? 2 : 0;
+            // Volumes 0-100; null or absent leaves the user's own.
+            auto volume = [&](const char* name, std::optional<int32_t>& out) {
+                JSValue value = JS_GetPropertyStr(ctx, obj, name);
+                if (JS_IsNull(value) || JS_IsUndefined(value))
+                    out.reset();
+                else if (auto v = GetNumber(ctx, obj, name))
+                    out = static_cast<int32_t>(*v);
+                JS_FreeValue(ctx, value);
+            };
+            volume("masterVolume", settings.masterVolume);
+            volume("soundVolume", settings.soundVolume);
+            volume("musicVolume", settings.musicVolume);
+            // "software", "opengl", or null/absent: the user's own engine.
+            JSValue engine = JS_GetPropertyStr(ctx, obj, "drawingEngine");
+            if (JS_IsString(engine))
+            {
+                auto name = GetString(ctx, obj, "drawingEngine");
+                if (name && *name == "software")
+                    settings.drawingEngine = 0;
+                else if (name && *name == "opengl")
+                    settings.drawingEngine = 1;
+                else
+                    settings.drawingEngine.reset();
+            }
+            else
+                settings.drawingEngine.reset();
+            JS_FreeValue(ctx, engine);
+            // true, false, or null/absent: the user's own.
+            settings.multiThreading = GetBool(ctx, obj, "multiThreading");
             return settings;
         }
 
@@ -225,6 +259,21 @@ namespace OpenRCT2::Scripting
             JS_SetPropertyStr(ctx, obj, "gameSpeed", settings.gameSpeed ? JS_NewInt32(ctx, *settings.gameSpeed) : JS_NULL);
             JS_SetPropertyStr(ctx, obj, "lightEffects", JS_NewBool(ctx, settings.lightEffects));
             JS_SetPropertyStr(ctx, obj, "weatherGloom", JS_NewBool(ctx, settings.weatherGloom));
+            JS_SetPropertyStr(ctx, obj, "weather", JS_NewBool(ctx, settings.weather));
+            static constexpr const char* kTimesOfDay[] = { "day", "night", "cycle" };
+            JS_SetPropertyStr(
+                ctx, obj, "timeOfDay", JS_NewString(ctx, kTimesOfDay[std::clamp(settings.timeOfDay, 0, 2)]));
+            auto volume = [&](const char* name, const std::optional<int32_t>& v) {
+                JS_SetPropertyStr(ctx, obj, name, v ? JS_NewInt32(ctx, *v) : JS_NULL);
+            };
+            volume("masterVolume", settings.masterVolume);
+            volume("soundVolume", settings.soundVolume);
+            volume("musicVolume", settings.musicVolume);
+            JS_SetPropertyStr(
+                ctx, obj, "drawingEngine",
+                settings.drawingEngine ? JS_NewString(ctx, *settings.drawingEngine == 1 ? "opengl" : "software") : JS_NULL);
+            JS_SetPropertyStr(
+                ctx, obj, "multiThreading", settings.multiThreading ? JS_NewBool(ctx, *settings.multiThreading) : JS_NULL);
             return obj;
         }
 
