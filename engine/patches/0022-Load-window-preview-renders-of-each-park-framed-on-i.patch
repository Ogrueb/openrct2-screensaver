+// The tiles the park is built on: tiles with at least two elements besides the surface (one when no
+// tile has two), weighted by that count squared, with 1% of the weight trimmed from each side so that
+// a few far-off pieces do not widen the frame.
+struct PreviewContent
+{
+    TileCoordsXY min;
+    TileCoordsXY max;
+    std::vector<double> weights; // each tile's weight, y * map width + x
+    bool found{};
+};
+
+// What makes elements alike for telling a backdrop apart: the same type at the same heights (a sheet laid
+// flat over the unused map), or the same scenery object at any height (a sheet on uneven ground, a forest)
+static std::array<uint64_t, 2> BackdropKeys(const TileElement& element)
+{
+    const auto type = static_cast<uint64_t>(element.getType()) << 40;
+    const uint64_t heights = (1ull << 32) | (static_cast<uint32_t>(element.baseHeight) << 8) | element.clearanceHeight;
+    uint64_t object = heights;
+    switch (element.getType())
+    {
+        case TileElementType::smallScenery:
+            object = element.asSmallScenery()->getEntryIndex();
+            break;
+        case TileElementType::largeScenery:
+            object = element.asLargeScenery()->getEntryIndex();
+            break;
+        case TileElementType::wall:
+            object = element.asWall()->getEntryIndex();
+            break;
+        default:
+            break;
+    }
+    return { type | heights, type | object };
+}
+
+static PreviewContent GetPreviewContent()
+{
+    const auto& mapSize = getGameState().mapSize;
+
+    // Elements alike on more than 30% of the tiles are a backdrop, not what was built
+    std::unordered_map<uint64_t, uint32_t> backdropTiles;
+    std::vector<uint64_t> tileKeys;
+    for (int32_t y = 0; y < mapSize.y; y++)
+    {
+        for (int32_t x = 0; x < mapSize.x; x++)
+        {
+            tileKeys.clear();
+            for (const auto* element : TileElementsView(TileCoordsXY(x, y).toCoordsXY()))
+            {
+                if (element->getType() == TileElementType::surface)
+                    continue;
+                for (auto key : BackdropKeys(*element))
+                {
+                    if (std::find(tileKeys.begin(), tileKeys.end(), key) == tileKeys.end())
+                    {
+                        tileKeys.push_back(key);
+                        backdropTiles[key]++;
+                    }
+                }
+            }
+        }
+    }
+    const auto sheetTiles = static_cast<uint32_t>(static_cast<int64_t>(mapSize.x) * mapSize.y * 3 / 10);
+    auto isBackdrop = [&](const TileElement& element) {
+        for (auto key : BackdropKeys(element))
+        {
+            if (backdropTiles[key] > sheetTiles)
+                return true;
+        }
+        return false;
+    };
+
+    std::vector<uint32_t> counts(static_cast<size_t>(mapSize.x) * mapSize.y);
+    uint32_t maxCount = 0;
+    for (int32_t y = 0; y < mapSize.y; y++)
+    {
+        for (int32_t x = 0; x < mapSize.x; x++)
+        {
+            uint32_t n = 0;
+            for (const auto* element : TileElementsView(TileCoordsXY(x, y).toCoordsXY()))
+            {
+                if (element->getType() == TileElementType::surface || element->isInvisible() || isBackdrop(*element))
+                    continue;
+                n++;
+            }
+            counts[y * mapSize.x + x] = n;
+            maxCount = std::max(maxCount, n);
+        }
+    }
+
+    PreviewContent content;
+    if (maxCount == 0)
+        return content;
+
+    const uint32_t threshold = maxCount >= 2 ? 2 : 1;
+
+    content.weights.assign(counts.size(), 0);
+    std::vector<double> weightX(mapSize.x), weightY(mapSize.y);
+    double total = 0;
+    for (int32_t y = 0; y < mapSize.y; y++)
+    {
+        for (int32_t x = 0; x < mapSize.x; x++)
+        {
+            auto n = counts[y * mapSize.x + x];
+            if (n < threshold)
+                continue;
+            double w = static_cast<double>(n) * n;
+            content.weights[y * mapSize.x + x] = w;
+            weightX[x] += w;
+            weightY[y] += w;
+            total += w;
+        }
+    }
+
+    auto trimmed = [total](const std::vector<double>& weights, int32_t& low, int32_t& high) {
+        const double cut = total * 0.01;
+        double sum = 0;
+        low = 0;
+        while (low < static_cast<int32_t>(weights.size()) - 1 && sum + weights[low] <= cut)
+            sum += weights[low++];
+        sum = 0;
+        high = static_cast<int32_t>(weights.size()) - 1;
+        while (high > low && sum + weights[high] <= cut)
+            sum += weights[high--];
+    };
+    trimmed(weightX, content.min.x, content.max.x);
+    trimmed(weightY, content.min.y, content.max.y);
+    content.found = true;
+    return content;
+}
+
+// A viewport at the park's saved rotation on its built area, at the zoom level and reduction that fit it
+// most closely in the given size; scale says how much smaller the picture still has to be made afterwards.
+static Viewport GetPreviewViewport(int32_t width, int32_t height, int32_t& scale)
