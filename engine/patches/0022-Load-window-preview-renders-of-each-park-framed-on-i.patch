+// Reduces a picture by a whole factor, keeping for each block of pixels the colour most of them have
+// (palette images cannot be blended); transparent pixels count only when nothing else is there.
+static void ReducePicture(const RenderTarget& source, RenderTarget& target, int32_t scale)
+{
+    std::array<uint16_t, 256> votes{};
+    for (int32_t y = 0; y < target.height; y++)
+    {
+        for (int32_t x = 0; x < target.width; x++)
+        {
+            votes.fill(0);
+            for (int32_t dy = 0; dy < scale; dy++)
+            {
+                const auto* row = reinterpret_cast<const uint8_t*>(source.bits) + (y * scale + dy) * source.LineStride();
+                for (int32_t dx = 0; dx < scale; dx++)
+                    votes[row[x * scale + dx]]++;
+            }
+            int32_t best = 0;
+            for (int32_t i = 1; i < 256; i++)
+            {
+                if (votes[i] > votes[best] || (best == 0 && votes[i] > 0))
+                    best = i;
+            }
+            reinterpret_cast<uint8_t*>(target.bits)[y * target.LineStride() + x] = static_cast<uint8_t>(best);
+        }
+    }
