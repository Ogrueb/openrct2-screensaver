+    // Preview renders: each park is rendered once, framed on the area it is built on, by running this
+    // executable's "screenshot <file> <image> preview" command in the background. The pictures are kept
+    // in the cache folder under a name made from the file's path, size and modification time, so a park
+    // that changes is rendered again; a file that cannot be rendered leaves an empty ".none" file.
+    static constexpr int32_t kRenderWidth = kPreviewWidthScreenshot;
