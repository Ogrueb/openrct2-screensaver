+// The tiles the park is built on: tiles with at least two elements besides the surface (one when no
+// tile has two), weighted by that count squared, with 1% of the weight trimmed from each side so that
+// a few far-off pieces do not widen the frame.
+struct PreviewContent
+{
+    TileCoordsXY min;
+    TileCoordsXY max;
+    bool found{};
+};
+
+static PreviewContent GetPreviewContent()
+{
+    const auto& mapSize = getGameState().mapSize;
+    std::vector<uint32_t> counts(static_cast<size_t>(mapSize.x) * mapSize.y);
+    uint32_t maxCount = 0;
+    for (int32_t y = 0; y < mapSize.y; y++)
+    {
+        for (int32_t x = 0; x < mapSize.x; x++)
+        {
+            uint32_t n = 0;
+            for (const auto* element : TileElementsView(TileCoordsXY(x, y).toCoordsXY()))
+            {
+                if (element->getType() != TileElementType::surface && !element->isInvisible())
+                    n++;
+            }
+            counts[y * mapSize.x + x] = n;
+            maxCount = std::max(maxCount, n);
+        }
+    }
+
+    PreviewContent content;
+    if (maxCount == 0)
+        return content;
+
+    const uint32_t threshold = maxCount >= 2 ? 2 : 1;
+    std::vector<double> weightX(mapSize.x), weightY(mapSize.y);
+    double total = 0;
+    for (int32_t y = 0; y < mapSize.y; y++)
+    {
+        for (int32_t x = 0; x < mapSize.x; x++)
+        {
+            auto n = counts[y * mapSize.x + x];
+            if (n < threshold)
+                continue;
+            double w = static_cast<double>(n) * n;
+            weightX[x] += w;
+            weightY[y] += w;
+            total += w;
+        }
+    }
+
+    auto trimmed = [total](const std::vector<double>& weights, int32_t& low, int32_t& high) {
+        const double cut = total * 0.01;
+        double sum = 0;
+        low = 0;
+        while (low < static_cast<int32_t>(weights.size()) - 1 && sum + weights[low] <= cut)
+            sum += weights[low++];
+        sum = 0;
+        high = static_cast<int32_t>(weights.size()) - 1;
+        while (high > low && sum + weights[high] <= cut)
+            sum += weights[high--];
+    };
+    trimmed(weightX, content.min.x, content.max.x);
+    trimmed(weightY, content.min.y, content.max.y);
+    content.found = true;
+    return content;
+}
+
+// A viewport at the park's saved rotation showing the built area whole, at the closest zoom level
+// (up to the widest the game draws) that fits it in the given size; scale says how much smaller the
+// picture still has to be made afterwards to fit.
+static Viewport GetPreviewViewport(int32_t width, int32_t height, int32_t& scale)
+{
+    const auto& gameState = getGameState();
+    const auto rotation = gameState.savedViewRotation;
+    auto content = GetPreviewContent();
+    if (!content.found)
+    {
+        content.min = { 1, 1 };
+        content.max = { gameState.mapSize.x - 2, gameState.mapSize.y - 2 };
+    }
+
+    int32_t left = std::numeric_limits<int32_t>::max();
+    int32_t right = std::numeric_limits<int32_t>::min();
+    int32_t top = std::numeric_limits<int32_t>::max();
+    int32_t bottom = std::numeric_limits<int32_t>::min();
+    for (int32_t y = content.min.y; y <= content.max.y; y++)
+    {
+        for (int32_t x = content.min.x; x <= content.max.x; x++)
+        {
+            const auto location = TileCoordsXY(x, y).toCoordsXY();
+            const int32_t ground = TileElementHeight(location.toTileCentre());
+            const int32_t highest = std::max(ground, GetHighestBaseClearanceZ(location, false));
+            for (const auto& corner : { CoordsXY{ 0, 0 }, CoordsXY{ 31, 0 }, CoordsXY{ 0, 31 }, CoordsXY{ 31, 31 } })
+            {
+                auto low = Translate3DTo2DWithZ(rotation, CoordsXYZ(location + corner, ground));
+                auto high = Translate3DTo2DWithZ(rotation, CoordsXYZ(location + corner, highest));
+                left = std::min({ left, low.x, high.x });
+                right = std::max({ right, low.x, high.x });
+                top = std::min({ top, low.y, high.y });
+                bottom = std::max({ bottom, low.y, high.y });
+            }
+        }
+    }
+    // Room for sprites drawn above their clearance, and a margin
+    top -= 64;
+    const int32_t margin = std::max(right - left, bottom - top) / 40 + 8;
+    left -= margin;
+    right += margin;
+    top -= margin;
+    bottom += margin;
+
+    auto zoom = ZoomLevel{ 0 };
+    while (zoom < ZoomLevel::max()
+           && (zoom.ApplyInversedTo(right - left) > width || zoom.ApplyInversedTo(bottom - top) > height))
+    {
+        zoom = ZoomLevel{ static_cast<int8_t>(static_cast<int8_t>(zoom) + 1) };
+    }
+
+    // Past the widest zoom level the picture is rendered larger and reduced afterwards
+    scale = 1;
+    while (zoom.ApplyInversedTo(right - left) > width * scale || zoom.ApplyInversedTo(bottom - top) > height * scale)
+        scale++;
+
+    Viewport viewport{};
+    viewport.width = width * scale;
+    viewport.height = height * scale;
+    viewport.zoom = zoom;
+    viewport.rotation = rotation;
+    viewport.flags.set(ViewportFlag::transparentBackground);
+    const ScreenCoordsXY centre{ (left + right) / 2, (top + bottom) / 2 };
+    viewport.viewPos = { centre.x - viewport.ViewWidth() / 2, centre.y - viewport.ViewHeight() / 2 };
+    return viewport;
+}
+
+// Reduces a picture by a whole factor, keeping for each block of pixels the colour most of them have
+// (palette images cannot be blended); transparent pixels count only when nothing else is there.
+static void ReducePicture(const RenderTarget& source, RenderTarget& target, int32_t scale)
+{
+    std::array<uint16_t, 256> votes{};
+    for (int32_t y = 0; y < target.height; y++)
+    {
+        for (int32_t x = 0; x < target.width; x++)
+        {
+            votes.fill(0);
+            for (int32_t dy = 0; dy < scale; dy++)
+            {
+                const auto* row = reinterpret_cast<const uint8_t*>(source.bits) + (y * scale + dy) * source.LineStride();
+                for (int32_t dx = 0; dx < scale; dx++)
+                    votes[row[x * scale + dx]]++;
