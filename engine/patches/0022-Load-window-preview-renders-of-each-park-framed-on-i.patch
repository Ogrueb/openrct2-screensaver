+    // A preview render as palette pixels, if there is one that fits a preview image.
+    static std::optional<PreviewImage> ReadPreviewRender(const u8string& renderPath)
+    {
+        if (!File::Exists(renderPath))
+            return std::nullopt;
+        try
+        {
+            auto image = Imaging::ReadFromFile(renderPath, ImageFormat::png);
+            if (image.Depth != 8 || image.Width == 0 || image.Height == 0 || image.Width > kMaxPreviewImageSize
+                || image.Height > kMaxPreviewImageSize)
+                return std::nullopt;
+
+            PreviewImage preview{ .type = PreviewImageType::screenshot,
+                                  .width = static_cast<uint8_t>(image.Width),
+                                  .height = static_cast<uint8_t>(image.Height) };
+            for (uint32_t y = 0; y < image.Height; y++)
+            {
+                std::memcpy(
+                    &preview.pixels[y * image.Width], &image.Pixels[y * image.Stride], image.Width);
+            }
+            return preview;
+        }
+        catch (const std::exception& e)
+        {
+            LOG_ERROR("Could not read preview render %s: %s", renderPath.c_str(), e.what());
+            return std::nullopt;
+        }
+    }
