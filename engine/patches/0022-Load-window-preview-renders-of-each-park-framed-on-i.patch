+
+    static u8string PreviewRenderPath(const u8string& path, uint64_t size, time_t modified)
+    {
+        // FNV-1a over the render version, path, size and time; a new version redoes renders and failures
+        constexpr std::string_view kRenderVersion = "5|";
+        uint64_t hash = 0xcbf29ce484222325ull;
+        auto mix = [&hash](std::string_view text) {
+            for (auto c : text)
+            {
+                hash ^= static_cast<uint8_t>(c);
+                hash *= 0x100000001b3ull;
+            }
+        };
+        mix(kRenderVersion);
+        mix(path);
+        mix("|" + std::to_string(size) + "|" + std::to_string(static_cast<int64_t>(modified)));
+        char name[32];
+        std::snprintf(name, sizeof(name), "%016llx.png", static_cast<unsigned long long>(hash));
+        return Path::Combine(PreviewRenderFolder(), name);
+    }
+
+    // Runs a command and waits for it, its output discarded; true when it exits normally.
+    static bool RunHidden(const std::vector<u8string>& args)
+    {
+#ifdef _WIN32
+        // Quoted as the C runtime parses command lines
+        std::wstring commandLine;
+        for (const auto& arg : args)
+        {
+            if (!commandLine.empty())
+                commandLine += L' ';
+            auto wide = String::toWideChar(arg);
+            commandLine += L'"';
+            size_t backslashes = 0;
+            for (auto c : wide)
+            {
+                if (c == L'\\')
+                {
+                    backslashes++;
+                    continue;
+                }
+                commandLine.append(c == L'"' ? backslashes * 2 + 1 : backslashes, L'\\');
+                backslashes = 0;
+                commandLine += c;
+            }
+            commandLine.append(backslashes * 2, L'\\');
+            commandLine += L'"';
+        }
+
+        STARTUPINFOW startupInfo{};
+        startupInfo.cb = sizeof(startupInfo);
+        PROCESS_INFORMATION processInfo{};
+        if (!CreateProcessW(
+                nullptr, commandLine.data(), nullptr, nullptr, FALSE, CREATE_NO_WINDOW | IDLE_PRIORITY_CLASS, nullptr,
+                nullptr, &startupInfo, &processInfo))
+        {
+            return false;
+        }
+        WaitForSingleObject(processInfo.hProcess, INFINITE);
+        CloseHandle(processInfo.hThread);
+        CloseHandle(processInfo.hProcess);
+        return true;
+#else
+        std::vector<char*> argv;
+        for (const auto& arg : args)
+            argv.push_back(const_cast<char*>(arg.c_str()));
+        argv.push_back(nullptr);
+
+        pid_t pid = fork();
+        if (pid == 0)
+        {
+            int devNull = open("/dev/null", O_RDWR);
+            if (devNull >= 0)
+            {
+                dup2(devNull, STDIN_FILENO);
+                dup2(devNull, STDOUT_FILENO);
+                dup2(devNull, STDERR_FILENO);
+            }
+            if (nice(19) == -1)
+            {
+                // Normal priority then
+            }
+            execv(argv[0], argv.data());
+            _exit(127);
+        }
+        if (pid < 0)
+            return false;
+        int status = 0;
+        while (waitpid(pid, &status, 0) < 0)
+        {
+            if (errno != EINTR)
+                return false;
+        }
+        return WIFEXITED(status);
+#endif
+    }
+
+    // Renders a park's preview into the cache; true when the picture is there afterwards.
+    static bool RenderPreview(const u8string& parkPath, const u8string& renderPath)
+    {
+        Path::CreateDirectory(PreviewRenderFolder());
+        const auto partPath = renderPath + u8".part.png";
+        // Subcommands take no data path options, so the render uses the default user folder's settings
+        RunHidden({ Platform::GetCurrentExecutablePath(), "screenshot", parkPath, partPath, "preview",
+                    std::to_string(kRenderWidth), std::to_string(kRenderHeight) });
+        if (File::Exists(partPath) && File::Move(partPath, renderPath))
+            return true;
+
+        File::Delete(partPath);
+        File::WriteAllBytes(Path::WithExtension(renderPath, u8".none"), nullptr, 0);
+        return false;
+    }
+
+    static bool PreviewRenderFailed(const u8string& renderPath)
+    {
+        return File::Exists(Path::WithExtension(renderPath, u8".none"));
+    }
+
+    // A preview render as palette pixels, if there is one that fits a preview image.
+    static std::optional<PreviewImage> ReadPreviewRender(const u8string& renderPath)
+    {
+        if (!File::Exists(renderPath))
+            return std::nullopt;
+        try
+        {
+            auto image = Imaging::ReadFromFile(renderPath, ImageFormat::png);
+            if (image.Depth != 8 || image.Width == 0 || image.Height == 0 || image.Width > kMaxPreviewImageSize
+                || image.Height > kMaxPreviewImageSize)
+                return std::nullopt;
+
+            PreviewImage preview{ .type = PreviewImageType::screenshot,
+                                  .width = static_cast<uint8_t>(image.Width),
+                                  .height = static_cast<uint8_t>(image.Height) };
+            for (uint32_t y = 0; y < image.Height; y++)
+            {
+                std::memcpy(
+                    &preview.pixels[y * image.Width], &image.Pixels[y * image.Stride], image.Width);
+            }
+            return preview;
+        }
+        catch (const std::exception& e)
+        {
+            LOG_ERROR("Could not read preview render %s: %s", renderPath.c_str(), e.what());
+            return std::nullopt;
+        }
+    }
