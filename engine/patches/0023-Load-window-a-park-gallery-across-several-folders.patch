+        bool CanUseGallery() const
+        {
+            return action == LoadSaveAction::load && type == LoadSaveType::park;
+        }
+
+        // Lists the parks in every gallery folder and the folders under them
+        void PopulateGallery()
+        {
+            _listItems.clear();
+            Path::CreateDirectory(GalleryFolder());
+            std::vector<u8string> folders{ GalleryFolder() };
+            for (auto& folder : AddedGalleryFolders())
+                folders.push_back(std::move(folder));
+
+            std::unordered_set<u8string> seen;
+            for (const auto& folder : folders)
+            {
+                bool showExtension = false;
+                for (const u8string_view extToken : String::split(_extensionPattern, ";"))
+                {
+                    auto scanner = Path::scanDirectory(Path::Combine(folder, extToken), true);
+                    while (scanner->next())
+                    {
+                        auto path = scanner->getPath();
+                        if (seen.insert(path).second)
+                            _listItems.push_back(MakeFileItem(path, showExtension));
+                    }
+                    showExtension = true;
+                }
+            }
+
+            setWidgetDisabled(WIDX_PARENT_FOLDER, true);
+            setWidgetDisabled(WIDX_NEW_FOLDER, true);
+            SortList();
+            invalidate();
+        }
+
+        // Leaves the gallery's title and button state; the caller lists a folder
+        void LeaveGallery()
+        {
+            if (!_gallery)
+                return;
+            _gallery = false;
+            widgets[WIDX_TITLE].flags.unset(WidgetFlag::textIsString);
+            widgets[WIDX_TITLE].text = _titleText;
+        }
+
+        void ShowGallery()
+        {
+            if (!_gallery)
+            {
+                _gallery = true;
+                _titleText = widgets[WIDX_TITLE].text;
+                widgets[WIDX_TITLE].flags.set(WidgetFlag::textIsString);
+                // TODO: localised strings when offered upstream
+                widgets[WIDX_TITLE].string = "Park gallery";
+            }
+            PopulateGallery();
+            ListChanged();
+        }
+
+        void ListChanged()
+        {
+            initScrollWidgets();
+            numListItems = static_cast<uint16_t>(_listItems.size());
+            selectedListItem = -1;
+            invalidate();
+        }
+
+        void Refresh()
+        {
+            if (_gallery)
+                PopulateGallery();
+            else
+                PopulateList(_directory, _extensionPattern);
+            ListChanged();
+        }
