+    // The park gallery: the gallery folder in the user directory and the folders added to it, whose parks
+    // are listed in place
+    static u8string GalleryFolder()
+    {
+        auto& env = GetContext()->GetPlatformEnvironment();
+        return Path::Combine(env.GetDirectoryPath(DirBase::user), u8"gallery");
+    }
+
+    static std::vector<u8string> AddedGalleryFolders()
+    {
+        std::vector<u8string> folders;
+        for (auto folder : String::split(Config::Get().general.fileBrowserGalleryFolders, "|"))
+        {
+            if (!folder.empty())
+                folders.emplace_back(folder);
+        }
+        return folders;
+    }
+
+    static void SetAddedGalleryFolders(const std::vector<u8string>& folders)
+    {
+        u8string joined;
+        for (const auto& folder : folders)
+        {
+            if (!joined.empty())
+                joined += '|';
+            joined += folder;
+        }
+        Config::Get().general.fileBrowserGalleryFolders = joined;
+        Config::Save();
+    }
+
+    static u8string NormalisedFolder(const u8string& folder)
+    {
+        auto absolute = Path::GetAbsolute(folder);
+        while (absolute.size() > 1 && (absolute.back() == '/' || absolute.back() == '\\'))
+            absolute.pop_back();
+        return absolute;
+    }
+
+    static bool IsGalleryFolder(const u8string& folder)
+    {
+        const auto normalised = NormalisedFolder(folder);
+        if (Path::Equals(normalised, NormalisedFolder(GalleryFolder())))
+            return true;
+        for (const auto& added : AddedGalleryFolders())
+        {
+            if (Path::Equals(normalised, NormalisedFolder(added)))
+                return true;
+        }
+        return false;
+    }
