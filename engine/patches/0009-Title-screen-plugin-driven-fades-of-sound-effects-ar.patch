diff --git a/src/openrct2/audio/Audio.cpp b/src/openrct2/audio/Audio.cpp
index e9b5914..aaa17d4 100644
--- a/src/openrct2/audio/Audio.cpp
+++ b/src/openrct2/audio/Audio.cpp
@@ -35,6 +35,8 @@
 #include "AudioContext.h"
 #include "AudioMixer.h"
 
+#include <atomic>
+#include <chrono>
 #include <cmath>
 #include <memory>
 #include <vector>
@@ -333,6 +335,39 @@ namespace OpenRCT2::Audio
         StopSFX();
         StopTitleMusic();
         RideAudio::StopAllChannels();
+        FadeTitleEffects(1.0f, 0);
+    }
+
+    // Title screen effects fade, read by the mixer thread: a ramp from one level to another
+    static std::atomic<float> _effectsFadeFrom{ 1.0f };
+    static std::atomic<float> _effectsFadeTo{ 1.0f };
+    static std::atomic<int64_t> _effectsFadeStart{};
+    static std::atomic<int32_t> _effectsFadeMs{};
+
+    static int64_t EffectsFadeNow()
+    {
+        using namespace std::chrono;
+        return duration_cast<milliseconds>(steady_clock::now().time_since_epoch()).count();
+    }
+
+    float GetTitleEffectsGain()
+    {
+        const float from = _effectsFadeFrom;
+        const float to = _effectsFadeTo;
+        const int32_t ms = _effectsFadeMs;
+        const auto elapsed = EffectsFadeNow() - _effectsFadeStart;
+        if (ms <= 0 || elapsed >= ms)
+            return to;
+        return from + (to - from) * static_cast<float>(std::max<int64_t>(elapsed, 0)) / static_cast<float>(ms);
+    }
+
+    void FadeTitleEffects(float level, int32_t ms)
+    {
+        const float current = GetTitleEffectsGain();
+        _effectsFadeFrom = current;
+        _effectsFadeTo = std::clamp(level, 0.0f, 1.0f);
+        _effectsFadeStart = EffectsFadeNow();
+        _effectsFadeMs = std::max(ms, 0);
     }
 
     int32_t GetDeviceCount()
