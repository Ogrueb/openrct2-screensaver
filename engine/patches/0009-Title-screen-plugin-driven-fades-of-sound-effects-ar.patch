 src/openrct2-ui/scripting/ScTitleSequence.hpp | 16 +++++++++
 src/openrct2/audio/Audio.cpp                  | 35 +++++++++++++++++++
 src/openrct2/audio/Audio.h                    | 12 +++++++
 src/openrct2/ride/RideAudio.cpp               | 12 +++++--
 5 files changed, 73 insertions(+), 3 deletions(-)

