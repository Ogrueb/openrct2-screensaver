From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: RCT Screensaver <noreply@example.invalid>
Date: Tue, 27 Oct 2026 01:05:00 +0000
Subject: [PATCH] Title screen: register the next park's objects a few
 milliseconds per tick

Registering and loading the objects read in the background (handing their
images to the image table) was the largest remaining main-thread cost of a
switch, up to 120 ms. It now happens in 4 ms slices on each tick while the
park is still being imported on the loader thread; whatever is left is done
at the switch. Objects registered for a park that is then skipped are
unloaded again.
---
 src/openrct2-ui/title/TitleSequencePlayer.cpp | 24 ++++++++++++++++++-
 src/openrct2/object/ObjectManager.cpp         | 23 ++++++++++++++++++
 src/openrct2/object/ObjectManager.h           |  9 +++++++
 3 files changed, 55 insertions(+), 1 deletion(-)

diff --git a/src/openrct2-ui/title/TitleSequencePlayer.cpp b/src/openrct2-ui/title/TitleSequencePlayer.cpp
index cc8587a..f760880 100644
--- a/src/openrct2-ui/title/TitleSequencePlayer.cpp
+++ b/src/openrct2-ui/title/TitleSequencePlayer.cpp
@@ -68,7 +68,9 @@ namespace OpenRCT2::Title
             std::string hintPath;
             std::thread thread;
             std::atomic<bool> done{ false };
+            std::atomic<bool> objectsReady{ false }; // `objects` is complete; the import may still run
             bool ok = false;
+            std::vector<ObjectEntryDescriptor> registeredEarly; // registered on the main thread before done
             std::string error;
             std::unique_ptr<IParkImporter> importer;
             std::optional<ParkLoadResult> result;
@@ -178,7 +180,9 @@ namespace OpenRCT2::Title
                             }
                             if (!_background->done)
                             {
-                                // Keep playing the current park until the next one has been read.
+                                // Keep playing the current park until the next one has been read; meanwhile
+                                // register its objects a few milliseconds per tick.
+                                RegisterEarly(*_background);
                                 break;
                             }
                             auto load = std::move(_background);
@@ -506,6 +510,7 @@ namespace OpenRCT2::Title
                 load.result.emplace(load.importer->LoadFromStream(parkHandle->Stream.get(), false));
 
                 load.objects = GetContext()->GetObjectManager().PreloadObjects(load.result->RequiredObjects);
+                load.objectsReady = true;
 
                 // Import into a game state of its own; getGameState() and the map index on this
                 // thread point at it until the import is done.
@@ -575,10 +580,27 @@ namespace OpenRCT2::Title
             return success;
         }
 
+        static constexpr double kEarlyRegisterBudgetMs = 4.0;
+
+        /** Registers some of a pending load's objects on the main thread, within a small time budget. */
+        void RegisterEarly(BackgroundLoad& load)
+        {
+            if (!load.objectsReady || load.objects.empty())
+                return;
+            GetContext()->GetObjectManager().RegisterPreloadedObjects(
+                load.objects, kEarlyRegisterBudgetMs, load.registeredEarly);
+        }
+
         void DiscardBackgroundLoad()
         {
             if (_background != nullptr)
             {
+                if (!_background->registeredEarly.empty())
+                {
+                    // Objects registered for a park that will not be loaded now.
+                    GetContext()->GetObjectManager().UnloadObjects(_background->registeredEarly);
+                    _background->registeredEarly.clear();
+                }
                 _stale.push_back(std::move(_background));
             }
         }
diff --git a/src/openrct2/object/ObjectManager.cpp b/src/openrct2/object/ObjectManager.cpp
index fa82804..9b234c4 100644
--- a/src/openrct2/object/ObjectManager.cpp
+++ b/src/openrct2/object/ObjectManager.cpp
@@ -35,6 +35,7 @@
 #include <algorithm>
 #include <array>
 #include <atomic>
+#include <chrono>
 #include <memory>
 #include <mutex>
 #include <unordered_set>
@@ -257,6 +258,28 @@ namespace OpenRCT2
             return result;
         }
 
+        size_t RegisterPreloadedObjects(
+            std::vector<std::unique_ptr<Object>>& preloaded, double budgetMs,
+            std::vector<ObjectEntryDescriptor>& registered) override
+        {
+            auto start = std::chrono::steady_clock::now();
+            while (!preloaded.empty())
+            {
+                auto object = std::move(preloaded.back());
+                preloaded.pop_back();
+                const auto* ori = _objectRepository.FindObject(object->GetDescriptor());
+                if (ori == nullptr || ori->LoadedObject != nullptr)
+                    continue;
+                auto* loadedObject = object.get();
+                _objectRepository.RegisterLoadedObject(ori, std::move(object));
+                loadedObject->Load();
+                registered.push_back(loadedObject->GetDescriptor());
+                if (std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count() >= budgetMs)
+                    break;
+            }
+            return preloaded.size();
+        }
+
         void LoadObjects(
             const ObjectList& objectList, std::vector<std::unique_ptr<Object>>&& preloaded, bool reportProgress) override
         {
diff --git a/src/openrct2/object/ObjectManager.h b/src/openrct2/object/ObjectManager.h
index 4466f68..dedf3dd 100644
--- a/src/openrct2/object/ObjectManager.h
+++ b/src/openrct2/object/ObjectManager.h
@@ -64,6 +64,15 @@ namespace OpenRCT2
          */
         virtual void LoadObjects(
             const ObjectList& entries, std::vector<std::unique_ptr<Object>>&& preloaded, bool reportProgress = false) = 0;
+        /**
+         * Registers and loads objects from the back of `preloaded` until about
+         * `budgetMs` have been spent, so the work can be spread over several ticks before LoadObjects.
+         * Appends the descriptors of the objects it registered to `registered` (to unload them if the
+         * park they belong to is never loaded). Returns the number of objects still in `preloaded`.
+         */
+        virtual size_t RegisterPreloadedObjects(
+            std::vector<std::unique_ptr<Object>>& preloaded, double budgetMs, std::vector<ObjectEntryDescriptor>& registered)
+            = 0;
         virtual void UnloadObjects(const std::vector<ObjectEntryDescriptor>& entries) = 0;
         virtual void UnloadAllTransient() = 0;
         virtual void UnloadAll() = 0;
