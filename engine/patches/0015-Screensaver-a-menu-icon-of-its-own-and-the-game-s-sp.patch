+    // "sprite:<image index>": one of the game's own sprites (the stock menu's exit button), drawn in the
+    // standard palette, so it looks as in the stock interface whatever palette the park sets.
+    static bool ReadSprite(const std::string& src, Picture& picture)
+    {
+        const auto index = static_cast<ImageIndex>(std::strtoul(src.c_str() + 7, nullptr, 10));
+        const auto* g1 = GfxGetG1Element(index);
+        if (g1 == nullptr || g1->width <= 0 || g1->height <= 0)
+            return false;
+        // The picture's origin is where the sprite is drawn from, so its offsets place it as in a widget.
+        const int32_t width = std::max(1, g1->xOffset + g1->width);
+        const int32_t height = std::max(1, g1->yOffset + g1->height);
+        std::vector<Drawing::PaletteIndex> bits(static_cast<size_t>(width) * height, Drawing::PaletteIndex::transparent);
+        Drawing::RenderTarget rt{};
+        rt.bits = bits.data();
+        rt.width = width;
+        rt.height = height;
